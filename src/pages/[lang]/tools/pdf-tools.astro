---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Icon from '../../../components/Icon.astro';
import { langs,pick } from '../../../lib/catalog';
import '../../../styles/pdf.css';
export function getStaticPaths(){return langs.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props;
const instructions:[string,string][]=[
  [pick(lang,'Choose a task and PDF','काम र PDF छान्नुहोस्'),pick(lang,'Try the example or choose your own PDF. For merging, add two or more files and arrange their order.','नमुना चलाएर हेर्नुहोस् वा आफ्नो PDF छान्नुहोस्। जोड्नका लागि दुई वा बढी फाइल राखेर क्रम मिलाउनुहोस्।')],
  [pick(lang,'Set pages or quality','पाना वा गुणस्तर मिलाउनुहोस्'),pick(lang,'Pages start at 1. Extract a list or range; choose one page for an image. Compression offers text-preserving or image-based modes.','पाना १ बाट गनिन्छ। छुट्याउन पानाको सूची वा दायरा र फोटो बनाउन एउटा पाना छान्नुहोस्। साइज घटाउँदा अक्षर कायम राख्ने वा फोटो बनाउने विकल्प छ।')],
  [pick(lang,'Check and download','जाँचेर डाउनलोड गर्नुहोस्'),pick(lang,'Check the preview and output size, then download a new copy. Your original stays unchanged.','झलक र फाइलको साइज जाँचेर नयाँ प्रति डाउनलोड गर्नुहोस्। मूल फाइल जस्ताको तस्तै रहन्छ।')],
];
---
<ToolLayout lang={lang} id="pdf-tools" related="photo-resizer" instructions={instructions}>
  <div class="tool-workspace pdf-workspace">
    <form class="panel" id="pdf-form" novalidate>
      <div class="panel-heading"><h2>{pick(lang,'What do you need?','के गर्न चाहनुहुन्छ?')}</h2><button type="button" id="pdf-example">{pick(lang,'Use example','नमुना चलाउनुहोस्')}</button></div>
      <div class="pdf-tasks" role="group" aria-label={pick(lang,'PDF task','PDF मा गर्ने काम')}>
        <button type="button" data-pdf-task="extract" aria-pressed="true">{pick(lang,'Extract pages','पाना छुट्याउने')}</button>
        <button type="button" data-pdf-task="merge" aria-pressed="false">{pick(lang,'Merge PDFs','PDF जोड्ने')}</button>
        <button type="button" data-pdf-task="compress" aria-pressed="false">{pick(lang,'Compress PDF','साइज घटाउने')}</button>
        <button type="button" data-pdf-task="image" aria-pressed="false">{pick(lang,'Page to image','पानालाई फोटो')}</button>
      </div>
      <label class="upload-zone pdf-upload" id="pdf-drop" for="pdf-file"><Icon name="upload" size={24}/><strong id="pdf-upload-label">{pick(lang,'Choose a PDF or drop it here','PDF छान्नुहोस् वा यहाँ राख्नुहोस्')}</strong><p>{pick(lang,'20 MiB per file · Up to 10 PDFs','२० MiB प्रति फाइल · १० PDF सम्म')}</p><input id="pdf-file" type="file" accept="application/pdf,.pdf" aria-label={pick(lang,'Choose PDF files','PDF फाइल छान्नुहोस्')}/></label>
      <ol id="pdf-files" class="pdf-files" aria-label={pick(lang,'Selected PDFs, in output order','छानिएका PDF, जोडिने क्रमअनुसार')}></ol>
      <fieldset id="pdf-settings" disabled><legend class="sr-only">{pick(lang,'PDF output settings','PDF नतिजाको सेटिङ')}</legend>
        <div id="pdf-extract-settings" class="field"><label for="pdf-pages">{pick(lang,'Pages to keep','राख्ने पाना')}</label><input id="pdf-pages" type="text" value="1, 3" maxlength="2000" aria-describedby="pdf-pages-help"/><p class="field-help" id="pdf-pages-help">{pick(lang,'Example: 1, 3-5 · Numbered from 1','जस्तै: 1, 3-5 · पाना १ बाट गनिन्छ')}</p></div>
        <p id="pdf-merge-settings" class="field-help" hidden>{pick(lang,'All pages are joined in the file order above. Use ↑ and ↓ to rearrange.','माथिको फाइलको क्रमअनुसार सबै पाना जोडिन्छन्। क्रम मिलाउन ↑ र ↓ थिच्नुहोस्।')}</p>
        <div id="pdf-compress-settings" hidden><div class="field"><label for="pdf-compression">{pick(lang,'Compression mode','साइज घटाउने तरिका')}</label><select id="pdf-compression"><option value="balanced">{pick(lang,'Scanned pages · balanced','स्क्यान गरेका पाना · सन्तुलित')}</option><option value="smaller">{pick(lang,'Scanned pages · smaller file','स्क्यान गरेका पाना · सानो फाइल')}</option><option value="clearer">{pick(lang,'Scanned pages · clearer text','स्क्यान गरेका पाना · स्पष्ट अक्षर')}</option><option value="preserve">{pick(lang,'Keep text · try a smaller file','अक्षर कायम राखेर साइज घटाउने प्रयास')}</option></select></div><p class="field-help" id="pdf-compression-note"></p></div>
        <div id="pdf-image-settings" hidden><div class="field-row two"><div class="field"><label for="pdf-image-page">{pick(lang,'Page number','पाना नम्बर')}</label><input id="pdf-image-page" type="text" inputmode="numeric" value="1" maxlength="4"/></div><div class="field"><label for="pdf-image-format">{pick(lang,'Image format','फोटोको प्रकार')}</label><select id="pdf-image-format"><option value="image/jpeg">JPG</option><option value="image/png">PNG</option></select></div></div><div class="field pdf-resolution"><label for="pdf-dpi">{pick(lang,'Resolution','फोटोको स्पष्टता')}</label><select id="pdf-dpi"><option value="150">150 DPI</option><option value="200">200 DPI</option><option value="72">72 DPI</option></select></div></div>
      </fieldset>
      <div id="pdf-error" class="error-box" role="alert" tabindex="-1" hidden></div>
      <div class="panel-actions"><button class="button primary" id="pdf-process" type="submit" disabled>{pick(lang,'Extract pages','पाना छुट्याउनुहोस्')}<Icon name="arrow" size={18}/></button><button class="button secondary" id="pdf-cancel" type="button" hidden>{pick(lang,'Cancel','रद्द गर्नुहोस्')}</button><button class="button ghost" id="pdf-clear" type="button">{pick(lang,'Clear','हटाउनुहोस्')}</button></div>
      <p id="pdf-status" class="field-help" role="status" aria-live="polite">{pick(lang,'Preparing an example…','नमुना तयार हुँदैछ…')}</p>
      <p class="privacy-note"><Icon name="shield" size={14}/>{pick(lang,'On your device. No file uploads.','काम तपाईंको ब्राउजरमै हुन्छ। फाइल अपलोड हुँदैन।')}</p>
    </form>
    <section class="panel result-panel pdf-result-panel" aria-labelledby="pdf-result-heading">
      <div class="panel-heading"><h2 id="pdf-result-heading">{pick(lang,'Your result','तयार भएको फाइल')}</h2><span id="pdf-sample-label" class="sample-label">{pick(lang,'EXAMPLE','नमुना')}</span></div>
      <div id="pdf-result-empty" class="pdf-result-empty"><Icon name="file" size={30}/><p>{pick(lang,'Your result and actual file size will appear here.','तयार भएको फाइलको झलक र वास्तविक साइज यहाँ देखिन्छ।')}</p></div>
      <div id="pdf-result" hidden><div class="pdf-preview"><img id="pdf-preview" alt={pick(lang,'First output page preview','तयार भएको पहिलो पानाको झलक')}/></div><p id="pdf-preview-caption" class="field-help"></p><div class="file-stats"><strong id="pdf-output-size"></strong><span id="pdf-output-pages"></span></div><p id="pdf-summary" class="success-note" role="status"></p><a id="pdf-download" class="button primary full-width" download><Icon name="download" size={17}/><span>{pick(lang,'Download file','फाइल डाउनलोड गर्नुहोस्')}</span></a></div>
      <p class="field-help pdf-result-note">{pick(lang,'Check every output page before using it in an application.','आवेदनमा प्रयोग गर्नुअघि तयार भएका सबै पाना जाँच्नुहोस्।')}</p>
    </section>
  </div>
  <Fragment slot="method"><p>{pick(lang,'PDF-Lib extracts and joins pages; PDF.js renders previews and images. Everything runs locally. Extraction and merging retain page content but do not rebuild document bookmarks, attachments or interactive form logic. Interactive forms and digitally signed PDFs are not supported for these operations; use an unsigned, non-interactive copy. Password-protected PDFs are not supported.','PDF-Lib ले पाना छुट्याउने र जोड्ने काम गर्छ; PDF.js ले झलक र फोटो बनाउँछ। सबै काम यही ब्राउजरमा हुन्छ। पाना छुट्याउँदा वा जोड्दा मूल पानाको सामग्री रहन्छ, तर बुकमार्क, संलग्न फाइल वा फारामको अन्तरक्रियात्मक सुविधा सर्दैन। भर्न मिल्ने फाराम र डिजिटल हस्ताक्षर भएका PDF यी कामका लागि प्रयोग गर्न मिल्दैन; हस्ताक्षर नभएको साधारण प्रति प्रयोग गर्नुहोस्। पासवर्ड भएका PDF पनि चल्दैनन्।')}</p><p>{pick(lang,'Image-based compression redraws pages as JPEG images. It removes selectable text, links and form controls, and can reduce clarity. Text-preserving compression rewrites PDF objects and may not reduce file size. When a result would be larger, the original is offered instead. There is no guaranteed target size.','फोटो बनाएर साइज घटाउँदा प्रत्येक पाना JPEG फोटो बन्छ। त्यसपछि अक्षर छान्न वा खोज्न, लिङ्क खोल्न वा फाराम भर्न मिल्दैन र स्पष्टता घट्न सक्छ। अक्षर कायम राख्ने विकल्पले फाइलको बनावट मिलाउँछ; साइज घट्छ नै भन्ने हुँदैन। नयाँ फाइल ठूलो भए मूल फाइल नै डाउनलोड गर्न दिइन्छ। तोकिएकै साइजमा घट्छ भन्ने ग्यारेन्टी हुँदैन।')}</p><p>{pick(lang,'Limits: 20 MiB per file, 50 MiB in total, 10 files and 500 output pages. Image-based compression: up to 50 pages. Rendered pages: up to 12 MP and 4,096 px per side; large pages may use lower effective DPI. Downloads are new copies; clear or close this page to release your selected documents.','सीमा: हरेक फाइल २० MiB, जम्मा ५० MiB, १० फाइल र नतिजामा ५०० पानासम्म। फोटो बनाएर साइज घटाउन ५० पानासम्म मिल्छ। फोटो १२ MP र प्रत्येक छेउ ४,०९६ px सम्म हुन्छ; ठूला पानामा वास्तविक DPI कम हुन सक्छ। डाउनलोड गर्दा नयाँ प्रति बन्छ। छानेका कागजात हटाउन यो पृष्ठ खाली गर्नुहोस् वा बन्द गर्नुहोस्।')}</p><p><a href="https://pdf-lib.js.org/">PDF-Lib</a> · <a href="https://mozilla.github.io/pdf.js/">Mozilla PDF.js</a></p></Fragment>
  <script>import '../../../scripts/pdf-tool';</script>
</ToolLayout>
