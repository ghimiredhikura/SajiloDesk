{
  "name": "sajilo-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build && node scripts/verify-build.mjs && node scripts/test-entries.mjs",
    "test:entries": "node scripts/test-entries.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:defaults": "node scripts/test-defaults.mjs",
    "test:calendar": "node scripts/test-calendar.mjs",
    "test:korea": "node scripts/test-korea.mjs",
    "test:welcome": "node scripts/test-welcome.mjs",
    "test:moderation": "tsx scripts/test-moderation.ts",
    "community": "node scripts/community-admin.mjs",
    "test:korea-expanded": "tsx scripts/test-korea-expanded.ts",
    "test:korea-relevance": "tsx scripts/test-korea-relevance.ts",
    "test:pdf": "node scripts/test-pdf.mjs",
    "test:korea-mobile": "node scripts/test-korea-mobile.mjs",
    "test:selector-modes": "node scripts/test-selector-modes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource/mukta": "5.3.0",
    "@lacspace/preeti": "1.1.0",
    "@remotemerge/nepali-date-converter": "1.2.7",
    "astro": "7.4.5",
    "jose": "6.2.15",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@napi-rs/canvas": "1.1.0",
    "@types/node": "26.6.6",
    "jsdom": "30.1.3",
    "linkedom": "0.18.15",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.157.0"
  }
}
