---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { langs,pick,route } from '../../../lib/catalog';
export function getStaticPaths(){return langs.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props;
const guides=[['application-prep','spark','coral','Get ready for an online form','अनलाइन फारामको तयारी','Dates, cutoff age and a photo: connect the small tasks before you apply.','आवेदनअघि मिति, अन्तिम मितिको उमेर र फोटो तयार पार्नुहोस्।'],['photo-size','image','green','Pixels, KB and a photo that fits','पिक्सेल, KB र मिल्ने फोटो','Understand dimensions and file size, then choose a readable output.','पिक्सेल र फाइलको आकार बुझेर स्पष्ट नतिजा छान्नुहोस्।'],['nepali-dates','calendar','blue','Two calendars, without the confusion','दुई पात्रो, अलमल नगरी','When to use BS or AD, and why adding 57 years is not a conversion.','वि.सं. र ई.सं. कहिले प्रयोग गर्ने र किन ५७ वर्ष थपेर हुँदैन।']];
---
<Layout lang={lang} active="guides" title={pick(lang,'Practical guides','उपयोगी सहयोगी लेख')} description={pick(lang,'Simple guides to application preparation, photo size and Nepali date conversion.','आवेदनको तयारी, फोटोको आकार र नेपाली मितिका सरल सहयोगी लेख।')}><div class="container page-content"><div class="page-heading"><p class="eyebrow">{pick(lang,'A LITTLE GUIDANCE GOES A LONG WAY','सानो सहयोग, सजिलो काम')}</p><h1>{pick(lang,'Less figuring out. More done.','अलमल कम। काम पूरा।')}</h1><p>{pick(lang,'Short, practical guides to help you get a useful result.','उपयोगी नतिजा निकाल्न छोटा र व्यवहारिक लेख।')}</p></div><div class="guide-grid">{guides.map(([id,icon,color,en,ne,descEn,descNe])=><a class={`guide-card ${color}`} href={route(lang,`guides/${id}`)}><span class="tool-icon"><Icon name={icon}/></span><h2>{pick(lang,en,ne)}</h2><p>{pick(lang,descEn,descNe)}</p><span class="inline-link">{pick(lang,'Read the guide','लेख पढ्नुहोस्')}<Icon name="arrow" size={17}/></span></a>)}</div></div></Layout>
