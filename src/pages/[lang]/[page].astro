---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { langs,pick,route } from '../../lib/catalog';
import { withBase } from '../../lib/paths';
const titles = { about:['A useful little desk, for everyone.','सबैका लागि उपयोगी सानो डेस्क।'], privacy:['Your work stays with you.','तपाईंको काम, तपाईंसँगै।'], contact:['Help us make things easier.','अझ सजिलो बनाउन सघाउनुहोस्।'], methodology:['Clear methods. Traceable sources.','स्पष्ट विधि। खुला स्रोत।'] };
export function getStaticPaths(){return ['about','privacy','contact','methodology'].flatMap(page=>langs.map(lang=>({params:{lang,page},props:{lang,page}})));}
const {lang,page}=Astro.props;
const heading=titles[page as keyof typeof titles];
const title=pick(lang,heading[0],heading[1]);
const email=import.meta.env.PUBLIC_CONTACT_EMAIL || 'sajilodesk@gmail.com';
---
<Layout lang={lang} title={title} description={pick(lang,'Learn about Sajilo Desk, our sources, privacy and ways to send feedback.','सजिलो डेस्क, स्रोत, गोपनीयता र सुझाव दिने तरिका जान्नुहोस्।')}><div class="container"><article class="prose"><div class="page-heading"><p class="eyebrow">SAJILO DESK / सजिलो डेस्क</p><h1>{title}</h1></div>
{page==='about' && <><p>{pick(lang,'Sajilo means easy. That is the idea behind Sajilo Desk: a small collection of useful tools for the everyday work that shouldn’t take all day.','सजिलो डेस्कको सोच सरल छ: दिनभरि लाग्नु नपर्ने दैनिक कामका लागि उपयोगी उपकरण एकै ठाउँमा।')}</p><h2>{pick(lang,'Built around real tasks','वास्तविक कामका लागि')}</h2><p>{pick(lang,'A student checking their age on an application deadline. A parent converting a birth date. A print shop preparing a customer’s photo. A Nepali abroad working with two calendars. These are the jobs we are building for.','आवेदनको अन्तिम मितिमा उमेर जाँच्ने विद्यार्थी, जन्ममिति बदल्ने अभिभावक, ग्राहकको फोटो तयार गर्ने प्रिन्ट पसल र दुई पात्रो चलाउने विदेशमा रहेका नेपालीका लागि हामी बनाउँदैछौँ।')}</p><div class="prose-card"><h3 style="margin-top:0">{pick(lang,'A simple promise','सरल प्रतिबद्धता')}</h3><ul><li>{pick(lang,'Core tools are free and accessible without an account.','मुख्य उपकरण निःशुल्क छन् र खाता चाहिँदैन।')}</li><li>{pick(lang,'Photos, text and calculations are processed in your browser.','फोटो, अक्षर र गणना तपाईंको ब्राउजरमै प्रशोधन हुन्छन्।')}</li><li>{pick(lang,'English and Nepali pages share the same calculation methods.','नेपाली र अंग्रेजी पृष्ठले एउटै गणना विधि प्रयोग गर्छन्।')}</li><li>{pick(lang,'Sources and limitations are visible alongside each tool.','हरेक उपकरणसँग स्रोत र सीमा खुलाइएको छ।')}</li></ul></div><h2>{pick(lang,'Independent, and still improving','स्वतन्त्र, निरन्तर सुधार हुँदै')}</h2><p>{pick(lang,'This project is maintained by Deepak Ghimire. Sajilo Desk is an independent utility site, not a government service. We do not submit applications, verify documents or determine eligibility.','यो परियोजना दीपक घिमिरेले सञ्चालन गर्नुहुन्छ। सजिलो डेस्क स्वतन्त्र उपकरण वेबसाइट हो, सरकारी सेवा होइन। हामी आवेदन बुझाउने, कागजात प्रमाणित गर्ने वा योग्यता निर्धारण गर्ने काम गर्दैनौँ।')}</p><p>{pick(lang,'The first release focuses on five tools. New tools will follow observed needs, correctness checks and sustainable maintenance. Independent Nepali wording and legacy-text review are still part of our launch checks.','पहिलो संस्करणमा पाँच उपकरण छन्। वास्तविक आवश्यकता, शुद्धता र नियमित हेरचाहका आधारमा नयाँ उपकरण थपिनेछन्। स्वतन्त्र नेपाली भाषा र पुरानो अक्षरको समीक्षा प्रकाशनअघि गर्न बाँकी छ।')}</p><p><a href={route(lang,'contact')}>{pick(lang,'Tell us what would make your day easier.','तपाईंको काम सजिलो बनाउने सुझाव दिनुहोस्।')}</a></p></>}
{page==='privacy' && <><p>{pick(lang,'Last reviewed: 4 November 2026. This describes version 0.1.0 of Sajilo Desk.','पछिल्लो समीक्षा: ४ नोभेम्बर २०२६। यो विवरण सजिलो डेस्क संस्करण ०.१.० का लागि हो।')}</p><h2>{pick(lang,'What stays on your device','यन्त्रमै रहने विवरण')}</h2><p>{pick(lang,'Dates, pasted text, measurements, selected photos and generated outputs are processed in the active browser page. The tools do not upload these inputs or include them in URLs. Closing the page clears the working inputs; a downloaded output stays wherever you save it.','मिति, पेस्ट गरिएका अक्षर, नाप, छानिएका फोटो र नतिजा खुलेको ब्राउजर पृष्ठमा प्रशोधन हुन्छन्। उपकरणले यस्ता विवरण अपलोड गर्दैनन् वा URL मा राख्दैनन्। पृष्ठ बन्द गर्दा कामको विवरण हट्छ; डाउनलोड गरिएको नतिजा तपाईंले सुरक्षित गरेको ठाउँमा रहन्छ।')}</p><h2>{pick(lang,'What we remember','के सुरक्षित रहन्छ')}</h2><p>{pick(lang,'Local storage contains only your selected language and saved tool IDs. These preferences are limited to this browser and device; there is no account or cross-device sync. Your browser may also retain downloaded files and history according to its own settings.','स्थानीय भण्डारणमा छानिएको भाषा र सुरक्षित उपकरणका ID मात्र रहन्छन्। यी यही ब्राउजर र यन्त्रमा सीमित छन्। खाता वा यन्त्रबीच समन्वय छैन। ब्राउजरको सेटिङअनुसार डाउनलोड र इतिहास रहन सक्छ।')}</p><button type="button" class="button secondary" data-clear-preferences>{pick(lang,'Clear saved preferences','सुरक्षित प्राथमिकता हटाउनुहोस्')}</button><h2>{pick(lang,'Connections and analytics','कनेक्सन र तथ्याङ्क')}</h2><p>{pick(lang,'This build includes no advertising trackers or analytics scripts. Fonts and tool code are served with the site. The hosting provider may process ordinary connection information such as IP addresses and request logs to serve and protect the website. If analytics are added, this policy will be updated before they are enabled.','यस संस्करणमा विज्ञापन ट्र्याकर वा एनालिटिक्स स्क्रिप्ट छैनन्। फन्ट र उपकरणको कोड वेबसाइटबाटै आउँछन्। वेबसाइट उपलब्ध र सुरक्षित राख्न होस्टिङ प्रदायकले IP ठेगाना र अनुरोधका लगजस्ता साधारण कनेक्सन विवरण प्रशोधन गर्न सक्छ। एनालिटिक्स थप्नुअघि यो नीति अद्यावधिक गरिनेछ।')}</p><h2>{pick(lang,'Feedback and external links','सुझाव र बाह्य लिङ्क')}</h2><p>{pick(lang,'A feedback draft is prepared on your device. Nothing is sent by the form itself. If you choose to email it, your email provider and our inbox receive what you send. Do not include citizenship numbers, birth dates, private documents or other sensitive data. External websites have their own privacy policies.','सुझावको मस्यौदा यही यन्त्रमा तयार हुन्छ। फाराम आफैँले पठाउँदैन। तपाईंले इमेल पठाएपछि इमेल प्रदायक र हाम्रो इनबक्सले पठाएको विवरण पाउँछन्। नागरिकता नम्बर, जन्ममिति, निजी कागजात वा संवेदनशील विवरण नराख्नुहोस्। बाह्य वेबसाइटको आफ्नै गोपनीयता नीति हुन्छ।')}</p><p>{pick(lang,'Questions about privacy:','गोपनीयताबारे:')} <a href={`mailto:${email}`}>{email}</a></p></>}
{page==='contact' && <><p>{pick(lang,'A wrong result, a confusing label, or a tool you wish existed? We would like to hear about it. Please use a made-up example when reporting a calculation or text-conversion issue.','गलत नतिजा, नबुझिने शब्द वा चाहिएको उपकरण? हामीलाई जानकारी दिनुहोस्। गणना वा अक्षरको समस्या लेख्दा काल्पनिक उदाहरण प्रयोग गर्नुहोस्।')}</p><div class="contact-detail"><strong>{pick(lang,'Write to us','हामीलाई लेख्नुहोस्')}</strong><br/><a href={`mailto:${email}`}>{email}</a></div><div class="prose-card"><h2 style="margin-top:0">{pick(lang,'Prepare a feedback draft','सुझावको मस्यौदा बनाउनुहोस्')}</h2><form class="feedback-form" id="feedback-form"><div class="field"><label for="feedback-topic">{pick(lang,'What is this about?','कुन विषयमा हो?')}</label><select id="feedback-topic"><option>{pick(lang,'A tool or result','उपकरण वा नतिजा')}</option><option>{pick(lang,'Nepali wording','नेपाली भाषा')}</option><option>{pick(lang,'A feature idea','नयाँ सुविधाको विचार')}</option><option>{pick(lang,'Something else','अन्य विषय')}</option></select></div><div class="field"><label for="feedback-message">{pick(lang,'Your feedback','तपाईंको सुझाव')}</label><textarea id="feedback-message" maxlength="3000" required placeholder={pick(lang,'What did you try? What did you expect? What happened?','के प्रयास गर्नुभयो? के अपेक्षा थियो? के भयो?')}></textarea></div><button type="submit" class="button primary"><Icon name="download" size={16}/>{pick(lang,'Download feedback draft','सुझावको मस्यौदा डाउनलोड गर्नुहोस्')}</button><p class="field-help" role="status" id="feedback-status">{pick(lang,'This saves a text file to your device. It does not submit or send anything.','यसले यन्त्रमा अक्षर फाइल सुरक्षित गर्छ। केही पनि बुझाउँदैन वा पठाउँदैन।')}</p></form></div><h2>{pick(lang,'For print and cyber shops','प्रिन्ट र साइबर पसलका लागि')}</h2><p>{pick(lang,'We are preparing a small usability pilot in Butwal and Tilottama. If you would like to help test the tools with fictitious examples, email us. Participation and findings are not yet confirmed.','हामी बुटवल र तिलोत्तमामा सानो प्रयोग परीक्षणको तयारी गर्दैछौँ। काल्पनिक उदाहरणले उपकरण जाँच्न इच्छुक भए इमेल गर्नुहोस्। सहभागी र परीक्षणको नतिजा अहिलेसम्म निश्चित भएका छैनन्।')}</p></>}
{page==='methodology' && <><p>{pick(lang,'A useful result should be understandable and reproducible. Each tool includes its own explanation, supported range and limits. Reviewed 4 November 2026.','उपयोगी नतिजा बुझ्न र दोहोर्‍याएर निकाल्न मिल्नुपर्छ। हरेक उपकरणमा विधि, सीमा र स्रोत छन्। समीक्षा: ४ नोभेम्बर २०२६।')}</p><h2>{pick(lang,'Calendars and age','पात्रो र उमेर')}</h2><p>{pick(lang,'Date conversion uses a versioned month-length table from @remotemerge/nepali-date-converter 1.2.7, under MIT. Date-only arithmetic avoids time-zone shifts, and Today uses Asia/Kathmandu. Independent official date fixtures and exhaustive round-trip tests are included in the project. A round trip tests internal consistency; it does not independently establish every historical date.','मिति परिवर्तनमा MIT अन्तर्गत @remotemerge/nepali-date-converter 1.2.7 को महिनाका दिनहरूको तालिका प्रयोग हुन्छ। दिनमा आधारित गणनाले समय क्षेत्रको फरक हटाउँछ। आजको मिति नेपाल समयअनुसार हुन्छ। परियोजनामा आधिकारिक मितिका नमुना र सबै दिनको दोहोरो परिवर्तन परीक्षण छन्। दोहोरो परीक्षणले आन्तरिक मिलान जाँच्छ, हरेक ऐतिहासिक मिति स्वतन्त्र रूपमा प्रमाणित गर्दैन।')}</p><ul><li><a href="https://github.com/remotemerge/nepali-date-converter">{pick(lang,'Calendar library and MIT license','पात्रोको लाइब्रेरी र MIT इजाजतपत्र')}</a></li><li><a href="https://ae.nepalembassy.gov.np/pages/holidays-16/">{pick(lang,'Nepal Embassy holiday dates (official reference)','नेपाली दूतावासको बिदा मिति (आधिकारिक सन्दर्भ)')}</a></li></ul><p>{pick(lang,'Age is Gregorian completed years, months and days after BS conversion. Missing anniversaries in shorter months use that month’s final day. The tool does not assess application eligibility.','वि.सं. परिवर्तनपछि अंग्रेजी पात्रोअनुसार पूरा भएका वर्ष, महिना र दिन उमेर हुन्। छोटो महिनामा जन्मदिन नपरे अन्तिम दिन प्रयोग हुन्छ। उपकरणले आवेदनको योग्यता निर्धारण गर्दैन।')}</p><h2>{pick(lang,'Today’s holidays and worldwide days','आजको बिदा र विश्व दिवस')}</h2><p>{pick(lang,'The key day and separate holiday status use Nepal time. Nepal holidays are mapped for BS 2083 (14 April 2026–13 April 2027), with Saturday and Sunday as weekly holidays. Regional and community holidays are labelled with their scope. After the mapped year, the card asks for a calendar update instead of repeating lunar dates.','विश्व दिवस र बिदाको छुट्टाछुट्टै जानकारी नेपाल समयअनुसार देखिन्छ। वि.सं. २०८३ (१४ अप्रिल २०२६–१३ अप्रिल २०२७) का बिदा राखिएका छन्। शनिबार र आइतबार साप्ताहिक बिदा हुन्। क्षेत्र वा समुदाय विशेषको बिदामा सो विवरण देखिन्छ। वर्ष सकिएपछि चन्द्रपात्रोका मिति दोहोर्‍याउनुको सट्टा अद्यावधिकको सूचना देखिन्छ।')}</p><p>{pick(lang,'Worldwide highlights are selected fixed-date UN and UN-agency observances, not public holidays. The published list may be supplemented by later government or local notices. Holidays whose dates have not been announced are not guessed. Reviewed 5 November 2026.','विश्व दिवसमा संयुक्त राष्ट्र र यसका निकायका छानिएका निश्चित मितिका दिवस समावेश छन्; यी सार्वजनिक बिदा होइनन्। सरकारी वा स्थानीय पछिल्ला सूचनाले बिदा थप्न सक्छन्। घोषणा नभएका मितिको अनुमान गरिएको छैन। समीक्षा: ५ नोभेम्बर २०२६।')}</p><ul><li><a href="https://moha.gov.np/page/government-and-public-holidays-in-2083">{pick(lang,'Ministry of Home Affairs: 2083 holidays','गृह मन्त्रालय: २०८३ का बिदा')}</a></li><li><a href="https://daorasuwa.moha.gov.np/post/sa-lka-sa-ra-vajana-ka-b-tha-2">{pick(lang,'Official Saturday and Sunday holiday notice','शनिबार र आइतबार बिदाको आधिकारिक सूचना')}</a></li><li><a href="https://www.un.org/en/observances/list-days-weeks">{pick(lang,'United Nations: international days','संयुक्त राष्ट्र: अन्तर्राष्ट्रिय दिवस')}</a></li></ul><h2>{pick(lang,'Nepal key days and the calendar','नेपालका विशेष दिवस र पात्रो')}</h2><p>{pick(lang,'Nepal key days are a sourced selection across the full Nepali year, including literary birth anniversaries and national observances. The reviewed edition begins in BS 2083. Fixed dates follow their own BS or AD calendar; lunar dates are recorded for a specific year. Key days and public holidays are separate.','नेपालका विशेष दिवसमा वर्षभरिका साहित्यिक जन्मजयन्ती र राष्ट्रिय दिवस छानिएका छन्। समीक्षित विवरण वि.सं. २०८३ देखि सुरु हुन्छ। निश्चित मिति सम्बन्धित वि.सं. वा ई.सं. पात्रोअनुसार दोहोरिन्छ; चन्द्रपात्रोका मिति निश्चित वर्षका लागि राखिन्छन्। विशेष दिवस र सार्वजनिक बिदा फरक हुन्।')}</p><p>{pick(lang,'The calendar section uses the same conversion library and range as the date tool. Large day numbers follow the selected calendar and smaller numbers show the other calendar. The selected-day panel displays both full dates, sources and any listed observances. Inputs remain in this page.','पात्रोमा मिति परिवर्तन उपकरणकै लाइब्रेरी र सीमा प्रयोग हुन्छ। ठूला अंक छानिएको पात्रोका र साना अंक अर्को पात्रोका मिति हुन्। छानेको दिनको विवरणमा दुवै पूरा मिति, स्रोत र सूचीकृत दिवस देखिन्छन्। विवरण यही पृष्ठमा रहन्छन्।')}</p><h2>{pick(lang,'Legacy text','पुराना अक्षर')}</h2><p>{pick(lang,'Preeti mapping is provided by @lacspace/preeti 1.1.0, under the Lacspace Free Licence v1.0. Explicit [[English]] markers preserve English without guessing. Automated examples cover common reordering and mixed text; independent Nepali typist review remains pending.','प्रीति परिवर्तनमा Lacspace Free Licence v1.0 अन्तर्गत @lacspace/preeti 1.1.0 प्रयोग हुन्छ। [[English]] चिन्हले अंग्रेजीलाई अनुमानबिना जोगाउँछ। स्वचालित नमुनामा मात्रा, रेफ र मिश्रित अक्षर छन्; स्वतन्त्र नेपाली टाइपिस्टको समीक्षा बाँकी छ।')}</p><p><a href="https://developer.lacspace.com/packages/preeti">{pick(lang,'Preeti mapping documentation','प्रीति परिवर्तनको विवरण')}</a></p><h2>{pick(lang,'Land units','जग्गाको एकाइ')}</h2><p>{pick(lang,'We use the Nepal convention: 5,476 ft² per ropani and 72,900 ft² per bigha, with the standard compound-unit ratios. Metric area is derived from the exact international foot (0.3048 m). Results show up to four decimals, retaining full precision in calculations.','नेपालको प्रचलनअनुसार एक रोपनीमा ५,४७६ र एक बिघामा ७२,९०० वर्ग फिट प्रयोग हुन्छ। अन्तर्राष्ट्रिय फिट ०.३०४८ मिटरबाट वर्ग मिटर निकालिन्छ। नतिजामा चार दशमलवसम्म र गणनामा पूरा शुद्धता राखिन्छ।')}</p><p><a href="https://giwmscdnone.gov.np/media/app/public/54/posts/1711001516_6.pdf">{pick(lang,'Government unit reference (PDF)','सरकारी एकाइ सन्दर्भ (PDF)')}</a> · <a href="https://www.nist.gov/pml/us-surveyfoot">{pick(lang,'NIST: international foot','NIST: अन्तर्राष्ट्रिय फिट')}</a></p><h2>{pick(lang,'Photos','फोटो')}</h2><p>{pick(lang,'Photos are decoded and resized by your browser. Displayed size comes from the generated file’s actual bytes. Compression and color can vary between browsers. Presets are generic targets; official application requirements must be checked with the issuing authority.','ब्राउजरले फोटो खोलेर आकार बदल्छ। देखाइएको आकार बनेको फाइलका वास्तविक बाइटबाट आउँछ। ब्राउजरअनुसार कम्प्रेसन र रङ फरक हुन सक्छन्। सेटिङ सामान्य हुन्; आधिकारिक आवेदनको नियम सम्बन्धित निकायसँग जाँच्नुपर्छ।')}</p><h2>{pick(lang,'Licenses and corrections','इजाजतपत्र र सुधार')}</h2><p>{pick(lang,'Local fonts: DM Sans and Noto Sans Devanagari (SIL Open Font License). Third-party license notices are available below. Send corrections with a fictitious, reproducible example.','स्थानीय फन्ट: DM Sans र Noto Sans Devanagari (SIL Open Font License)। प्रयोग भएका सामग्रीका इजाजतपत्र तल छन्। काल्पनिक र दोहोर्‍याउन मिल्ने उदाहरणसहित सुधार पठाउनुहोस्।')}</p><p><a href={withBase('licenses/THIRD-PARTY-NOTICES.txt')}>{pick(lang,'Third-party notices','अन्य स्रोतका इजाजतपत्र')}</a> · <a href={route(lang,'contact')}>{pick(lang,'Send feedback','सुझाव दिनुहोस्')}</a></p></>}
</article></div><script>import { downloadBlob } from '../../scripts/shared';const form=document.querySelector<HTMLFormElement>('#feedback-form');form?.addEventListener('submit',e=>{e.preventDefault();const topic=(document.querySelector('#feedback-topic') as HTMLSelectElement).value;const message=(document.querySelector('#feedback-message') as HTMLTextAreaElement).value.trim();if(!message)return;downloadBlob(new Blob([`Sajilo Desk feedback\nTopic: ${topic}\n\n${message}\n\nDraft only. Email to sajilodesk@gmail.com when ready.\n`],{type:'text/plain;charset=utf-8'}),'sajilo-feedback-draft.txt');const status=document.querySelector('#feedback-status');if(status)status.textContent=document.documentElement.lang==='ne'?'मस्यौदा तयार भयो। जाँचेर इमेल गर्नुहोस्।':'Draft prepared. Review it, then email it when ready.';});</script></Layout>
