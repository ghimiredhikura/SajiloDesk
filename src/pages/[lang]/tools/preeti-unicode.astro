---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Icon from '../../../components/Icon.astro';
import { langs, pick } from '../../../lib/catalog';
import { withBase } from '../../../lib/paths';
export function getStaticPaths(){return langs.map(lang => ({params:{lang},props:{lang}}));}
const { lang } = Astro.props;
const instructions: [string,string][] = [[pick(lang,'Paste legacy Preeti text','प्रीतिमा लेखिएको पाठ राख्नुहोस्'),pick(lang,'Text copied from a Preeti document often looks like g]kfn.','प्रीति फन्टको कागजातबाट कपी गर्दा नेपाली पाठ g]kfn जस्तो देखिन सक्छ।')],[pick(lang,'Convert and review','बदलेर जाँच्नुहोस्'),pick(lang,'Check names, vowel marks and punctuation in the preview.','नाम, मात्रा र विराम चिह्न ठीक छन् कि नतिजामा हेर्नुहोस्।')],[pick(lang,'Copy or download','कपी वा डाउनलोड गर्नुहोस्'),pick(lang,'Use the Unicode result in messages, documents or websites.','बदलिएको पाठ सन्देश, कागजात वा वेबसाइटमा प्रयोग गर्नुहोस्।')]];
---
<ToolLayout lang={lang} id="preeti-unicode" related="date-converter" instructions={instructions}>
  <form id="preeti-form" novalidate><div class="tool-workspace text-workspace"><div class="panel"><div class="panel-heading"><h2>{pick(lang,'Your Preeti text','प्रीतिमा लेखिएको पाठ')}</h2><span class="panel-kicker">{pick(lang,'EXAMPLE · EDIT OR REPLACE','नमुना पाठ · आफ्नो पाठ राख्न मिल्छ')}</span></div><label class="sr-only" for="preeti-input">{pick(lang,'Preeti source text','प्रीतिमा भएको मूल पाठ')}</label><textarea id="preeti-input" maxlength="50000" spellcheck="false" autocomplete="off" placeholder="g]kfn" aria-describedby="preeti-hint"></textarea><div class="text-counter"><span id="preeti-count">0 / 50,000</span><button id="preeti-example" type="button">{pick(lang,'Try an example','उदाहरण हेर्नुहोस्')}</button></div><p class="field-help" id="preeti-hint">{pick(lang,'Already have English in your text? Wrap it in [[double brackets]] to keep it unchanged.','अंग्रेजी शब्द नबदलिऊन् भन्नका लागि [[यस्ता दुई कोष्ठक]] भित्र राख्नुहोस्। जस्तै: [[Hello Nepal]]')}</p><div class="panel-actions"><button type="submit" class="button primary">{pick(lang,'Convert to Unicode','युनिकोडमा बदल्नुहोस्')}<Icon name="arrow" size={18}/></button><button class="button secondary" type="button" id="preeti-reset">{pick(lang,'Reset','खाली गर्नुहोस्')}</button></div><div id="form-error" class="error-box" role="alert" tabindex="-1" hidden></div><p class="privacy-note"><Icon name="shield" size={14}/>{pick(lang,'Your text is processed here and is never uploaded.','पाठ ब्राउजरमै बदलिन्छ, कतै पठाइँदैन।')}</p></div><div class="panel result-panel"><div class="panel-heading"><h2>{pick(lang,'Unicode text','युनिकोडमा बदलिएको पाठ')}</h2><span class="panel-kicker">{pick(lang,'READY TO USE','प्रयोग गर्न तयार')}</span></div><label class="sr-only" for="preeti-output">{pick(lang,'Converted Unicode text','युनिकोडमा बदलिएको पाठ')}</label><textarea class="output-text" id="preeti-output" readonly placeholder="नेपाल" aria-describedby="text-result-status"></textarea><p class="field-help" id="text-result-status" role="status">{pick(lang,'Your converted text will appear here.','युनिकोडमा बदलेको पाठ यहाँ देखिन्छ।')}</p><div class="panel-actions"><button class="button secondary" type="button" id="copy-preeti" disabled><Icon name="copy" size={17}/>{pick(lang,'Copy text','कपी गर्नुहोस्')}</button><button class="button secondary" type="button" id="download-preeti" disabled><Icon name="download" size={17}/>.txt</button></div><p class="info-note">{pick(lang,'Preeti font variants can differ. Review the output before using it in an official document.','प्रीति फन्टका संस्करणअनुसार केही अक्षर फरक पर्न सक्छन्। आधिकारिक कागजातमा प्रयोग गर्नुअघि पाठ एक पटक पढेर जाँच्नुहोस्।')}</p></div></div></form>
  <Fragment slot="method"><p>{pick(lang,'Converts legacy Preeti-encoded text, not Romanized Nepali typing. Uses @lacspace/preeti v1.1.0 under the commercially permissive Lacspace Free Licence v1.0. Character mapping includes short-i repositioning, conjuncts and repha.','यसले प्रीति फन्टमा लेखिएको पाठलाई युनिकोडमा बदल्छ। रोमनमा लेखिएको नेपालीलाई भने बदल्दैन। मात्रा, संयुक्त अक्षर र रेफ मिलाउन @lacspace/preeti v1.1.0 प्रयोग हुन्छ। यसको Lacspace Free Licence v1.0 ले व्यावसायिक प्रयोगसमेत गर्न दिन्छ।')}</p><p>{pick(lang,'Only text inside [[double brackets]] is explicitly preserved as English. Plain text does not contain font information, so English outside those markers is converted as Preeti. Limit: 50,000 characters per conversion. Automated sample tests are included; independent Nepali typist review is pending.','[[Hello Nepal]] जस्ता दुई कोष्ठकभित्र राखेको पाठ जस्ताको तस्तै रहन्छ। पेस्ट गरिएको पाठसँग फन्टको जानकारी आउँदैन, त्यसैले कोष्ठकबाहिरका अंग्रेजी अक्षर पनि प्रीतिको पाठ मानेर बदलिन्छन्। एक पटकमा ५०,००० अक्षरसम्म राख्न मिल्छ। नमुना पाठको स्वचालित परीक्षण गरिएको छ; अनुभवी नेपाली टाइपिस्टबाट छुट्टै जाँच गराउन बाँकी छ।')}</p><a href="https://developer.lacspace.com/packages/preeti" target="_blank" rel="noopener noreferrer">{pick(lang,'Mapping documentation','अक्षर परिवर्तनको विवरण')} ↗</a> · <a href={withBase('licenses/lacspace-preeti.txt')}>{pick(lang,'License','इजाजतपत्र')}</a></Fragment>
  <script>import '../../../scripts/preeti-tool';</script>
</ToolLayout>
