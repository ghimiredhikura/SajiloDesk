---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Mountains from '../../components/Mountains.astro';
import ToolSearch from '../../components/ToolSearch.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import CalendarSection from '../../components/CalendarSection.astro';
import { langs, pick, route } from '../../lib/catalog';
export function getStaticPaths() { return langs.map(lang => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props;
---
<Layout lang={lang} active="home" title={pick(lang, 'Free everyday tools for Nepal', 'दैनिक काम सजिलो बनाउने निःशुल्क उपकरण')} description={pick(lang, 'Convert BS and AD dates, calculate age, convert Preeti text, resize photos and convert Nepal land units. Free, bilingual tools that work in your browser.', 'नेपाली र अंग्रेजी मिति बदल्नुहोस्, उमेर निकाल्नुहोस्, प्रीतिको पाठ युनिकोडमा बदल्नुहोस्, फोटोको साइज मिलाउनुहोस् र जग्गाको नाप निकाल्नुहोस्। सबै निःशुल्क।')}>
  <div class="container">
    <section class="home-hero"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span>{pick(lang, 'YOUR EVERYDAY DIGITAL DESK', 'दैनिक काममा तपाईंको साथी')}</p><h1>{pick(lang, 'Everyday tasks,', 'तपाईंको दैनिकी,')} <span>{pick(lang, 'made sajilo.', 'अब अझ सजिलो।')}</span></h1><p class="hero-description">{pick(lang, 'Free tools for life in Nepal, and wherever life takes you.', 'नेपालमा होस् वा विदेशमा, दैनिक काम सजिलो बनाउने निःशुल्क उपकरण।')}</p><ToolSearch lang={lang}/></div>
      <aside class="today-card"><div class="today-top"><span><span class="status-dot"></span>{pick(lang, 'TODAY AT A GLANCE', 'आज एकै नजरमा')}</span><span class="today-icon"><Icon name="calendar" size={18}/></span></div><div id="nepal-today"><p class="today-date">{pick(lang, 'Namaste, Nepal.', 'नमस्ते, नेपाल।')}</p><p class="today-ad">{pick(lang, 'Your Nepali date, right here.', 'आजको नेपाली र अंग्रेजी मिति।')}</p></div><div class="today-time"><Icon name="clock" size={13}/><span id="nepal-time">Asia/Kathmandu · UTC +5:45</span></div><div class="today-highlights"><div id="today-nepal-key-day" class="today-key-day today-nepal-key-day" hidden><p class="today-key-day-label">{pick(lang,'Nepal','नेपाल')}</p><p class="today-key-day-name"><a id="today-nepal-day" href="https://moha.gov.np/page/government-and-public-holidays-in-2083" target="_blank" rel="noopener noreferrer"></a></p></div><div id="today-key-day" class="today-key-day" hidden><p class="today-key-day-label">{pick(lang,'World','विश्व')}</p><p class="today-key-day-name"><a id="today-world" href="https://www.un.org/en/observances/list-days-weeks" target="_blank" rel="noopener noreferrer"></a></p></div><p class="today-holiday-line" data-status="none" hidden><a id="today-holiday" href="https://moha.gov.np/page/government-and-public-holidays-in-2083" target="_blank" rel="noopener noreferrer">{pick(lang,'Nepal holiday calendar','नेपालको बिदा पात्रो')}</a></p></div><Mountains/><div class="today-footer"><details class="today-observances"><summary id="today-sources">{pick(lang,'Sources & details','स्रोत र विवरण')}</summary><div class="today-event-details"><ul id="today-nepal-day-sources" hidden></ul><p id="today-holiday-details"></p><p><a href="https://moha.gov.np/page/government-and-public-holidays-in-2083" target="_blank" rel="noopener noreferrer">{pick(lang,'Official holiday calendar','आधिकारिक बिदा पात्रो')}</a> · <a href="https://www.un.org/en/observances/list-days-weeks" target="_blank" rel="noopener noreferrer">{pick(lang,'Worldwide observances','अन्तर्राष्ट्रिय दिवसहरू')}</a></p><p>{pick(lang,'2083 BS calendar · reviewed 5 Nov 2026. Local or later notices may differ.','वि.सं. २०८३ को पात्रो · ५ नोभेम्बर २०२६ मा जाँचिएको। स्थानीय वा पछि जारी हुने सूचनाअनुसार बिदा फरक पर्न सक्छ।')}</p></div></details><a class="today-link" href="#calendar">{pick(lang, 'View calendar', 'पात्रो हेर्नुहोस्')}<Icon name="arrow" size={16}/></a></div></aside>
    </section>
    <section class="home-tools"><div class="section-heading"><div><p class="eyebrow muted">{pick(lang, 'SMALL TOOLS. BIG HELP.', 'साना काम पनि सजिलै।')}</p><h2>{pick(lang, 'What’s on your desk today?', 'आज के गर्न चाहनुहुन्छ?')}</h2></div><span class="tools-count">{pick(lang, '5 free tools, ready to go', '५ उपयोगी उपकरण, सबै निःशुल्क')}</span></div><ToolGrid lang={lang} journey/></section>
    <CalendarSection lang={lang}/>
    <section class="workflow-banner"><div class="workflow-copy"><span class="pill light"><Icon name="spark" size={14}/>{pick(lang, 'LESS SWITCHING. MORE DOING.', 'आवेदनको तयारी एकै ठाउँमा')}</span><h2>{pick(lang, 'Your next application,', 'आवेदनको तयारी,')}<br/>{pick(lang, 'a little easier.', 'अझ सजिलो।')}</h2><p>{pick(lang, 'From a birth date to a ready-to-save photo. Keep the little things together, so you can get on with the big ones.', 'जन्ममिति मिलाउने, उमेर निकाल्ने र फोटो तयार पार्ने काम एकै ठाउँमा गर्नुहोस्।')}</p><a class="button primary" href={route(lang, 'guides/application-prep')}>{pick(lang, 'Prepare for a form', 'फाराम भर्नुअघि तयारी गर्नुहोस्')}<Icon name="arrow" size={18}/></a></div><div class="workflow-steps"><a href={route(lang, 'tools/date-converter')}><span class="step-number">01</span><span class="step-symbol coral"><Icon name="calendar" size={22}/></span><div><strong>{pick(lang, 'Get your date right', 'सही मिति निकाल्नुहोस्')}</strong><span>{pick(lang, 'Switch between BS and AD', 'नेपाली र अंग्रेजी मिति बदल्नुहोस्')}</span></div><Icon name="chevron" size={17}/></a><a href={route(lang, 'tools/age-calculator')}><span class="step-number">02</span><span class="step-symbol blue"><Icon name="cake" size={22}/></span><div><strong>{pick(lang, 'Check your age on the deadline', 'तोकिएको मितिमा उमेर हेर्नुहोस्')}</strong><span>{pick(lang, 'Know your completed years', 'कति वर्ष पुग्यो, थाहा पाउनुहोस्')}</span></div><Icon name="chevron" size={17}/></a><a href={route(lang, 'tools/photo-resizer')}><span class="step-number">03</span><span class="step-symbol green"><Icon name="crop" size={22}/></span><div><strong>{pick(lang, 'Make your photo fit', 'फोटोको आकार मिलाउनुहोस्')}</strong><span>{pick(lang, 'Resize, preview and download', 'साइज मिलाउनुहोस् र डाउनलोड गर्नुहोस्')}</span></div><Icon name="chevron" size={17}/></a></div></section>
    <section class="trust-row" aria-label={pick(lang, 'Why Sajilo Desk', 'किन सजिलो डेस्क')}><div><span class="trust-icon"><Icon name="shield" size={24}/></span><div><h3>{pick(lang, 'Your files stay yours', 'तपाईंका फाइल तपाईंसँगै')}</h3><p>{pick(lang, 'Photos and text are processed on your device.', 'फोटो र पाठको काम तपाईंको ब्राउजरमै हुन्छ।')}</p></div></div><div><span class="trust-icon"><Icon name="globe" size={24}/></span><div><h3>{pick(lang, 'At home in both languages', 'दुवै भाषामा सजिलो')}</h3><p>{pick(lang, 'Switch between English and नेपाली anytime.', 'चाहेको बेला नेपाली वा अंग्रेजीमा चलाउनुहोस्।')}</p></div></div><div><span class="trust-icon"><Icon name="heart" size={24}/></span><div><h3>{pick(lang, 'Useful first. Always free.', 'उपयोगी र निःशुल्क।')}</h3><p>{pick(lang, 'No sign-up standing between you and done.', 'प्रयोग गर्न खाता बनाउनु पर्दैन।')}</p></div></div></section>
  </div>
  <script>import '../../scripts/today';</script>
</Layout>
