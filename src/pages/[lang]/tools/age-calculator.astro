---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import DateInput from '../../../components/DateInput.astro';
import Icon from '../../../components/Icon.astro';
import { langs, pick } from '../../../lib/catalog';
export function getStaticPaths(){return langs.map(lang => ({params:{lang},props:{lang}}));}
const { lang } = Astro.props;
const instructions: [string,string][] = [[pick(lang,'Start with your birth date','जन्ममिति राख्नुहोस्'),pick(lang,'Choose BS or AD to match your document.','कागजातअनुसार वि.सं. वा ई.सं. छान्नुहोस्।')],[pick(lang,'Set the cutoff','अन्तिम मिति राख्नुहोस्'),pick(lang,'Use today, or enter the deadline from your application.','आज वा आवेदनमा लेखिएको अन्तिम मिति छान्नुहोस्।')],[pick(lang,'Copy the complete result','पूरा नतिजा कपी गर्नुहोस्'),pick(lang,'Includes your age and the dates used to calculate it.','उमेर र गणनामा प्रयोग भएको मिति कपी हुन्छ।')]];
---
<ToolLayout lang={lang} id="age-calculator" related="photo-resizer" instructions={instructions}>
  <div class="tool-workspace"><form class="panel" id="age-form" novalidate><div class="panel-heading"><h2>{pick(lang,'Your birth date','जन्ममिति')}</h2><label class="sr-only" for="birth-calendar">{pick(lang,'Birth-date calendar','जन्ममितिको पात्रो')}</label><select id="birth-calendar" style="width:95px;padding:7px 10px;font-size:12px"><option value="BS">BS / वि.सं.</option><option value="AD">AD / ई.सं.</option></select></div><p class="field-help">{pick(lang,'Example birth date: 1 Jan 2000 AD. Replace it with yours.','उदाहरण जन्ममिति: १ जनवरी २००० ई.सं.। आफ्नो मिति राख्नुहोस्।')}</p><DateInput prefix="birth" lang={lang}/><div class="panel-heading mt-20"><h2>{pick(lang,'Age on this date','यो मितिमा उमेर')}</h2><label class="sr-only" for="cutoff-calendar">{pick(lang,'Cutoff-date calendar','अन्तिम मितिको पात्रो')}</label><select id="cutoff-calendar" style="width:95px;padding:7px 10px;font-size:12px"><option value="AD">AD / ई.सं.</option><option value="BS">BS / वि.सं.</option></select></div><DateInput prefix="cutoff" lang={lang} calendar="AD"/><div class="text-counter"><button type="button" id="cutoff-today">{pick(lang,'Set cutoff to today in Nepal','अन्तिम मिति आज राख्नुहोस्')}</button></div><div id="form-error" class="error-box" role="alert" tabindex="-1" hidden></div><div class="panel-actions"><button class="button primary" type="submit">{pick(lang,'Calculate age','उमेर गणना गर्नुहोस्')}<Icon name="arrow" size={18}/></button><button class="button secondary" type="button" id="age-example">{pick(lang,'Example','उदाहरण')}</button></div><p class="privacy-note"><Icon name="shield" size={14}/>{pick(lang,'Birth dates stay in this page. No account or upload.','जन्ममिति यही पृष्ठमा रहन्छ। खाता वा अपलोड चाहिँदैन।')}</p></form>
    <section class="panel result-panel" aria-live="polite" aria-atomic="true"><div class="panel-heading"><h2>{pick(lang,'Your age on the cutoff','अन्तिम मितिमा उमेर')}</h2></div><div class="result-empty" id="result-empty"><span><Icon name="cake" size={25}/></span><p>{pick(lang,'Completed years, months and days, on the date that matters.','तोकिएको मितिमा पूरा भएका वर्ष, महिना र दिन।')}</p></div><div id="age-result" hidden><p class="panel-kicker">{pick(lang,'COMPLETED AGE · GREGORIAN','पूरा भएको उमेर · अंग्रेजी पात्रो')}</p><div class="age-result-grid"><div><strong id="age-years"></strong><span>{pick(lang,'years','वर्ष')}</span></div><div><strong id="age-months"></strong><span>{pick(lang,'months','महिना')}</span></div><div><strong id="age-days"></strong><span>{pick(lang,'days','दिन')}</span></div></div><p class="result-meta" id="age-total"></p><p class="result-meta" id="age-dates" style="white-space:pre-line"></p><button class="button full-width" type="button" id="copy-age"><Icon name="copy" size={17}/>{pick(lang,'Copy age & dates','उमेर र मिति कपी गर्नुहोस्')}</button></div><p class="info-note">{pick(lang,'An age calculation helps you prepare. The application authority determines eligibility.','यो गणना तयारीका लागि हो। योग्यताको निर्णय आवेदन लिने निकायले गर्छ।')}</p></section></div>
  <Fragment slot="method"><p>{pick(lang,'Both dates are converted to Gregorian before counting completed calendar months. Whole years are groups of 12 months. The remaining days are counted from the last monthly anniversary.','दुवै मितिलाई अंग्रेजी पात्रोमा बदलेर पूरा महिना गनिन्छ। १२ महिनाको एक वर्ष हुन्छ। बाँकी दिन पछिल्लो मासिक वार्षिकीबाट गनिन्छ।')}</p><p>{pick(lang,'Anniversaries are anchored to the original birth day and clamped to the last day of a shorter month. A 29 February birth reaches its anniversary on 28 February in a non-leap year; 31 January → 28 February is one month. No time-of-day or DST is used.','जन्मदिन नभएको छोटो महिनामा अन्तिम दिन प्रयोग हुन्छ। २९ फेब्रुअरीमा जन्मेको व्यक्तिको सामान्य वर्षको वार्षिकी २८ फेब्रुअरीमा पर्छ। ३१ जनवरीदेखि २८ फेब्रुअरी एक महिना हुन्छ। समय र DST प्रयोग हुँदैन।')}</p><p>{pick(lang,'BS conversion uses @remotemerge/nepali-date-converter v1.2.7; the same date range as our date converter applies.','वि.सं. परिवर्तनमा @remotemerge/nepali-date-converter v1.2.7 प्रयोग हुन्छ। मिति परिवर्तन उपकरणकै सीमा लागू हुन्छ।')}</p></Fragment>
  <script>import '../../../scripts/age-tool';</script>
</ToolLayout>
