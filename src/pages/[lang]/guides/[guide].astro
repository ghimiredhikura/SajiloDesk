---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { langs,pick,route } from '../../../lib/catalog';
export function getStaticPaths(){return ['application-prep','photo-size','nepali-dates'].flatMap(guide=>langs.map(lang=>({params:{lang,guide},props:{lang,guide}})));}
const {lang,guide}=Astro.props;
const titles:Record<string,[string,string]>={'application-prep':['Get ready for an online form','अनलाइन फारामको तयारी'],'photo-size':['Pixels, KB and a photo that fits','पिक्सेल, KB र मिल्ने फोटो'],'nepali-dates':['Two calendars, without the confusion','दुई पात्रो, अलमल नगरी']};
const title=pick(lang,...titles[guide]);
---
<Layout lang={lang} active="guides" title={title} description={pick(lang,'A practical Sajilo Desk guide with working tools and clear explanations.','उपयोगी उपकरण र स्पष्ट जानकारीसहित सजिलो डेस्कको सहयोगी लेख।')}><div class="container"><nav class="breadcrumbs"><a href={route(lang,'guides')}>{pick(lang,'Guides','सहयोगी लेख')}</a><Icon name="chevron" size={12}/><span>{title}</span></nav><article class="prose"><div class="page-heading"><p class="eyebrow">{pick(lang,'A SAJILO DESK GUIDE','सजिलो डेस्कको सहयोगी लेख')}</p><h1>{title}</h1><p>{pick(lang,'By Deepak Ghimire · Reviewed 4 November 2026','दीपक घिमिरे · समीक्षा: ४ नोभेम्बर २०२६')}</p></div>
{guide==='application-prep' && <><p>{pick(lang,'Before opening a long application form, prepare the dates and files you will need. This is a general preparation checklist; the instructions on your actual application remain the source of truth.','लामो आवेदन फाराम खोल्नुअघि चाहिने मिति र फाइल तयार पार्नुहोस्। यो सामान्य तयारी सूची हो; वास्तविक आवेदनको निर्देशन नै मान्नुपर्छ।')}</p><section class="guide-step"><h2>{pick(lang,'01 / Read the form’s requirements','०१ / फारामको नियम पढ्नुहोस्')}</h2><p>{pick(lang,'Find the official application page. Note which calendar it asks for, the deadline and time zone, accepted image formats, pixel dimensions and maximum file size. Do not assume every application uses the same photo rules.','आधिकारिक आवेदन पृष्ठ खोज्नुहोस्। चाहिने पात्रो, अन्तिम मिति र समय क्षेत्र, फोटोको प्रकार, पिक्सेल र अधिकतम फाइलको आकार टिप्नुहोस्। सबै आवेदनमा एउटै फोटोको नियम हुन्छ भन्ने नमान्नुहोस्।')}</p></section><section class="guide-step"><h2>{pick(lang,'02 / Convert the birth date','०२ / जन्ममिति परिवर्तन गर्नुहोस्')}</h2><p>{pick(lang,'If the document uses Bikram Sambat and the form asks for Gregorian, enter the original BS year, month and day. Copy the labeled result. Check that the day and month have not been reversed.','कागजातमा वि.सं. र फाराममा ई.सं. चाहिएको भए मूल वर्ष, महिना र गते राख्नुहोस्। नामसहितको नतिजा कपी गर्नुहोस्। दिन र महिना उल्टिएको छैन भनेर जाँच्नुहोस्।')}</p><a class="button secondary" href={route(lang,'tools/date-converter')}>{pick(lang,'Open date converter','मिति परिवर्तन खोल्नुहोस्')}<Icon name="arrow" size={16}/></a></section><section class="guide-step"><h2>{pick(lang,'03 / Check age at the actual cutoff','०३ / सही अन्तिम मितिमा उमेर जाँच्नुहोस्')}</h2><p>{pick(lang,'Use the date named in the application notice, which may differ from today or the submission deadline. Our age result uses the Gregorian calendar after any BS conversion. Check the authority’s own rule if eligibility depends on leap-day or month-end treatment.','सूचनामा उमेरका लागि तोकिएको मिति प्रयोग गर्नुहोस्। त्यो आज वा बुझाउने अन्तिम मितिभन्दा फरक हुन सक्छ। हाम्रो उमेर गणना वि.सं. परिवर्तनपछि अंग्रेजी पात्रोमा हुन्छ। योग्यता निर्धारणमा २९ फेब्रुअरी वा महिनाको अन्तिम दिनको नियम सम्बन्धित निकायसँग जाँच्नुहोस्।')}</p><a class="button secondary" href={route(lang,'tools/age-calculator')}>{pick(lang,'Open age calculator','उमेर गणना खोल्नुहोस्')}<Icon name="arrow" size={16}/></a></section><section class="guide-step"><h2>{pick(lang,'04 / Make a photo that meets the form','०४ / फारामअनुसार फोटो बनाउनुहोस्')}</h2><p>{pick(lang,'Choose the required dimensions and format. Add a file-size target if there is a limit. Preview the result: facial detail, text and edges should remain legible. Download the copy and verify its actual byte size.','चाहिएको पिक्सेल र फाइलको प्रकार छान्नुहोस्। सीमा भए फाइलको आकार राख्नुहोस्। अनुहार, अक्षर र किनारा स्पष्ट छन् कि झलकमा जाँच्नुहोस्। प्रतिलिपि डाउनलोड गरेर वास्तविक आकार हेर्नुहोस्।')}</p><a class="button secondary" href={route(lang,'tools/photo-resizer')}>{pick(lang,'Open photo resizer','फोटो मिलाउने उपकरण खोल्नुहोस्')}<Icon name="arrow" size={16}/></a></section><h2>{pick(lang,'A final check before you submit','बुझाउनुअघि अन्तिम जाँच')}</h2><ul><li>{pick(lang,'Compare each value against your source document.','हरेक विवरण मूल कागजातसँग दाँज्नुहोस्।')}</li><li>{pick(lang,'Open the downloaded file, rather than relying only on the preview.','झलकमा मात्र भर नपरी डाउनलोड गरिएको फाइल खोल्नुहोस्।')}</li><li>{pick(lang,'Return to the official form to upload, review and submit. Sajilo Desk does not submit on your behalf.','अपलोड, समीक्षा र बुझाउन आधिकारिक फाराममा फर्कनुहोस्। सजिलो डेस्कले तपाईंको तर्फबाट बुझाउँदैन।')}</li></ul><p class="info-note">{pick(lang,'Passport-specific upload presets are intentionally unavailable while official instructions differ. Consult the current Department of Passports route that applies to you.','आधिकारिक निर्देशन फरक भएकाले राहदानीका लागि प्रमाणित अपलोड सेटिङ उपलब्ध छैन। आफूलाई लागू हुने राहदानी विभागको हालको प्रक्रिया हेर्नुहोस्।')}</p><p><a href="https://nepalpassport.gov.np/">{pick(lang,'Department of Passports — official site','राहदानी विभाग — आधिकारिक वेबसाइट')} ↗</a></p></>}
{guide==='photo-size' && <><p>{pick(lang,'A photo can be the right width and height but still too large to upload. Pixel dimensions and file size measure different things. Start with the rule on the form, then adjust the right setting.','फोटोको चौडाइ र उचाइ मिले पनि अपलोड गर्न फाइल ठूलो हुन सक्छ। पिक्सेल र फाइलको आकार फरक कुरा हुन्। फारामको नियम हेरेर सही सेटिङ मिलाउनुहोस्।')}</p><h2>{pick(lang,'Pixels describe the picture','पिक्सेलले चित्रको आकार जनाउँछ')}</h2><p>{pick(lang,'A 600 × 800 px photo is 600 pixels wide and 800 pixels high. That is a portrait shape. Keeping the aspect ratio prevents stretching; center crop cuts the edges to fit an exact shape. Our Fit mode keeps the whole photo within your dimensions and never enlarges it.','६०० × ८०० px फोटोमा चौडाइ ६०० र उचाइ ८०० पिक्सेल हुन्छ। अनुपात राख्दा फोटो तन्किँदैन। बीचबाट काट्दा ठ्याक्कै आकारका लागि किनारा हट्छ। भित्र अटाउने विधिले पूरै फोटो राख्छ र ठूलो बनाउँदैन।')}</p><h2>{pick(lang,'KB describes the file','KB ले फाइलको आकार जनाउँछ')}</h2><p>{pick(lang,'Sajilo Desk uses decimal KB: 1 KB = 1,000 bytes. Some systems use KiB, where 1 KiB = 1,024 bytes. We show actual bytes as well, so you can check a strict limit. A more detailed photo often needs more bytes than a plain background at the same dimensions.','सजिलो डेस्कमा १ KB = १,००० बाइट हो। केही प्रणालीमा १ KiB = १,०२४ बाइट हुन्छ। कडा सीमा जाँच्न हामी वास्तविक बाइट पनि देखाउँछौँ। एउटै पिक्सेलमा पनि धेरै विवरण भएको फोटो ठूलो हुन सक्छ।')}</p><h2>{pick(lang,'Choose the right format','सही प्रकार छान्नुहोस्')}</h2><ul><li>{pick(lang,'JPEG is often useful for photos. Lower quality reduces size but can blur text and edges. Transparent areas become white.','JPEG फोटोमा उपयोगी हुन्छ। गुणस्तर घट्दा आकार घट्छ तर अक्षर र किनारा धमिलो हुन सक्छ। पारदर्शी भाग सेतो हुन्छ।')}</li><li>{pick(lang,'PNG preserves sharp text and transparency. The quality slider cannot compress it further. Reduce dimensions or choose another accepted format.','PNG ले स्पष्ट अक्षर र पारदर्शिता राख्छ। गुणस्तर स्लाइडरले यसको आकार घटाउँदैन। पिक्सेल घटाउनुहोस् वा स्वीकार्य अर्को प्रकार छान्नुहोस्।')}</li><li>{pick(lang,'WebP can produce small photo files, but only use it if the destination accepts WebP.','WebP ले सानो फोटो बनाउन सक्छ, तर सम्बन्धित वेबसाइटले स्वीकारे मात्र प्रयोग गर्नुहोस्।')}</li></ul><h2>{pick(lang,'When the target cannot be reached','चाहिएको आकार नपुग्दा')}</h2><p>{pick(lang,'We show the achievable result instead of claiming success. Try reducing both dimensions by 25%, then preview again. Never trade away legibility just to meet a byte limit; use the official support channel if a readable file cannot meet the requirement.','सफल भयो भनेर देखाउनुको सट्टा बनेको वास्तविक आकार देखाउँछौँ। दुवै किनारा २५% घटाएर फेरि हेर्नुहोस्। बाइट घटाउन पढ्नै नमिल्ने फोटो नबनाउनुहोस्। स्पष्ट फाइलले नियम पूरा नगरे आधिकारिक सहयोग लिनुहोस्।')}</p><a class="button primary" href={route(lang,'tools/photo-resizer')} style="color:white;text-decoration:none">{pick(lang,'Prepare a photo','फोटो तयार पार्नुहोस्')}<Icon name="arrow" size={17}/></a></>}
{guide==='nepali-dates' && <><p>{pick(lang,'Bikram Sambat (BS / वि.सं.) and Gregorian (AD / ई.सं.) label the same day differently. Many Nepali documents use BS, while international forms ask for Gregorian. Always identify the calendar before copying a date.','विक्रम संवत् (वि.सं.) र अंग्रेजी पात्रो (ई.सं.) ले एउटै दिनलाई फरक मिति दिन्छन्। धेरै नेपाली कागजातमा वि.सं. हुन्छ; अन्तर्राष्ट्रिय फारामले ई.सं. माग्न सक्छन्। मिति सार्नुअघि पात्रो पहिचान गर्नुहोस्।')}</p><h2>{pick(lang,'Why “add 57 years” does not work','किन “५७ वर्ष थप्ने” विधि मिल्दैन')}</h2><p>{pick(lang,'BS years start around mid-April, not on 1 January. Month lengths vary by BS year. A correct conversion needs a month-length table and an anchor date, not a fixed year or day offset.','वि.सं. वर्ष जनवरी १ मा होइन, अप्रिलको मध्यतिर सुरु हुन्छ। महिनाका दिन वर्षअनुसार फरक हुन्छन्। सही परिवर्तनमा महिनाका दिनको तालिका र आधार मिति चाहिन्छ, निश्चित वर्ष वा दिन थपेर हुँदैन।')}</p><div class="prose-card"><h3 style="margin-top:0">{pick(lang,'A checkable example','जाँच्न मिल्ने उदाहरण')}</h3><p><strong>२०८२ वैशाख १ वि.सं. = 14 April 2025 AD</strong></p><p>{pick(lang,'This date pair is published in the Nepal Embassy’s holiday list.','यो मितिको जोडी नेपाली दूतावासको बिदा सूचीमा छ।')} <a href="https://ae.nepalembassy.gov.np/pages/holidays-16/">{pick(lang,'See the source','स्रोत हेर्नुहोस्')} ↗</a></p></div><h2>{pick(lang,'Make the order explicit','क्रम स्पष्ट राख्नुहोस्')}</h2><p>{pick(lang,'Use separate year, month and day fields. In a numeric result such as 2082-01-01, our order is year-month-day. “04/05” alone can mean 4 May or 5 April in different countries. Keep the calendar label with the copied value.','वर्ष, महिना र गतेको छुट्टाछुट्टै स्थान प्रयोग गर्नुहोस्। २०८२-०१-०१ जस्तो नतिजामा क्रम वर्ष–महिना–गते हो। “०४/०५” ले देशअनुसार ४ मे वा ५ अप्रिल जनाउन सक्छ। कपी गर्दा पात्रोको नाम पनि राख्नुहोस्।')}</p><h2>{pick(lang,'Know the supported range','समर्थित सीमा बुझ्नुहोस्')}</h2><p>{pick(lang,'Our bundled table covers BS 1975-01-01 through 2099-12-30, or AD 1918-04-13 through 2043-04-13. Outside it, the tool returns an error rather than an estimate. Future BS dates follow the versioned table and should be checked against the published calendar for the year.','हाम्रो तालिका वि.सं. १९७५-०१-०१ देखि २०९९-१२-३० वा ई.सं. १९१८-०४-१३ देखि २०४३-०४-१३ सम्म छ। बाहिरको मितिमा अनुमानको सट्टा त्रुटि देखाइन्छ। भविष्यका मिति सम्बन्धित प्रकाशित पात्रोसँग जाँच्नुहोस्।')}</p><a class="button primary" href={route(lang,'tools/date-converter')} style="color:white;text-decoration:none">{pick(lang,'Convert a date','मिति परिवर्तन गर्नुहोस्')}<Icon name="arrow" size={17}/></a><p class="mt-20"><a href={route(lang,'methodology')}>{pick(lang,'Read the calculation methods and sources','गणना विधि र स्रोत पढ्नुहोस्')}</a></p></>}
</article></div></Layout>
