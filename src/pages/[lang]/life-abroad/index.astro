---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import KoreaJourneyPicker from '../../../components/KoreaJourneyPicker.astro';
import KoreaBrand from '../../../components/KoreaBrand.astro';
import { langs, pick, route } from '../../../lib/catalog';
import { reviewed, koreaTasks, textFor, koreaSources } from '../../../lib/korea';
export function getStaticPaths() { return langs.map(lang => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props;
---
<Layout lang={lang} active="abroad" title={pick(lang, 'SajiloDesk Korea · Visa and document guides', 'SajiloDesk Korea · भिसा र कागजातको जानकारी')} description={pick(lang, 'Korea immigration guides across all 37 status families: extensions, status changes, registration, work, study, family and travel. Official sources and dated bilingual checklists.', 'कोरियाका सबै ३७ मूल भिसा वर्गमा बसाइ, भिसा परिवर्तन, दर्ता, रोजगारी, पढाइ, परिवार र यात्राको जानकारी। आधिकारिक स्रोत र जाँचिएको मितिसहित नेपाली र अंग्रेजीमा।')}>
  <div class="container abroad-hub"><div class="abroad-heading"><KoreaBrand/><h1>{pick(lang, 'Life in Korea, made sajilo.', 'कोरियाको दैनिकी, अझ सजिलो।')}</h1><p>{pick(lang, 'Visa and document guides, in one place.', 'भिसा र कागजातबारे जानकारी, एकै ठाउँमा।')}</p></div>
  <section id="korea" aria-labelledby="korea-heading"><div class="abroad-section-title"><span class="abroad-country" aria-hidden="true"><Icon name="book" size={23}/></span><div><h2 id="korea-heading">{pick(lang, 'Get your documents ready.', 'कागजातको तयारी गरौँ।')}</h2></div></div>
    <KoreaJourneyPicker lang={lang}/>
    <details class="korea-coverage"><summary>{pick(lang,'37 status families · 21 tasks · what is covered?','३७ मूल भिसा वर्ग · २१ काम · के समेटिएको छ?')}</summary><p>{pick(lang,'All parent status families are selectable. Common subtypes have separate choices; use the parent for other subcodes. Detailed checklists and official-route guides are labelled separately. Availability in the menu does not establish eligibility.','सबै मूल भिसा वर्ग छान्न मिल्छ। धेरैलाई चाहिने केही उपप्रकार छुट्टै छन्; अरूमा मूल वर्ग छान्नुहोस्। विस्तृत सूची र आधिकारिक प्रक्रियाको जानकारी छुट्टाछुट्टै चिनाइएको छ। सूचीमा देखिँदैमा योग्यता पुगेको हुँदैन।')}</p><ul>{koreaTasks.map(task=><li>{textFor(lang,task.name)}</li>)}</ul><a href={koreaSources.manual.url} target="_blank" rel="noopener noreferrer">{pick(lang,'Official manual · 6 November 2026','आधिकारिक निर्देशिका · ६ नोभेम्बर २०२६')} ↗</a></details>
    <div class="abroad-explainer"><div><Icon name="book" size={22}/><h3>{pick(lang, 'Understand each document', 'कागजात बुझ्नुहोस्')}</h3><p>{pick(lang, 'Korean names, issuers and official forms, explained simply.', 'कोरियाली नाम, कागजात पाइने ठाउँ र आधिकारिक फाराम, सरल भाषामा।')}</p></div><div><Icon name="check" size={22}/><h3>{pick(lang, 'Keep track of your preparation', 'तयारीको हिसाब राख्नुहोस्')}</h3><p>{pick(lang, 'Tick, save or download your checklist. No document uploads.', 'तयार कागजातमा चिनो लगाउनुहोस्। सूची सेभ वा डाउनलोड गर्नुहोस्। कागजात अपलोड गर्नुपर्दैन।')}</p></div></div>
    <p class="abroad-review">{pick(lang, 'Sources checked', 'स्रोत जाँचिएको मिति')}: <time datetime={reviewed}>{pick(lang, '7 November 2026', '७ नोभेम्बर २०२६')}</time>. {pick(lang, 'Confirm your case with HiKorea / 1345.', 'आफ्नो अवस्थाबारे हाइकोरिया/१३४५ मा बुझ्नुहोस्।')}</p>
  </section>
  <section class="abroad-next"><h2>{pick(lang, 'Need another guide?', 'अर्को जानकारी चाहियो?')}</h2><p>{pick(lang, 'Suggest a visa, procedure or country in a guide’s comments, or send us a suggestion.', 'भिसा, प्रक्रिया वा अर्को देशको जानकारी सुझाउनुहोस्। टिप्पणी लेख्नुहोस् वा हामीलाई पठाउनुहोस्।')}</p><a class="text-link" href={route(lang, 'contact')}>{pick(lang, 'Suggest a service', 'सुझाव पठाउनुहोस्')} →</a></section></div>
</Layout>
