---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Icon from '../../../components/Icon.astro';
import { langs, pick } from '../../../lib/catalog';
export function getStaticPaths(){return langs.map(lang => ({params:{lang},props:{lang}}));}
const { lang } = Astro.props;
const instructions: [string,string][] = [[pick(lang,'Paste legacy Preeti text','पुरानो प्रीति अक्षर राख्नुहोस्'),pick(lang,'Text copied from a Preeti document often looks like g]kfn.','प्रीति कागजातबाट कपी गरेको अक्षर g]kfn जस्तो देखिन सक्छ।')],[pick(lang,'Convert and review','बदलेर जाँच्नुहोस्'),pick(lang,'Check names, vowel marks and punctuation in the preview.','नतिजामा नाम, मात्रा र विराम चिन्ह जाँच्नुहोस्।')],[pick(lang,'Copy or download','कपी वा डाउनलोड गर्नुहोस्'),pick(lang,'Use the Unicode result in messages, documents or websites.','युनिकोडलाई सन्देश, कागजात वा वेबसाइटमा प्रयोग गर्नुहोस्।')]];
---
<ToolLayout lang={lang} id="preeti-unicode" related="date-converter" instructions={instructions}>
  <form id="preeti-form" novalidate><div class="tool-workspace text-workspace"><div class="panel"><div class="panel-heading"><h2>{pick(lang,'Your Preeti text','प्रीति अक्षर')}</h2><span class="panel-kicker">{pick(lang,'PASTE HERE','यहाँ पेस्ट गर्नुहोस्')}</span></div><label class="sr-only" for="preeti-input">{pick(lang,'Preeti source text','मूल प्रीति अक्षर')}</label><textarea id="preeti-input" maxlength="50000" spellcheck="false" autocomplete="off" placeholder="g]kfn" aria-describedby="preeti-hint"></textarea><div class="text-counter"><span id="preeti-count">0 / 50,000</span><button id="preeti-example" type="button">{pick(lang,'Try an example','उदाहरण चलाउनुहोस्')}</button></div><p class="field-help" id="preeti-hint">{pick(lang,'Already have English in your text? Wrap it in [[double brackets]] to keep it unchanged.','अंग्रेजी अक्षर जस्ताको तस्तै राख्न [[double brackets]] भित्र राख्नुहोस्।')}</p><div class="panel-actions"><button type="submit" class="button primary">{pick(lang,'Convert to Unicode','युनिकोडमा बदल्नुहोस्')}<Icon name="arrow" size={18}/></button><button class="button secondary" type="button" id="preeti-reset">{pick(lang,'Reset','खाली गर्नुहोस्')}</button></div><div id="form-error" class="error-box" role="alert" tabindex="-1" hidden></div><p class="privacy-note"><Icon name="shield" size={14}/>{pick(lang,'Your text is processed here and is never uploaded.','अक्षर यहीँ प्रशोधन हुन्छन्। अपलोड हुँदैनन्।')}</p></div><div class="panel result-panel"><div class="panel-heading"><h2>{pick(lang,'Unicode text','युनिकोड अक्षर')}</h2><span class="panel-kicker">{pick(lang,'READY TO USE','प्रयोग गर्न तयार')}</span></div><label class="sr-only" for="preeti-output">{pick(lang,'Converted Unicode text','बदलिएको युनिकोड अक्षर')}</label><textarea class="output-text" id="preeti-output" readonly placeholder="नेपाल" aria-describedby="text-result-status"></textarea><p class="field-help" id="text-result-status" role="status">{pick(lang,'Your converted text will appear here.','बदलिएको अक्षर यहाँ देखिन्छ।')}</p><div class="panel-actions"><button class="button secondary" type="button" id="copy-preeti" disabled><Icon name="copy" size={17}/>{pick(lang,'Copy text','कपी गर्नुहोस्')}</button><button class="button secondary" type="button" id="download-preeti" disabled><Icon name="download" size={17}/>.txt</button></div><p class="info-note">{pick(lang,'Preeti font variants can differ. Review the output before using it in an official document.','प्रीति फन्टका प्रकार फरक हुन सक्छन्। औपचारिक कागजातमा राख्नुअघि नतिजा जाँच्नुहोस्।')}</p></div></div></form>
  <Fragment slot="method"><p>{pick(lang,'Converts legacy Preeti-encoded text, not Romanized Nepali typing. Uses @lacspace/preeti v1.1.0 under the commercially permissive Lacspace Free Licence v1.0. Character mapping includes short-i repositioning, conjuncts and repha.','यो पुरानो प्रीति अक्षरको परिवर्तन हो, Romanized Nepali टाइपिङ होइन। व्यावसायिक प्रयोग मिल्ने Lacspace Free Licence v1.0 अन्तर्गत @lacspace/preeti v1.1.0 प्रयोग हुन्छ। मात्रा, संयुक्त अक्षर र रेफको स्थान मिलाइन्छ।')}</p><p>{pick(lang,'Only text inside [[double brackets]] is explicitly preserved as English. Plain text does not contain font information, so English outside those markers is converted as Preeti. Limit: 50,000 characters per conversion. Automated sample tests are included; independent Nepali typist review is pending.','[[double brackets]] भित्रको अंग्रेजी मात्र जस्ताको तस्तै रहन्छ। सामान्य अक्षरमा फन्टको जानकारी हुँदैन, त्यसैले बाहिरको अंग्रेजी प्रीतिझैँ बदलिन्छ। एक पटकमा ५०,००० अक्षरको सीमा छ। स्वचालित नमुना परीक्षण छन्; स्वतन्त्र नेपाली टाइपिस्टको समीक्षा बाँकी छ।')}</p><a href="https://developer.lacspace.com/packages/preeti" target="_blank" rel="noopener noreferrer">{pick(lang,'Mapping documentation','अक्षर परिवर्तनको विवरण')} ↗</a> · <a href="/licenses/lacspace-preeti.txt">{pick(lang,'License','इजाजतपत्र')}</a></Fragment>
  <script>import '../../../scripts/preeti-tool';</script>
</ToolLayout>
