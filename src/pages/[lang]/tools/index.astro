---
import Layout from '../../../layouts/Layout.astro';
import ToolSearch from '../../../components/ToolSearch.astro';
import ToolGrid from '../../../components/ToolGrid.astro';
import { langs, pick } from '../../../lib/catalog';
export function getStaticPaths(){return langs.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props;
---
<Layout lang={lang} title={pick(lang,'All free tools','सबै निःशुल्क उपकरण')} description={pick(lang,'Find the tool for your next task. Search date conversion, age, Nepali text, photos, PDFs and land measurements.','मिति बदल्ने, उमेर निकाल्ने, प्रीतिको पाठ बदल्ने, फोटो र PDF मिलाउने अनि जग्गाको नाप निकाल्ने उपकरण खोज्नुहोस्।')} active="tools"><div class="container page-content"><div class="page-heading"><p class="eyebrow">{pick(lang,'YOUR EVERYDAY TOOLKIT','दैनिक कामका उपकरण')}</p><h1>{pick(lang,'A tool for the little things.','साना काममा ठूलो सहयोग।')}</h1><p>{pick(lang,'Pick a task. Get it done. No account, no waiting.','चाहिएको उपकरण छान्नुहोस् र काम सुरु गर्नुहोस्। खाता बनाउनु पर्दैन।')}</p><ToolSearch lang={lang}/></div><ToolGrid lang={lang}/></div></Layout>
