---
import { pick, route, type Lang } from '../lib/catalog';
interface Props { lang: Lang; slug: string; visa: string }
const { lang, slug, visa } = Astro.props;
---
<section class="community-section" id="experiences" data-comments data-thread={`korea-${slug}`} aria-labelledby="community-title">
  <p class="eyebrow">{pick(lang, 'FROM THE COMMUNITY', 'पाठकका अनुभव')}</p><h2 id="community-title">{pick(lang, 'Experiences & suggestions', 'अनुभव र सुझाव')}</h2>
  <p>{pick(lang, 'Share what helped or suggest a document we missed.', 'काम लागेको अनुभव वा छुटेका कागजात सुझाउनुहोस्।')}</p>
  <details class="community-guidelines"><summary>{pick(lang, 'Comment guidelines', 'टिप्पणी लेख्दा ध्यान दिनुहोस्')}</summary><p>{pick(lang, 'Reader experiences are unverified and separate from official requirements. We check suggestions against official sources before changing a guide. Comments become public after approval; names are not verified.', 'पाठकका अनुभव व्यक्तिगत हुन्, आधिकारिक नियम होइनन्। सुझावका आधारमा जानकारी फेर्नुअघि आधिकारिक स्रोतसँग जाँच्छौँ। स्वीकृत भएपछि टिप्पणी सार्वजनिक हुन्छ। नामको पहिचान पुष्टि गरिँदैन।')}</p></details>
  <div class="community-notice">{pick(lang, 'Reviewed before publication. Use a nickname; leave out passport/ARC numbers, contact details and private documents.', 'प्रकाशनअघि समीक्षा हुन्छ। उपनाम प्रयोग गर्नुहोस्। राहदानी/ARC नम्बर, सम्पर्क विवरण र निजी कागजात नराख्नुहोस्।')}</div>
  <div class="community-list" id="community-list" aria-live="polite"></div><p id="community-load-status" role="status">{pick(lang, 'Loading published comments…', 'प्रकाशित टिप्पणी लोड हुँदैछन्…')}</p><button type="button" class="button secondary" id="community-more" hidden>{pick(lang, 'Load more comments', 'थप टिप्पणी हेर्नुहोस्')}</button><button type="button" class="button secondary" id="community-retry" hidden>{pick(lang, 'Try loading again', 'फेरि लोड गर्नुहोस्')}</button>
  <form id="community-form" class="community-form" method="post" action="/api/comments">
    <h3>{pick(lang, visa ? `Share a ${visa} experience or suggestion` : 'Share an experience or suggestion', visa ? `${visa} को अनुभव वा सुझाव लेख्नुहोस्` : 'अनुभव वा सुझाव लेख्नुहोस्')}</h3>
    <div class="community-form-row"><div><label for="community-name">{pick(lang, 'Nickname (optional)', 'उपनाम (ऐच्छिक)')}</label><input id="community-name" name="name" maxlength="40" autocomplete="off" placeholder={pick(lang, 'e.g. A reader in Korea', 'जस्तै: कोरियाबाट एक पाठक')}/></div><div><label for="community-category">{pick(lang, 'What would you like to share?', 'के लेख्न चाहनुहुन्छ?')}</label><select id="community-category" name="category"><option value="experience">{pick(lang, 'My experience', 'आफ्नो अनुभव')}</option><option value="correction">{pick(lang, 'A document or correction', 'कागजात वा सच्याउने सुझाव')}</option><option value="request">{pick(lang, 'Request a new guide', 'नयाँ जानकारीको अनुरोध')}</option></select></div></div>
    <label for="community-message">{pick(lang, 'Your comment', 'तपाईंको टिप्पणी')}</label><textarea id="community-message" name="message" minlength="10" maxlength="1500" rows="4" required aria-describedby="community-message-help"></textarea><p id="community-message-help" class="abroad-small">{pick(lang, '10–1,500 characters. Add the month/year if helpful.', '१०–१,५०० अक्षर। उपयोगी भए महिना/वर्ष खुलाउनुहोस्।')}</p>
    <div class="community-trap" aria-hidden="true"><label for="community-website">Website</label><input id="community-website" name="website" tabindex="-1" autocomplete="off"/></div>
    <label class="community-consent"><input type="checkbox" id="community-consent" required/>{pick(lang, 'I agree to review and public display.', 'समीक्षा र सार्वजनिक प्रकाशनका लागि सहमत छु।')}</label>
    <div class="community-submit"><button type="submit" class="button primary" id="community-submit" disabled>{pick(lang, 'Submit for review', 'समीक्षाका लागि पठाउनुहोस्')}</button><a href={route(lang, 'privacy')}>{pick(lang, 'Privacy & removal requests', 'गोपनीयता र टिप्पणी हटाउने अनुरोध')}</a></div><p id="community-submit-status" role="status"></p>
  </form><noscript><p>{pick(lang, 'JavaScript is needed to load and submit comments. You can also send suggestions through our feedback page.', 'टिप्पणी हेर्न र पठाउन JavaScript चाहिन्छ। सुझाव पृष्ठबाट पनि सम्पर्क गर्न सक्नुहुन्छ।')} <a href={route(lang, 'contact')}>{pick(lang, 'Feedback', 'सुझाव')}</a></p></noscript>
</section>
