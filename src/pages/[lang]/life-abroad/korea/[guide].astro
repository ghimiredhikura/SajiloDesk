---
import Layout from '../../../../layouts/Layout.astro';
import Icon from '../../../../components/Icon.astro';
import KoreaComments from '../../../../components/KoreaComments.astro';
import KoreaJourneyPicker from '../../../../components/KoreaJourneyPicker.astro';
import KoreaBrand from '../../../../components/KoreaBrand.astro';
import { langs, pick, route } from '../../../../lib/catalog';
import { koreaGuides, koreaSources, reviewed, textFor, housingOptions } from '../../../../lib/korea';
export function getStaticPaths() { return langs.flatMap(lang => koreaGuides.map(guide => ({ params: { lang, guide: guide.slug }, props: { lang, guide } }))); }
const { lang, guide } = Astro.props;
const checked=guide.reviewed ?? reviewed;
const checkedLabel=new Intl.DateTimeFormat(lang==='ne'?'ne-NP':'en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(checked+'T00:00:00Z'));
const changing=guide.task==='change';
const hasHousing=guide.documents.some(d=>d.id==='address');
const hasOptions=hasHousing || ['d2-extension','e9-extension'].includes(guide.slug);
const alertSourceLabel=(id:string)=>id.startsWith('act')?`Act · ${id.slice(3)}`:({manual:'HiKorea manual',f4Address:'Gov24 · F-4',f4Law:'F-4 law',reentryRule:'Rule 44-2',workplaceLaw:'Work24',employment2026:'MOJ · 2026'} as Record<string,string>)[id]??koreaSources[id as keyof typeof koreaSources].name;
const steps = guide.steps ?? [
  ['Apply before your stay expires. A visit booking only reserves a slot.', 'म्यादभित्र आवेदन दिनुहोस्। भेटको समय बुक गर्नु र आवेदन दिनु फरक काम हुन्।'],
  ['Check HiKorea for online submission or a visit. Confirm fees, originals/copies, certificate age and any additional evidence.', 'हाइकोरियामा अनलाइन आवेदन वा भेटको व्यवस्था हेर्नुहोस्। शुल्क, सक्कल/प्रतिलिपि, प्रमाणपत्रको मिति र थप प्रमाणबारे बुझ्नुहोस्।'],
  ['Ask 1345 about special cases. Keep your receipt and check the decision.', 'विशेष अवस्थाबारे १३४५ मा बुझ्नुहोस्। रसिद राख्नुहोस् र निर्णय हेर्नुहोस्।'],
] as const;
const kindNames = { form: ['Blank form to complete', 'आफैँ भर्ने फाराम'], issued: ['Certificate to obtain', 'निकायबाट लिने प्रमाणपत्र'], identity: ['Existing identity document', 'पहिल्यै भएको परिचय कागजात'], evidence: ['Supporting evidence', 'पुष्टि गर्ने कागजात'], check: ['Check your situation', 'आफ्नो अवस्थाअनुसार बुझ्नुहोस्'] } as const;
const requirementNames = { required: ['Baseline document', 'आधारभूत कागजात'], conditional: ['If applicable', 'लागू भएमा'], confirm: ['Confirm for your case', 'आफ्नो अवस्थाअनुसार बुझ्नुहोस्'] } as const;
---
<Layout lang={lang} active="abroad" title={`${guide.visa === 'ALL' ? pick(lang, 'Korea', 'कोरिया') : guide.visa} · ${textFor(lang, guide.title)}`} description={textFor(lang, guide.scope)}>
<div class="container korea-page" data-korea-guide={guide.slug} data-reviewed={checked} data-task={guide.task} data-guide-visa={guide.visa}>
  <nav class="breadcrumbs" aria-label={pick(lang, 'Breadcrumb', 'पृष्ठको बाटो')}><a href={route(lang)}>{pick(lang, 'Home', 'गृहपृष्ठ')}</a><span>/</span><a href={route(lang, 'life-abroad')}>{pick(lang, 'Life abroad', 'विदेशको दैनिकी')}</a><span>/</span><span>{pick(lang, 'Korea', 'कोरिया')}</span></nav>
  <div class="korea-page-heading"><div><p class="eyebrow"><KoreaBrand/> <span class="visa-tag">{guide.visa === 'ALL' ? pick(lang,'Korea immigration','कोरिया अध्यागमन') : guide.visa}</span></p><h1>{textFor(lang, guide.title)}</h1><p>{textFor(lang, guide.intro ?? guide.scope)}</p></div><a href="#experiences" class="text-link">{pick(lang, 'Experiences & suggestions', 'अनुभव र सुझाव')} ↓</a></div>
  <KoreaJourneyPicker lang={lang} visa={guide.visa === 'ALL' || changing ? '' : guide.visa} target={changing ? guide.visa==='ALL'?'other':guide.visa : ''} task={guide.task ?? 'extension'} compact/>
  <p class="korea-review-line"><span>{pick(lang,guide.coverage==='checklist'?'Document checklist':'Official route & document categories',guide.coverage==='checklist'?'कागजातको सूची':'आधिकारिक प्रक्रिया र कागजातका प्रकार')}</span><span>{pick(lang,'Last checked','पछिल्लो जाँच')}: <time datetime={checked}>{checkedLabel}</time></span></p>
  <div class="korea-context" hidden><strong id="korea-context-label"></strong><p id="korea-context-caution"></p><a href={koreaSources.manual.url} target="_blank" rel="noopener noreferrer">{pick(lang,'Official status manual','आधिकारिक भिसा निर्देशिका')} ↗</a></div>
  {guide.alerts?.map(alert=><aside class="korea-deadline" data-alert-visas={alert.visas?.join(',')}><strong>{textFor(lang,alert.title)}</strong><p>{textFor(lang,alert.text)}</p>{alert.detail && <details><summary>{pick(lang,'Penalty details & next step','कारबाही र अब के गर्ने?')}</summary><p>{textFor(lang,alert.detail)}</p></details>}<div class="document-source-links">{alert.sources.map(id=><a href={koreaSources[id].url} title={koreaSources[id].name} target="_blank" rel="noopener noreferrer">{alertSourceLabel(id)} ↗</a>)}</div></aside>)}
  {!guide.alerts?.length && <div class="korea-notice"><Icon name="info" size={20}/><p>{textFor(lang, guide.hint ?? guide.warning)}</p></div>}
<p class="korea-stale" hidden>{pick(lang, 'This guide has not been checked in the last 90 days. Recheck the official sources and your case before relying on it.', 'यो जानकारी पछिल्लो ९० दिनमा जाँचिएको छैन। प्रयोग गर्नुअघि आधिकारिक स्रोत र आफ्नो अवस्था फेरि बुझ्नुहोस्।')}</p>
<details class="korea-scope"><summary><span>{pick(lang, 'Scope & exceptions', 'कसका लागि हो?')}</span></summary><p>{textFor(lang, guide.scope)}</p><p>{textFor(lang, guide.warning)}</p></details>
  <div class="korea-workspace"><aside class="korea-progress" aria-labelledby="progress-title"><p class="eyebrow" id="progress-title">{pick(lang, 'YOUR PREPARATION', 'तपाईंको तयारी')}</p><strong id="korea-progress-text" role="status">{pick(lang, 'Your checklist is ready', 'कागजातको सूची तयार छ')}</strong><progress id="korea-progress" value="0" max="1" aria-label={pick(lang, 'Documents marked prepared', 'तयार भएको चिनो लगाइएका कागजात')}></progress><button class="button primary" id="korea-save" type="button" aria-label={pick(lang, 'Save this checklist on this device', 'कागजातको सूची यही उपकरणमा सेभ गर्नुहोस्')}>{pick(lang, 'Save', 'सेभ')}</button><button class="button secondary" id="korea-download" type="button" aria-label={pick(lang, 'Download this checklist', 'कागजातको सूची डाउनलोड गर्नुहोस्')}><Icon name="download" size={16}/>{pick(lang, 'Download', 'डाउनलोड')}</button><button class="korea-reset" id="korea-reset" type="button" title={pick(lang, 'Reset this checklist', 'यो सूचीको चिनो हटाउनुहोस्')} aria-label={pick(lang, 'Reset this checklist', 'यो सूचीको चिनो हटाउनुहोस्')}><span class="reset-label">{pick(lang, 'Reset', 'चिनो हटाउनुहोस्')}</span><span class="reset-glyph" aria-hidden="true">↺</span></button><p id="korea-save-status" role="status" class="abroad-small">{pick(lang, 'This browser only.', 'यही ब्राउजरमा मात्र।')}</p></aside>
    <div class="korea-document-area">{hasOptions && <details class="korea-options"><summary><h2>{pick(lang, 'Adjust this checklist', 'आफ्नो अवस्था मिलाउनुहोस्')}</h2></summary><div class="korea-option-fields">{guide.slug === 'd2-extension' && <div><label for="korea-stage">{pick(lang, 'Study stage', 'पढाइको अवस्था')}</label><select id="korea-stage" data-answer="stage"><option value="regular">{pick(lang, 'Regular degree coursework', 'नियमित अध्ययन')}</option><option value="thesis">{pick(lang, 'Master’s / doctoral thesis preparation', 'स्नातकोत्तर / विद्यावारिधिको शोधपत्र तयारी')}</option></select></div>}{guide.slug === 'e9-extension' && <div><label for="korea-employment">{pick(lang, 'Employment situation', 'रोजगारको अवस्था')}</label><select id="korea-employment" data-answer="employment"><option value="unsure">{pick(lang, 'Not sure — show the additional confirmation', 'निश्चित छैन — थप पुष्टि पत्र पनि देखाउनुहोस्')}</option><option value="renewal">{pick(lang, 'Contract renewal within my permitted employment period', 'रोजगार गर्न पाउने अवधिभित्र सम्झौता नवीकरण')}</option><option value="reemployment">{pick(lang, 'Re-employment extending my employment-activity period', 'पुनःरोजगारीमार्फत रोजगार गर्न पाउने अवधि थप्ने')}</option></select></div>}{hasHousing && <div><label for="korea-housing">{pick(lang, 'Where do you live?', 'कहाँ बस्नुहुन्छ?')}</label><select id="korea-housing" data-answer="housing">{housingOptions.map(option => <option value={option.id}>{textFor(lang, option.name)}</option>)}</select></div>}</div></details>}
    <div class="korea-list-heading"><h2>{pick(lang, guide.coverage==='checklist'?'Your document checklist':'Documents to prepare / confirm', guide.coverage==='checklist'?'कागजातको सूची':'तयार गर्ने / बुझ्नुपर्ने कागजात')}</h2><span>{pick(lang, 'Open a document for details', 'विवरण हेर्न कागजात खोल्नुहोस्')}</span></div>
    {guide.documents.map(doc => <article class="korea-document" data-document={doc.id} data-condition-field={doc.condition?.field} data-condition-value={doc.condition?.value} data-requirement={doc.requirement} data-document-visas={doc.visas?.join(',')}>
      <div class="korea-document-check"><input id={`ready-${doc.id}`} type="checkbox" data-ready={doc.id} aria-label={`${pick(lang, 'Mark prepared or checked', 'तयार/बुझेको चिनो लगाउनुहोस्')}: ${textFor(lang, doc.name)}`}/></div>
      <details><summary><span><span class="korea-korean" lang="ko">{doc.korean}</span><strong>{textFor(lang, doc.name)}</strong></span><span class:list={['requirement-tag', doc.requirement]}>{doc.visas ? `${doc.visas.join(' / ')} · ` : ''}{textFor(lang, requirementNames[doc.requirement])}</span></summary><div class="korea-document-body"><p class="document-kind">{textFor(lang, kindNames[doc.kind])}</p><dl><dt>{pick(lang, 'From', 'कहाँबाट')}</dt><dd>{textFor(lang, doc.issuer)}</dd><dt>{pick(lang, 'How to get it', 'कसरी लिने')}</dt><dd>{textFor(lang, doc.obtain)}</dd></dl>{doc.detail && <p>{textFor(lang, doc.detail)}</p>}{doc.id === 'address' && <div class="korea-housing-help">{housingOptions.map(option => <p data-housing={option.id}>{textFor(lang, option.detail)}</p>)}</div>}<div class="document-source-links">{doc.sources.map(id => <a href={koreaSources[id].url} title={koreaSources[id].name} target="_blank" rel="noopener noreferrer">{koreaSources[id].name} ↗</a>)}</div></div></details>
    </article>)}
    <noscript><p class="korea-notice">{pick(lang, 'All document options are shown. JavaScript enables filtering, progress and saving. You can still read every document and its sources.', 'सबै अवस्थाका कागजात देखाइएका छन्। छान्ने, प्रगति हेर्ने र सेभ गर्ने सुविधाका लागि JavaScript चाहिन्छ। कागजात र स्रोत भने पढ्न सक्नुहुन्छ।')}</p></noscript>
    <section class="korea-next-steps"><h2>{pick(lang, guide.procedure === 'address' ? 'Before you report' : 'Before you submit', guide.procedure === 'address' ? 'सूचना दिनुअघि' : 'बुझाउनुअघि')}</h2><ol>{steps.map(step => <li>{textFor(lang, step)}</li>)}</ol><a href="https://www.hikorea.go.kr/" target="_blank" rel="noopener noreferrer" class="button secondary">{pick(lang, 'Open HiKorea', 'हाइकोरिया खोल्नुहोस्')} ↗</a> <a href={koreaSources.help.url} target="_blank" rel="noopener noreferrer" class="text-link">{pick(lang, '1345 contact & hours', '१३४५ सम्पर्क र समय')} ↗</a></section>
    </div></div>
  <section id="guide-sources" class="korea-sources"><details><summary>{pick(lang, 'Official sources, review date & coverage', 'आधिकारिक स्रोत, जाँचिएको मिति र दायरा')}</summary><p>{pick(lang, 'Checked against the linked official sources on the date above, including HiKorea’s 6 November 2026 manual. A family-level route is not every subtype’s final checklist. Penalties shown are legal maxima for the stated violation, not predicted charges. Official notices and individual immigration instructions take precedence.', 'माथिको मितिमा हाइकोरियाको ६ नोभेम्बर २०२६ को निर्देशिकासहित जोडिएका आधिकारिक स्रोत जाँचिएका छन्। मूल वर्गको जानकारी सबै उपप्रकारको अन्तिम सूची होइन। देखाइएका जरिवाना उल्लेखित उल्लङ्घनको कानुनी अधिकतम सीमा हुन्; अनुमानित रकम होइनन्। आधिकारिक सूचना र अध्यागमनले दिएको व्यक्तिगत निर्देशन लागू हुन्छन्।')}</p><ul>{guide.sources.map(id => <li><a href={koreaSources[id].url} title={koreaSources[id].name} target="_blank" rel="noopener noreferrer">{koreaSources[id].name} ↗</a><p>{textFor(lang, koreaSources[id].note)}</p></li>)}</ul></details></section>
  <KoreaComments lang={lang} slug={guide.slug} visa={guide.visa === 'ALL' ? '' : guide.visa}/>
</div><script>import '../../../../scripts/korea-guide'; import '../../../../scripts/community';</script>
</Layout>
