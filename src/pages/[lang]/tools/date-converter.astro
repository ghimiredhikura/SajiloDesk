---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import DateInput from '../../../components/DateInput.astro';
import Icon from '../../../components/Icon.astro';
import { langs, pick } from '../../../lib/catalog';
export function getStaticPaths(){return langs.map(lang => ({params:{lang},props:{lang}}));}
const { lang } = Astro.props;
const instructions: [string,string][] = [
  [pick(lang,'Choose your calendar','पात्रो छान्नुहोस्'),pick(lang,'Choose BS → AD or AD → BS. Nepali and Latin digits both work.','वि.सं. → ई.सं. वा ई.सं. → वि.सं. छान्नुहोस्। नेपाली र अंग्रेजी दुवै अंक राख्न मिल्छ।')],
  [pick(lang,'Enter the exact date','पूरा मिति राख्नुहोस्'),pick(lang,'Use the year, month and day from your document.','कागजातमा भएको वर्ष, महिना र गते राख्नुहोस्।')],
  [pick(lang,'Copy your result','नतिजा कपी गर्नुहोस्'),pick(lang,'Both calendar dates are clearly labeled for your records.','वि.सं. र ई.सं. खुलेका दुवै मिति एकै पटक कपी गर्न मिल्छ।')],
];
---
<ToolLayout lang={lang} id="date-converter" related="age-calculator" instructions={instructions}>
  <div class="tool-workspace"><form class="panel" id="date-form" novalidate><div class="panel-heading"><h2>{pick(lang,'Which date are we converting?','कुन मिति परिवर्तन गर्ने?')}</h2></div><div class="segmented" role="group" aria-label={pick(lang,'Conversion direction','कुन पात्रोबाट कुनमा बदल्ने')}><button type="button" data-direction="BS" aria-pressed="true">{pick(lang,'BS → AD','वि.सं. → ई.सं.')}</button><button type="button" data-direction="AD" aria-pressed="false">{pick(lang,'AD → BS','ई.सं. → वि.सं.')}</button></div><DateInput prefix="date" lang={lang}/><div id="form-error" class="error-box" role="alert" tabindex="-1" hidden></div><div class="panel-actions"><button class="button primary" type="submit">{pick(lang,'Convert date','मिति बदल्नुहोस्')}<Icon name="arrow" size={18}/></button><button class="button secondary" type="button" id="use-today">{pick(lang,'Today','आज')}</button></div><div class="text-counter"><button type="button" id="date-example">{pick(lang,'Try an example: 2082-01-01 BS','उदाहरण: २०८२-०१-०१ वि.सं.')}</button></div><p class="privacy-note"><Icon name="shield" size={14}/>{pick(lang,'Your date stays in this page. Nothing is uploaded.','तपाईंले राखेको मिति ब्राउजरमै रहन्छ, कतै पठाइँदैन।')}</p></form>
    <section class="panel result-panel" aria-live="polite" aria-atomic="true"><div class="panel-heading"><h2>{pick(lang,'Your converted date','अर्को पात्रोमा मिति')}</h2><span class="panel-kicker">{pick(lang,'THE RESULT','नतिजा')}</span></div><div class="result-empty" id="result-empty"><span><Icon name="calendar" size={25}/></span><p>{pick(lang,'Two calendars, one day. Your result will appear here.','मिति राखेर बदल्नुहोस्। नतिजा यहाँ देखिन्छ।')}</p></div><div id="date-result" class="result-content" hidden><p class="result-caption" id="result-primary-label"></p><p class="result-date" id="result-primary"></p><p class="result-caption" id="result-secondary-label"></p><p class="result-secondary" id="result-secondary"></p><p class="result-meta" id="result-iso"></p><button class="button full-width" id="copy-date" type="button"><Icon name="copy" size={17}/>{pick(lang,'Copy both dates','दुवै मिति कपी गर्नुहोस्')}</button></div></section></div>
  <Fragment slot="method"><p>{pick(lang,'Uses the bundled month-length table in @remotemerge/nepali-date-converter v1.2.7 (MIT). Supported range: BS 1975-01-01 to 2099-12-30, corresponding to AD 1918-04-13 to 2043-04-13. Invalid dates are rejected.','@remotemerge/nepali-date-converter v1.2.7 (MIT) मा रहेको प्रत्येक महिनाको दिनसङ्ख्याको तालिकाबाट मिति बदलिन्छ। वि.सं. १९७५-०१-०१ देखि २०९९-१२-३० (ई.सं. १९१८-०४-१३ देखि २०४३-०४-१३) सम्मका मिति राख्न मिल्छ। पात्रोमा नभएको मिति राखेमा सच्याउन भनिन्छ।')}</p><p>{pick(lang,'Date-only conversion is independent of your time zone. Today uses Asia/Kathmandu. Future BS dates follow the bundled table and should be checked against the calendar issued for that year.','तपाईं जुन देशमा भए पनि एउटै मितिको नतिजा उही आउँछ। ‘आज’ थिच्दा नेपालको मिति प्रयोग हुन्छ। भविष्यको वि.सं. मिति तालिकाअनुसार निकालिन्छ, त्यसैले सम्बन्धित वर्षको प्रकाशित पात्रोसँग पनि जाँच्नुहोस्।')}</p><a href="https://github.com/remotemerge/nepali-date-converter" target="_blank" rel="noopener noreferrer">{pick(lang,'Calendar source & license','पात्रोको स्रोत र इजाजतपत्र')} ↗</a></Fragment>
  <script>import '../../../scripts/date-tool';</script>
</ToolLayout>
