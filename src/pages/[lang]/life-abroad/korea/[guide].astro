---
import Layout from '../../../../layouts/Layout.astro';
import Icon from '../../../../components/Icon.astro';
import KoreaComments from '../../../../components/KoreaComments.astro';
import KoreaJourneyPicker from '../../../../components/KoreaJourneyPicker.astro';
import { langs, pick, route } from '../../../../lib/catalog';
import { koreaGuides, koreaSources, reviewed, textFor, housingOptions } from '../../../../lib/korea';
export function getStaticPaths() { return langs.flatMap(lang => koreaGuides.map(guide => ({ params: { lang, guide: guide.slug }, props: { lang, guide } }))); }
const { lang, guide } = Astro.props;
const steps = guide.steps ?? [
  ['Apply before your stay expires. A visit booking only reserves a slot.', 'म्यादभित्र आवेदन दिनुहोस्। भेटको समय बुक गर्नु र आवेदन दिनु फरक काम हुन्।'],
  ['Check HiKorea for online submission or a visit. Confirm fees, originals/copies, certificate age and any additional evidence.', 'हाइकोरियामा अनलाइन आवेदन वा भेटको व्यवस्था हेर्नुहोस्। शुल्क, सक्कल/प्रतिलिपि, प्रमाणपत्रको मिति र थप प्रमाणबारे बुझ्नुहोस्।'],
  ['Ask 1345 about special cases. Keep your receipt and check the decision.', 'विशेष अवस्थाबारे १३४५ मा बुझ्नुहोस्। रसिद राख्नुहोस् र निर्णय हेर्नुहोस्।'],
] as const;
const kindNames = { form: ['Blank form to complete', 'आफैँ भर्ने फाराम'], issued: ['Certificate to obtain', 'निकायबाट लिने प्रमाणपत्र'], identity: ['Existing identity document', 'पहिल्यै भएको परिचय कागजात'], evidence: ['Supporting evidence', 'पुष्टि गर्ने कागजात'], check: ['Check your situation', 'आफ्नो अवस्थाअनुसार बुझ्नुहोस्'] } as const;
const requirementNames = { required: ['Baseline document', 'आधारभूत कागजात'], conditional: ['If applicable', 'लागू भएमा'], confirm: ['Confirm with your school', 'संस्थासँग बुझ्नुहोस्'] } as const;
---
<Layout lang={lang} active="abroad" title={`${guide.visa === 'ALL' ? pick(lang, 'Korea', 'कोरिया') : guide.visa} · ${textFor(lang, guide.title)}`} description={textFor(lang, guide.scope)}>
<div class="container korea-page" data-korea-guide={guide.slug} data-reviewed={reviewed}>
  <nav class="breadcrumbs" aria-label={pick(lang, 'Breadcrumb', 'पृष्ठको बाटो')}><a href={route(lang)}>{pick(lang, 'Home', 'गृहपृष्ठ')}</a><span>/</span><a href={route(lang, 'life-abroad')}>{pick(lang, 'Life abroad', 'विदेशको दैनिकी')}</a><span>/</span><span>{pick(lang, 'Korea', 'कोरिया')}</span></nav>
  <div class="korea-page-heading"><div><p class="eyebrow">{pick(lang, 'LIFE ABROAD · KOREA', 'विदेशको दैनिकी · कोरिया')} <span class="visa-tag">{guide.visa === 'ALL' ? 'D-2 / D-4-1 / E-9' : guide.visa}</span></p><h1>{textFor(lang, guide.title)}</h1><p>{textFor(lang, guide.intro ?? guide.scope)}</p></div><a href="#experiences" class="text-link">{pick(lang, 'Experiences & suggestions', 'अनुभव र सुझाव')} ↓</a></div>
  <KoreaJourneyPicker lang={lang} visa={guide.visa === 'ALL' ? '' : guide.visa} task={guide.procedure === 'address' ? 'address' : 'extension'} compact/>
  <div class="korea-notice"><Icon name="info" size={20}/><p>{textFor(lang, guide.hint ?? guide.warning)}</p></div>
<p class="korea-stale" hidden>{pick(lang, 'This guide has not been checked in the last 90 days. Recheck the official sources and your case before relying on it.', 'यो जानकारी पछिल्लो ९० दिनमा जाँचिएको छैन। प्रयोग गर्नुअघि आधिकारिक स्रोत र आफ्नो अवस्था फेरि बुझ्नुहोस्।')}</p>
<details class="korea-scope"><summary><span>{pick(lang, 'Scope & exceptions', 'कसका लागि हो?')}</span><span class="abroad-review">{pick(lang, 'Checked', 'जाँचिएको')}: <time datetime={reviewed}>{pick(lang, '6 November 2026', '६ नोभेम्बर २०२६')}</time></span></summary><p>{textFor(lang, guide.scope)}</p><p>{textFor(lang, guide.warning)}</p></details>
  <div class="korea-workspace"><aside class="korea-progress" aria-labelledby="progress-title"><p class="eyebrow" id="progress-title">{pick(lang, 'YOUR PREPARATION', 'तपाईंको तयारी')}</p><strong id="korea-progress-text" role="status">{pick(lang, 'Your checklist is ready', 'कागजातको सूची तयार छ')}</strong><progress id="korea-progress" value="0" max="1" aria-label={pick(lang, 'Documents marked prepared', 'तयार भएको चिनो लगाइएका कागजात')}></progress><button class="button primary" id="korea-save" type="button" aria-label={pick(lang, 'Save this checklist on this device', 'कागजातको सूची यही उपकरणमा सेभ गर्नुहोस्')}>{pick(lang, 'Save', 'सेभ')}</button><button class="button secondary" id="korea-download" type="button" aria-label={pick(lang, 'Download this checklist', 'कागजातको सूची डाउनलोड गर्नुहोस्')}><Icon name="download" size={16}/>{pick(lang, 'Download', 'डाउनलोड')}</button><button class="korea-reset" id="korea-reset" type="button" title={pick(lang, 'Reset this checklist', 'यो सूचीको चिनो हटाउनुहोस्')} aria-label={pick(lang, 'Reset this checklist', 'यो सूचीको चिनो हटाउनुहोस्')}><span class="reset-label">{pick(lang, 'Reset', 'चिनो हटाउनुहोस्')}</span><span class="reset-glyph" aria-hidden="true">↺</span></button><p id="korea-save-status" role="status" class="abroad-small">{pick(lang, 'This browser only.', 'यही ब्राउजरमा मात्र।')}</p></aside>
    <div class="korea-document-area"><details class="korea-options"><summary><h2>{pick(lang, 'Adjust this checklist', 'आफ्नो अवस्था मिलाउनुहोस्')}</h2></summary><div class="korea-option-fields">{guide.visa === 'D-2' && <div><label for="korea-stage">{pick(lang, 'Study stage', 'पढाइको अवस्था')}</label><select id="korea-stage" data-answer="stage"><option value="regular">{pick(lang, 'Regular degree coursework', 'नियमित अध्ययन')}</option><option value="thesis">{pick(lang, 'Master’s / doctoral thesis preparation', 'स्नातकोत्तर / विद्यावारिधिको शोधपत्र तयारी')}</option></select></div>}{guide.visa === 'E-9' && <div><label for="korea-employment">{pick(lang, 'Employment situation', 'रोजगारको अवस्था')}</label><select id="korea-employment" data-answer="employment"><option value="unsure">{pick(lang, 'Not sure — show the additional confirmation', 'निश्चित छैन — थप पुष्टि पत्र पनि देखाउनुहोस्')}</option><option value="renewal">{pick(lang, 'Contract renewal within my permitted employment period', 'रोजगार गर्न पाउने अवधिभित्र सम्झौता नवीकरण')}</option><option value="reemployment">{pick(lang, 'Re-employment extending my employment-activity period', 'पुनःरोजगारीमार्फत रोजगार गर्न पाउने अवधि थप्ने')}</option></select></div>}<div><label for="korea-housing">{pick(lang, 'Where do you live?', 'कहाँ बस्नुहुन्छ?')}</label><select id="korea-housing" data-answer="housing">{housingOptions.map(option => <option value={option.id}>{textFor(lang, option.name)}</option>)}</select></div></div></details>
    <div class="korea-list-heading"><h2>{pick(lang, 'Your document checklist', 'कागजातको सूची')}</h2><span>{pick(lang, 'Open a document for details', 'विवरण हेर्न कागजात खोल्नुहोस्')}</span></div>
    {guide.documents.map(doc => <article class="korea-document" data-document={doc.id} data-condition-field={doc.condition?.field} data-condition-value={doc.condition?.value} data-requirement={doc.requirement}>
      <div class="korea-document-check"><input id={`ready-${doc.id}`} type="checkbox" data-ready={doc.id} aria-label={`${pick(lang, 'Mark prepared or checked', 'तयार/बुझेको चिनो लगाउनुहोस्')}: ${textFor(lang, doc.name)}`}/></div>
      <details><summary><span><span class="korea-korean" lang="ko">{doc.korean}</span><strong>{textFor(lang, doc.name)}</strong></span><span class:list={['requirement-tag', doc.requirement]}>{textFor(lang, requirementNames[doc.requirement])}</span></summary><div class="korea-document-body"><p class="document-kind">{textFor(lang, kindNames[doc.kind])}</p><dl><dt>{pick(lang, 'From', 'कहाँबाट')}</dt><dd>{textFor(lang, doc.issuer)}</dd><dt>{pick(lang, 'How to get it', 'कसरी लिने')}</dt><dd>{textFor(lang, doc.obtain)}</dd></dl>{doc.detail && <p>{textFor(lang, doc.detail)}</p>}{doc.id === 'address' && <div class="korea-housing-help">{housingOptions.map(option => <p data-housing={option.id}>{textFor(lang, option.detail)}</p>)}</div>}<div class="document-source-links">{doc.sources.map(id => <a href={koreaSources[id].url} target="_blank" rel="noopener noreferrer">{koreaSources[id].name} ↗</a>)}</div></div></details>
    </article>)}
    <noscript><p class="korea-notice">{pick(lang, 'All document options are shown. JavaScript enables filtering, progress and saving. You can still read every document and its sources.', 'सबै अवस्थाका कागजात देखाइएका छन्। छान्ने, प्रगति हेर्ने र सेभ गर्ने सुविधाका लागि JavaScript चाहिन्छ। कागजात र स्रोत भने पढ्न सक्नुहुन्छ।')}</p></noscript>
    <section class="korea-next-steps"><h2>{pick(lang, guide.procedure === 'address' ? 'Before you report' : 'Before you submit', guide.procedure === 'address' ? 'सूचना दिनुअघि' : 'बुझाउनुअघि')}</h2><ol>{steps.map(step => <li>{textFor(lang, step)}</li>)}</ol><a href="https://www.hikorea.go.kr/" target="_blank" rel="noopener noreferrer" class="button secondary">{pick(lang, 'Open HiKorea', 'हाइकोरिया खोल्नुहोस्')} ↗</a> <a href={koreaSources.help.url} target="_blank" rel="noopener noreferrer" class="text-link">{pick(lang, '1345 contact & hours', '१३४५ सम्पर्क र समय')} ↗</a></section>
    </div></div>
  <section id="guide-sources" class="korea-sources"><details><summary>{pick(lang, 'Official sources, review date & coverage', 'आधिकारिक स्रोत, जाँचिएको मिति र दायरा')}</summary><p>{pick(lang, 'Reviewed 6 November 2026. Government sources establish the baseline; university sources illustrate implementation and may have local conditions. Fees, financial thresholds and document validity are deliberately left for case-specific confirmation. Official notices and individual immigration instructions take precedence.', '६ नोभेम्बर २०२६ मा जाँचिएको। सरकारी स्रोतबाट आधारभूत सूची लिइएको छ। विश्वविद्यालयका स्रोतले व्यवहारमा चाहिने थप प्रमाण देखाउँछन्; ती सबै संस्थामा उस्तै नहुन सक्छन्। शुल्क, आर्थिक रकम र प्रमाणपत्रको मान्य अवधि आफ्नो अवस्थाअनुसार बुझ्नुपर्छ। आधिकारिक सूचना र अध्यागमनले तपाईंलाई दिएको निर्देशनअनुसार काम गर्नुहोस्।')}</p><ul>{guide.sources.map(id => <li><a href={koreaSources[id].url} target="_blank" rel="noopener noreferrer">{koreaSources[id].name} ↗</a><p>{textFor(lang, koreaSources[id].note)}</p></li>)}</ul></details></section>
  <KoreaComments lang={lang} slug={guide.slug} visa={guide.visa === 'ALL' ? '' : guide.visa}/>
</div><script>import '../../../../scripts/korea-guide'; import '../../../../scripts/community';</script>
</Layout>
