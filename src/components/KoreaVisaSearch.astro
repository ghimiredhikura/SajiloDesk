---
import { pick,type Lang } from '../lib/catalog';
interface Props {lang:Lang; id:string; target?:boolean; task?:boolean}
const {lang,id,target=false,task=false}=Astro.props;
---
<div class="korea-visa-search" data-visa-search data-search-kind={task?'task':'visa'} hidden>
  <div class="visa-search-input"><input id={`${id}-search`} type="text" role="combobox" aria-label={pick(lang,task?'Search tasks':target?'Search target visa':'Search current visa',task?'गर्ने काम खोज्नुहोस्':target?'चाहिएको भिसा खोज्नुहोस्':'हालको भिसा खोज्नुहोस्')} aria-autocomplete="list" aria-expanded="false" aria-controls={`${id}-results`} aria-describedby={`${id}-search-help`} autocomplete="off" spellcheck="false" placeholder={task?pick(lang,'Type to find a task…','गर्ने काम खोज्नुहोस्…'):target?pick(lang,'Search a target status…','चाहिएको भिसा खोज्नुहोस्…'):pick(lang,'Type D2, E9 or a name…','D2, E9 वा नाम लेख्नुहोस्…')}/><button type="button" aria-label={pick(lang,task?'Show tasks without keyboard':'Show visas without keyboard',task?'किबोर्डबिना कामको सूची खोल्नुहोस्':'किबोर्डबिना भिसाको सूची खोल्नुहोस्')} aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-results`}>▾</button></div>
  <span id={`${id}-search-help`} class="sr-only">{pick(lang,'Left half: type to search. Right half: browse choices without the keyboard.','बायाँ आधा भागमा थिचेर टाइप गर्नुहोस्। दायाँ आधा भागमा थिचेर किबोर्डबिना सूची खोल्नुहोस्।')}</span>
  <div class="visa-search-results" id={`${id}-results`} role="listbox" tabindex="-1" aria-label={pick(lang,task?'Matching tasks':'Matching visa types',task?'मिल्ने काम':'मिल्ने भिसाका प्रकार')} hidden></div>
  <p data-search-empty role="status" hidden></p>
</div>
