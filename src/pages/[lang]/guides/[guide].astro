---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { langs,pick,route } from '../../../lib/catalog';
export function getStaticPaths(){return ['application-prep','photo-size','nepali-dates'].flatMap(guide=>langs.map(lang=>({params:{lang,guide},props:{lang,guide}})));}
const {lang,guide}=Astro.props;
const titles:Record<string,[string,string]>={'application-prep':['Get ready for an online form','अनलाइन फारामको तयारी'],'photo-size':['Pixels, KB and a photo that fits','फोटोको साइज: पिक्सेल र KB'],'nepali-dates':['Two calendars, without the confusion','नेपाली र अंग्रेजी मिति बुझौँ']};
const title=pick(lang,...titles[guide]);
---
<Layout lang={lang} active="guides" title={title} description={pick(lang,'A practical Sajilo Desk guide with working tools and clear explanations.','दैनिक कामका लागि सजिलो भाषामा जानकारी र काम लाग्ने उपकरण।')}><div class="container"><nav class="breadcrumbs"><a href={route(lang,'guides')}>{pick(lang,'Guides','उपयोगी जानकारी')}</a><Icon name="chevron" size={12}/><span>{title}</span></nav><article class="prose"><div class="page-heading"><p class="eyebrow">{pick(lang,'A SAJILO DESK GUIDE','सजिलो डेस्कबाट काम लाग्ने जानकारी')}</p><h1>{title}</h1><p>{pick(lang,'By Deepak Ghimire · Reviewed 4 November 2026','दीपक घिमिरे · समीक्षा: ४ नोभेम्बर २०२६')}</p></div>
{guide==='application-prep' && <><p>{pick(lang,'Before opening a long application form, prepare the dates and files you will need. This is a general preparation checklist; the instructions on your actual application remain the source of truth.','फाराम भर्न थाल्नुअघि चाहिने मिति र फाइल तयार राख्दा काम सजिलो हुन्छ। तलका चरणले सामान्य तयारीमा सघाउँछन्। आफूले भर्ने फाराममा दिइएको निर्देशन भने छुट्टै हेर्नुहोस्।')}</p><section class="guide-step"><h2>{pick(lang,'01 / Read the form’s requirements','०१ / फाराममा के मागिएको छ, हेर्नुहोस्')}</h2><p>{pick(lang,'Find the official application page. Note which calendar it asks for, the deadline and time zone, accepted image formats, pixel dimensions and maximum file size. Do not assume every application uses the same photo rules.','सम्बन्धित निकायको आधिकारिक आवेदन पृष्ठ खोल्नुहोस्। नेपाली वा अंग्रेजी कुन मिति चाहिन्छ, आवेदनको अन्तिम मिति र समय कुन हो, फोटोको प्रकार, चौडाइ–उचाइ र अधिकतम फाइल साइज कति हो, टिप्नुहोस्। फोटोको नियम फारामअनुसार फरक हुन सक्छ।')}</p></section><section class="guide-step"><h2>{pick(lang,'02 / Convert the birth date','०२ / जन्ममिति परिवर्तन गर्नुहोस्')}</h2><p>{pick(lang,'If the document uses Bikram Sambat and the form asks for Gregorian, enter the original BS year, month and day. Copy the labeled result. Check that the day and month have not been reversed.','कागजातमा नेपाली मिति छ र फारामले अंग्रेजी मिति मागेको छ भने कागजातकै वर्ष, महिना र गते राखेर बदल्नुहोस्। नतिजा कपी गर्दा वि.सं. वा ई.सं. कुन हो भन्ने पनि खुलाउनुहोस्। गते र महिनाको क्रम उल्टिएको छैन कि जाँच्नुहोस्।')}</p><a class="button secondary" href={route(lang,'tools/date-converter')}>{pick(lang,'Open date converter','मिति बदल्ने उपकरण खोल्नुहोस्')}<Icon name="arrow" size={16}/></a></section><section class="guide-step"><h2>{pick(lang,'03 / Check age at the actual cutoff','०३ / तोकिएको दिनसम्मको उमेर निकाल्नुहोस्')}</h2><p>{pick(lang,'Use the date named in the application notice, which may differ from today or the submission deadline. Our age result uses the Gregorian calendar after any BS conversion. Check the authority’s own rule if eligibility depends on leap-day or month-end treatment.','आवेदन सूचनामा जुन दिनसम्मको उमेर मागिएको छ, त्यही मिति राख्नुहोस्। यो आजको मिति वा फाराम बुझाउने अन्तिम मितिभन्दा फरक हुन सक्छ। यहाँ उमेर निकाल्दा दुवै मिति अंग्रेजी पात्रोमा मिलाइन्छन्। २९ फेब्रुअरी वा महिनाको अन्तिम दिनमा जन्मेकाको हकमा सम्बन्धित निकायको नियम पनि हेर्नुहोस्।')}</p><a class="button secondary" href={route(lang,'tools/age-calculator')}>{pick(lang,'Open age calculator','उमेर निकाल्ने उपकरण खोल्नुहोस्')}<Icon name="arrow" size={16}/></a></section><section class="guide-step"><h2>{pick(lang,'04 / Make a photo that meets the form','०४ / फाराममा मिल्ने फोटो तयार पार्नुहोस्')}</h2><p>{pick(lang,'Choose the required dimensions and format. Add a file-size target if there is a limit. Preview the result: facial detail, text and edges should remain legible. Download the copy and verify its actual byte size.','फाराममा मागिएको चौडाइ, उचाइ र फाइलको प्रकार छान्नुहोस्। फाइल कति KB भित्र चाहिन्छ भन्ने सीमा छ भने त्यो पनि राख्नुहोस्। तयार भएको फोटोमा अनुहार र अक्षर स्पष्ट छन् कि हेर्नुहोस्। डाउनलोड गरेपछि फाइल खोलेर साइज पनि जाँच्नुहोस्।')}</p><a class="button secondary" href={route(lang,'tools/photo-resizer')}>{pick(lang,'Open photo resizer','फोटो मिलाउने उपकरण खोल्नुहोस्')}<Icon name="arrow" size={16}/></a></section><h2>{pick(lang,'A final check before you submit','बुझाउनुअघि अन्तिम जाँच')}</h2><ul><li>{pick(lang,'Compare each value against your source document.','हरेक विवरण मूल कागजातसँग दाँज्नुहोस्।')}</li><li>{pick(lang,'Open the downloaded file, rather than relying only on the preview.','पृष्ठमा देखिएको फोटो मात्र नहेरी डाउनलोड गरेको फाइल पनि खोलेर जाँच्नुहोस्।')}</li><li>{pick(lang,'Return to the official form to upload, review and submit. Sajilo Desk does not submit on your behalf.','फोटो अपलोड गर्न, विवरण जाँच्न र आवेदन बुझाउन सम्बन्धित निकायको फाराममै फर्कनुहोस्। सजिलो डेस्कबाट आवेदन बुझाइँदैन।')}</li></ul><p class="info-note">{pick(lang,'Passport-specific upload presets are intentionally unavailable while official instructions differ. Consult the current Department of Passports route that applies to you.','राहदानीको फोटोका नियम प्रक्रियाअनुसार फरक हुन सक्छन्। त्यसैले यहाँ राहदानीका लागि भनेर तयार सेटिङ राखिएको छैन। आफूले अपनाउने प्रक्रियाका लागि राहदानी विभागको हालको निर्देशन हेर्नुहोस्।')}</p><p><a href="https://nepalpassport.gov.np/">{pick(lang,'Department of Passports — official site','राहदानी विभाग — आधिकारिक वेबसाइट')} ↗</a></p></>}
{guide==='photo-size' && <><p>{pick(lang,'A photo can be the right width and height but still too large to upload. Pixel dimensions and file size measure different things. Start with the rule on the form, then adjust the right setting.','फोटोको चौडाइ र उचाइ ठिक्क भए पनि फाइल धेरै ठूलो भएर अपलोड नहुन सक्छ। पिक्सेलले फोटोको चौडाइ र उचाइ जनाउँछ; KB ले फाइलको साइज। फाराममा के मागिएको छ हेरेर दुवै मिलाउनुहोस्।')}</p><h2>{pick(lang,'Pixels describe the picture','पिक्सेल: फोटोको चौडाइ र उचाइ')}</h2><p>{pick(lang,'A 600 × 800 px photo is 600 pixels wide and 800 pixels high. That is a portrait shape. Keeping the aspect ratio prevents stretching; center crop cuts the edges to fit an exact shape. Our Fit mode keeps the whole photo within your dimensions and never enlarges it.','६०० × ८०० px भनेको ६०० पिक्सेल चौडा र ८०० पिक्सेल अग्लो फोटो हो। चौडाइ र उचाइको अनुपात कायम राख्दा फोटो तन्किएर बिग्रिँदैन। ‘पूरै फोटो अटाउने’ विकल्पले कुनै भाग नकाटी तोकिएको आकारभित्र राख्छ र मूलभन्दा ठूलो बनाउँदैन। ‘बीचको भाग राख्ने’ विकल्पले भने चाहिएको आकारमा अटाउन किनारा काट्छ।')}</p><h2>{pick(lang,'KB describes the file','KB: फाइलको साइज')}</h2><p>{pick(lang,'Sajilo Desk uses decimal KB: 1 KB = 1,000 bytes. Some systems use KiB, where 1 KiB = 1,024 bytes. We show actual bytes as well, so you can check a strict limit. A more detailed photo often needs more bytes than a plain background at the same dimensions.','सजिलो डेस्कमा १ KB बराबर १,००० बाइट मानिन्छ। कतिपय प्रणालीमा १ KiB बराबर १,०२४ बाइट हुन्छ। ठ्याक्कै सीमा जाँच्न मिलोस् भनेर फाइलको बाइट पनि देखाइन्छ। चौडाइ र उचाइ बराबर भए पनि फोटोमा धेरै विवरण छ भने फाइल ठूलो हुन सक्छ।')}</p><h2>{pick(lang,'Choose the right format','फाइलको प्रकार छान्नुहोस्')}</h2><ul><li>{pick(lang,'JPEG is often useful for photos. Lower quality reduces size but can blur text and edges. Transparent areas become white.','फोटोका लागि JPEG प्रायः उपयोगी हुन्छ। गुणस्तर घटाउँदा फाइल सानो हुन्छ, तर अक्षर र किनारा धमिला हुन सक्छन्। पारदर्शी भाग भने सेतो बन्छ।')}</li><li>{pick(lang,'PNG preserves sharp text and transparency. The quality slider cannot compress it further. Reduce dimensions or choose another accepted format.','PNG ले अक्षर स्पष्ट राख्छ र पारदर्शी भाग पनि जोगाउँछ। गुणस्तर घटाउने सेटिङले यसको साइज घट्दैन। फाइल सानो बनाउन चौडाइ–उचाइ घटाउनुहोस् वा फारामले स्वीकार्ने अर्को प्रकार छान्नुहोस्।')}</li><li>{pick(lang,'WebP can produce small photo files, but only use it if the destination accepts WebP.','WebP मा फोटोको फाइल सानो बन्न सक्छ। तर अपलोड गर्ने वेबसाइटले यो प्रकार स्वीकार्छ भने मात्र प्रयोग गर्नुहोस्।')}</li></ul><h2>{pick(lang,'When the target cannot be reached','तोकिएको KB भित्र नअटाएमा')}</h2><p>{pick(lang,'We show the achievable result instead of claiming success. Try reducing both dimensions by 25%, then preview again. Never trade away legibility just to meet a byte limit; use the official support channel if a readable file cannot meet the requirement.','फाइल तोकिएको KB भित्र नअटाएमा बनेको वास्तविक साइज देखाइन्छ। चौडाइ र उचाइ २५% घटाएर फेरि हेर्न सक्नुहुन्छ। साइज घटाउँदा फोटो वा अक्षर अस्पष्ट भयो भने त्यसलाई प्रयोग नगर्नुहोस्। स्पष्ट फोटो राखेर पनि नियम पूरा गर्न नसके सम्बन्धित निकायसँग सहयोग माग्नुहोस्।')}</p><a class="button primary" href={route(lang,'tools/photo-resizer')} style="color:white;text-decoration:none">{pick(lang,'Prepare a photo','फोटो तयार पार्नुहोस्')}<Icon name="arrow" size={17}/></a></>}
{guide==='nepali-dates' && <><p>{pick(lang,'Bikram Sambat (BS / वि.सं.) and Gregorian (AD / ई.सं.) label the same day differently. Many Nepali documents use BS, while international forms ask for Gregorian. Always identify the calendar before copying a date.','एउटै दिनको नेपाली र अंग्रेजी मिति फरक हुन्छ। नेपालका धेरै कागजातमा विक्रम संवत् (वि.सं.) प्रयोग हुन्छ। विदेशका वा अन्तर्राष्ट्रिय फाराममा भने अंग्रेजी मिति (ई.सं.) मागिन सक्छ। त्यसैले मिति राख्नुअघि कुन पात्रोको मिति चाहिएको हो, हेर्नुहोस्।')}</p><h2>{pick(lang,'Why “add 57 years” does not work','वर्षमा ५७ थपघट गरेर मात्र किन मिल्दैन?')}</h2><p>{pick(lang,'BS years start around mid-April, not on 1 January. Month lengths vary by BS year. A correct conversion needs a month-length table and an anchor date, not a fixed year or day offset.','नेपाली नयाँ वर्ष अप्रिलको मध्यतिर पर्छ। नेपाली महिनामा कति दिन हुन्छ भन्ने पनि वर्षअनुसार फरक हुन्छ। त्यसैले वर्षमा ५७ थप्दै वा घटाउँदैमा सही मिति आउँदैन। ठ्याक्कै मिति निकाल्न प्रत्येक महिनाको दिनसङ्ख्याको तालिका र थाहा भएको एउटा आधार मिति चाहिन्छ।')}</p><div class="prose-card"><h3 style="margin-top:0">{pick(lang,'A checkable example','जाँच्न मिल्ने उदाहरण')}</h3><p><strong>२०८२ वैशाख १ वि.सं. = 14 April 2025 AD</strong></p><p>{pick(lang,'This date pair is published in the Nepal Embassy’s holiday list.','यी नेपाली र अंग्रेजी मिति नेपाली दूतावासले प्रकाशित गरेको बिदा सूचीमा पनि हेर्न सकिन्छ।')} <a href="https://ae.nepalembassy.gov.np/pages/holidays-16/">{pick(lang,'See the source','स्रोत हेर्नुहोस्')} ↗</a></p></div><h2>{pick(lang,'Make the order explicit','वर्ष, महिना र गतेको क्रम खुलाउनुहोस्')}</h2><p>{pick(lang,'Use separate year, month and day fields. In a numeric result such as 2082-01-01, our order is year-month-day. “04/05” alone can mean 4 May or 5 April in different countries. Keep the calendar label with the copied value.','यहाँ वर्ष, महिना र गते छुट्टाछुट्टै राखिन्छ। २०८२-०१-०१ जस्तो नतिजामा क्रम वर्ष–महिना–गते हुन्छ। “०४/०५” मात्र लेख्दा देशअनुसार ४ मे वा ५ अप्रिल बुझिन सक्छ। मिति कपी गर्दा वि.सं. वा ई.सं. कुन हो भन्ने पनि खुलाउनुहोस्।')}</p><h2>{pick(lang,'Know the supported range','कुन अवधिका मिति बदल्न मिल्छ?')}</h2><p>{pick(lang,'Our bundled table covers BS 1975-01-01 through 2099-12-30, or AD 1918-04-13 through 2043-04-13. Outside it, the tool returns an error rather than an estimate. Future BS dates follow the versioned table and should be checked against the published calendar for the year.','यहाँ वि.सं. १९७५-०१-०१ देखि २०९९-१२-३० (ई.सं. १९१८-०४-१३ देखि २०४३-०४-१३) सम्मको तालिका छ। यसबाहिरका मिति राखेमा अनुमानित नतिजा दिइँदैन। भविष्यको मिति प्रयोग गर्दा त्यस वर्षको प्रकाशित पात्रोसँग पनि जाँच्नुहोस्।')}</p><a class="button primary" href={route(lang,'tools/date-converter')} style="color:white;text-decoration:none">{pick(lang,'Convert a date','मिति परिवर्तन गर्नुहोस्')}<Icon name="arrow" size={17}/></a><p class="mt-20"><a href={route(lang,'methodology')}>{pick(lang,'Read the calculation methods and sources','मिति निकाल्ने विधि र स्रोत पढ्नुहोस्')}</a></p></>}
</article></div></Layout>
