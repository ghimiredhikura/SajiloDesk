---
import Layout from '../../layouts/Layout.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import { langs,pick } from '../../lib/catalog';
export function getStaticPaths(){return langs.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props;
---
<Layout lang={lang} title={pick(lang,'My saved tools','मनपर्ने उपकरण')} description={pick(lang,'Keep your most-used Sajilo Desk tools together on this device.','धेरै चलाउने उपकरणलाई मनपर्नेमा राखेर सजिलै भेट्नुहोस्।')} active="saved" noindex><div class="container page-content"><div class="page-heading"><p class="eyebrow">{pick(lang,'YOUR OWN LITTLE WORKSPACE','आफूलाई चाहिने उपकरण एकै ठाउँमा')}</p><h1>{pick(lang,'My tools','मेरा उपकरण')}</h1><p>{pick(lang,'The tools you reach for, right where you need them. Hearts are saved on this device only.','मुटु चिन्ह थिचेर छानेका उपकरण यहाँ देखिन्छन्। यो सूची यही ब्राउजरमा मात्र रहन्छ।')}</p></div><ToolGrid lang={lang} saved/><noscript><p>{pick(lang,'Enable JavaScript to view tools saved on this device.','मनपर्नेमा राखेका उपकरण हेर्न ब्राउजरको JavaScript चालु गर्नुहोस्।')}</p></noscript></div></Layout>
