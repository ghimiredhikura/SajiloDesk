---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Icon from '../../../components/Icon.astro';
import { langs, pick } from '../../../lib/catalog';
export function getStaticPaths(){return langs.map(lang => ({params:{lang},props:{lang}}));}
const { lang } = Astro.props;
const instructions: [string,string][] = [[pick(lang,'Pick a land system','जग्गाको एकाइ छान्नुहोस्'),pick(lang,'Use hill units, Terai units, or a decimal area.','पहाडी, तराईका एकाइ वा दशमलव क्षेत्रफल छान्नुहोस्।')],[pick(lang,'Enter your measurement','नाप राख्नुहोस्'),pick(lang,'For example, 1 ropani, 2 aana, 0 paisa and 0 daam.','उदाहरणका लागि १ रोपनी, २ आना, ० पैसा र ० दाम।')],[pick(lang,'See all equivalents','सबै एकाइमा हेर्नुहोस्'),pick(lang,'Compare the compound units, square feet and square metres.','मिश्रित एकाइ, वर्ग फिट र वर्ग मिटर तुलना गर्नुहोस्।')]];
const units = [['ropani','Ropani','रोपनी'],['aana','Aana','आना'],['paisa','Paisa','पैसा'],['daam','Daam','दाम'],['bigha','Bigha','बिघा'],['kattha','Kattha','कठ्ठा'],['dhur','Dhur','धुर'],['sqft','Square feet','वर्ग फिट'],['sqm','Square metres','वर्ग मिटर']];
---
<ToolLayout lang={lang} id="land-converter" related="date-converter" instructions={instructions}>
  <div class="tool-workspace"><form class="panel" id="land-form" novalidate><div class="panel-heading"><h2>{pick(lang,'Your land measurement','जग्गाको नाप')}</h2><span class="panel-kicker">{pick(lang,'1 ROPANI EXAMPLE','१ रोपनीको उदाहरण')}</span></div><div class="field"><label for="land-system">{pick(lang,'Input format','नापको प्रकार')}</label><select id="land-system"><option value="ropani">{pick(lang,'Ropani – Aana – Paisa – Daam','रोपनी – आना – पैसा – दाम')}</option><option value="bigha">{pick(lang,'Bigha – Kattha – Dhur','बिघा – कठ्ठा – धुर')}</option><option value="decimal">{pick(lang,'Single unit (decimal)','एउटै एकाइ (दशमलव)')}</option></select></div><div id="ropani-fields" class="field-row two">{units.slice(0,4).map(([id,en,ne])=><div class="field"><label for={`land-${id}`}>{pick(lang,en,ne)}</label><input id={`land-${id}`} inputmode="decimal" type="text" autocomplete="off" value={id==='ropani'?'1':'0'} maxlength="18"/></div>)}</div><div id="bigha-fields" class="field-row" hidden>{units.slice(4,7).map(([id,en,ne])=><div class="field"><label for={`land-${id}`}>{pick(lang,en,ne)}</label><input id={`land-${id}`} inputmode="decimal" type="text" autocomplete="off" value={id==='bigha'?'1':'0'} maxlength="18"/></div>)}</div><div id="decimal-fields" class="field-row two" hidden><div class="field"><label for="land-value">{pick(lang,'Area','क्षेत्रफल')}</label><input id="land-value" inputmode="decimal" type="text" autocomplete="off" value="1" maxlength="18"/></div><div class="field"><label for="land-unit">{pick(lang,'Unit','एकाइ')}</label><select id="land-unit">{units.map(([id,en,ne])=><option value={id}>{pick(lang,en,ne)}</option>)}</select></div></div><p class="field-help">{pick(lang,'Nepal convention · Nepali or Latin digits · Use . for decimals','नेपालको प्रचलित नाप · नेपाली वा अंग्रेजी अंक · दशमलवका लागि .')}</p><div id="form-error" class="error-box" role="alert" tabindex="-1" hidden></div><div class="panel-actions"><button class="button primary" type="submit">{pick(lang,'Convert area','क्षेत्रफल परिवर्तन गर्नुहोस्')}<Icon name="arrow" size={18}/></button><button class="button secondary" type="button" id="land-reset">{pick(lang,'Reset','खाली गर्नुहोस्')}</button></div><p class="privacy-note"><Icon name="shield" size={14}/>{pick(lang,'A local calculation. No records are looked up or uploaded.','यहीँ गणना हुन्छ। कुनै अभिलेख खोजिँदैन वा अपलोड हुँदैन।')}</p></form><section class="panel result-panel" aria-live="polite" aria-atomic="true"><div class="panel-heading"><h2>{pick(lang,'One area, every unit','एउटै क्षेत्रफल, सबै एकाइ')}</h2></div><div id="result-empty" class="result-empty"><span><Icon name="land" size={26}/></span><p>{pick(lang,'Your converted measurements will appear here.','परिवर्तन भएका नाप यहाँ देखिन्छन्।')}</p></div><div id="land-result" hidden><div class="land-results"><div class="land-result-row"><span>{pick(lang,'Ropani – Aana – Paisa – Daam','रोपनी – आना – पैसा – दाम')}</span><strong id="land-ropani-result"></strong><span id="land-ropani-decimal"></span></div><div class="land-result-row"><span>{pick(lang,'Bigha – Kattha – Dhur','बिघा – कठ्ठा – धुर')}</span><strong id="land-bigha-result"></strong><span id="land-bigha-decimal"></span></div><div class="land-result-row"><span>{pick(lang,'Square feet','वर्ग फिट')}</span><strong id="land-sqft-result"></strong></div><div class="land-result-row"><span>{pick(lang,'Square metres','वर्ग मिटर')}</span><strong id="land-sqm-result"></strong></div></div><button class="button full-width" type="button" id="copy-land"><Icon name="copy" size={17}/>{pick(lang,'Copy all measurements','सबै नाप कपी गर्नुहोस्')}</button><p class="result-meta">{pick(lang,'Displayed to 4 decimal places. Calculations keep full precision.','नतिजामा ४ दशमलवसम्म देखाइन्छ। गणनामा पूरा शुद्धता राखिन्छ।')}</p></div></section></div>
  <Fragment slot="method"><p>{pick(lang,'Uses Nepal’s hill and Terai conventions: 1 ropani = 16 aana = 64 paisa = 256 daam = 5,476 ft². 1 bigha = 20 kattha = 400 dhur = 72,900 ft². 1 ft² = 0.09290304 m². Bigha sizes in other countries can differ.','नेपालको पहाडी र तराईको प्रचलन: १ रोपनी = १६ आना = ६४ पैसा = २५६ दाम = ५,४७६ वर्ग फिट। १ बिघा = २० कठ्ठा = ४०० धुर = ७२,९०० वर्ग फिट। १ वर्ग फिट = ०.०९२९०३०४ वर्ग मिटर। अरू देशको बिघा फरक हुन सक्छ।')}</p><p>{pick(lang,'The official square-foot factors are used consistently; rounded metric figures in documents can differ slightly. This is an area conversion, not a land-record or boundary verification. Reviewed 4 November 2026.','वर्ग फिटका आधिकारिक गुणक निरन्तर प्रयोग हुन्छन्। कागजातका गोलाइएका मेट्रिक अंक थोरै फरक हुन सक्छन्। यो क्षेत्रफल परिवर्तन हो, जग्गाको अभिलेख वा सिमाना प्रमाणीकरण होइन। समीक्षा: ४ नोभेम्बर २०२६।')}</p><a href="https://giwmscdnone.gov.np/media/app/public/54/posts/1711001516_6.pdf" target="_blank" rel="noopener noreferrer">{pick(lang,'Government land-unit reference (PDF)','सरकारी नापको सन्दर्भ (PDF)')} ↗</a></Fragment>
  <script>import '../../../scripts/land-tool';</script>
</ToolLayout>
