---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import KoreaJourneyPicker from '../../../components/KoreaJourneyPicker.astro';
import KoreaEligibility from '../../../components/KoreaEligibility.astro';
import { visaOptions } from '../../../lib/korea-catalog';
import KoreaBrand from '../../../components/KoreaBrand.astro';
import { langs, pick, route } from '../../../lib/catalog';
import { reviewed, koreaTasks, textFor, koreaSources } from '../../../lib/korea';
export function getStaticPaths() { return langs.map(lang => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props;
---
<Layout lang={lang} active="abroad" title={pick(lang, 'SajiloDesk Korea · Visa and document guides', 'SajiloDesk Korea · भिसा र कागजातको जानकारी')} description={pick(lang, 'Korea visa eligibility and document guides for Nepali nationals: F-5 subcategories, income criteria, extensions, status changes, work, study and family. Official sources and review dates.', 'कोरियामा नेपाली नागरिकका लागि भिसाको योग्यता र कागजात। F-5 उपप्रकार, आयका सर्त, म्याद, भिसा परिवर्तन, काम, पढाइ र परिवारबारे आधिकारिक स्रोत र जाँचिएको मितिसहित।')}>
  <div class="container abroad-hub"><div class="abroad-heading"><KoreaBrand/><h1>{pick(lang, 'Life in Korea, made sajilo.', 'कोरियाको दैनिकी, अझ सजिलो।')}</h1><p>{pick(lang, 'Visa and document guides for Nepali nationals.', 'नेपाली नागरिकका लागि भिसा र कागजातको जानकारी।')}</p></div>
  <section id="korea" aria-labelledby="korea-heading"><div class="abroad-section-title"><span class="abroad-country" aria-hidden="true"><Icon name="book" size={23}/></span><div><h2 id="korea-heading">{pick(lang, 'Get your documents ready.', 'कागजातको तयारी गरौँ।')}</h2></div></div>
    <KoreaJourneyPicker lang={lang}/>
    <KoreaEligibility lang={lang}/>
    <details class="korea-coverage"><summary>{pick(lang,`${visaOptions.length} visa choices · 21 tasks · coverage`,`${visaOptions.length} भिसा छनोट · २१ काम · समेटिएको जानकारी`)}</summary><p>{pick(lang,'Verified choices for Nepali nationals, including separate F-5 routes and common study, work, residence and family subtypes. Unlisted specialist subcodes use the parent family. Eligibility summaries and document guides are separate; a menu entry does not establish eligibility.','नेपाली नागरिकका लागि जाँचिएका भिसा, छुट्टाछुट्टै F-5 आधार र प्रचलित अध्ययन, काम, बसोबास तथा पारिवारिक उपप्रकार। छुटेका विशेष उपप्रकारमा मूल वर्ग छान्नुहोस्। योग्यता र कागजातको जानकारी छुट्टै छन्; सूचीमा देखिँदैमा योग्यता पुगेको हुँदैन।')}</p><ul>{koreaTasks.map(task=><li>{textFor(lang,task.name)}</li>)}</ul><a href={koreaSources.manual.url} target="_blank" rel="noopener noreferrer">{pick(lang,'Official manual · 6 November 2026','आधिकारिक निर्देशिका · ६ नोभेम्बर २०२६')} ↗</a></details>
    <div class="abroad-explainer"><div><Icon name="book" size={22}/><h3>{pick(lang, 'Understand each document', 'कागजात बुझ्नुहोस्')}</h3><p>{pick(lang, 'Korean names, issuers and official forms, explained simply.', 'कोरियाली नाम, कागजात पाइने ठाउँ र आधिकारिक फाराम, सरल भाषामा।')}</p></div><div><Icon name="check" size={22}/><h3>{pick(lang, 'Keep track of your preparation', 'तयारीको हिसाब राख्नुहोस्')}</h3><p>{pick(lang, 'Tick, save or download your checklist. No document uploads.', 'तयार कागजातमा चिनो लगाउनुहोस्। सूची सेभ वा डाउनलोड गर्नुहोस्। कागजात अपलोड गर्नुपर्दैन।')}</p></div></div>
    <p class="abroad-review">{pick(lang, 'Sources checked', 'स्रोत जाँचिएको मिति')}: <time datetime={reviewed}>{pick(lang, '7 November 2026', '७ नोभेम्बर २०२६')}</time>. {pick(lang, 'Confirm your case with HiKorea / 1345.', 'आफ्नो अवस्थाबारे हाइकोरिया/१३४५ मा बुझ्नुहोस्।')}</p>
  </section>
  <section class="abroad-next"><h2>{pick(lang, 'Need another guide?', 'अर्को जानकारी चाहियो?')}</h2><p>{pick(lang, 'Suggest a visa, procedure or country in a guide’s comments, or send us a suggestion.', 'भिसा, प्रक्रिया वा अर्को देशको जानकारी सुझाउनुहोस्। टिप्पणी लेख्नुहोस् वा हामीलाई पठाउनुहोस्।')}</p><a class="text-link" href={route(lang, 'contact')}>{pick(lang, 'Suggest a service', 'सुझाव पठाउनुहोस्')} →</a></section></div>
</Layout>
