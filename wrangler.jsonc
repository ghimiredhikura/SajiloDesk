{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sajilodesk",
  "main": "scripts/community-worker.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["17 19 * * *"] },
  "routes": [
    { "pattern": "sajilodesk.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [{
    "binding": "COMMUNITY_DB",
    "database_name": "sajilodesk-community",
    "database_id": "75c83f28-8e79-4547-9550-5708f08d690b"
  }]
}
