---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { langs,pick,route } from '../../../lib/catalog';
export function getStaticPaths(){return langs.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props;
const guides=[['application-prep','spark','coral','Get ready for an online form','अनलाइन फारामको तयारी','Dates, cutoff age and a photo: connect the small tasks before you apply.','फाराम भर्नुअघि मिति, तोकिएको दिनको उमेर र फोटो तयार पार्नुहोस्।'],['photo-size','image','green','Pixels, KB and a photo that fits','फोटोको साइज: पिक्सेल र KB','Understand dimensions and file size, then choose a readable output.','फोटोको चौडाइ–उचाइ र फाइलको साइज फरक कुरा हुन्। दुवै कसरी मिलाउने, जान्नुहोस्।'],['nepali-dates','calendar','blue','Two calendars, without the confusion','नेपाली र अंग्रेजी मिति बुझौँ','When to use BS or AD, and why adding 57 years is not a conversion.','कुन मिति कहाँ चाहिन्छ? वर्षमा ५७ थपघट गरेर मात्र किन मिल्दैन?']];
---
<Layout lang={lang} active="guides" title={pick(lang,'Practical guides','काम लाग्ने जानकारी')} description={pick(lang,'Simple guides to application preparation, photo size and Nepali date conversion.','फारामको तयारी, फोटोको साइज र नेपाली–अंग्रेजी मितिबारे सजिलो भाषामा जानकारी।')}><div class="container page-content"><div class="page-heading"><p class="eyebrow">{pick(lang,'A LITTLE GUIDANCE GOES A LONG WAY','बुझेर गर्दा काम सजिलो')}</p><h1>{pick(lang,'Less figuring out. More done.','कामअघि थोरै जानकारी।')}</h1><p>{pick(lang,'Short, practical guides to help you get a useful result.','दैनिक काममा सघाउने छोटा र सजिला लेख।')}</p></div><div class="guide-grid">{guides.map(([id,icon,color,en,ne,descEn,descNe])=><a class={`guide-card ${color}`} href={route(lang,`guides/${id}`)}><span class="tool-icon"><Icon name={icon}/></span><h2>{pick(lang,en,ne)}</h2><p>{pick(lang,descEn,descNe)}</p><span class="inline-link">{pick(lang,'Read the guide','लेख पढ्नुहोस्')}<Icon name="arrow" size={17}/></span></a>)}</div></div></Layout>
