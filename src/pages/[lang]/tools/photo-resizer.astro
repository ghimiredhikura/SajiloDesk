---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Icon from '../../../components/Icon.astro';
import { langs, pick } from '../../../lib/catalog';
export function getStaticPaths(){return langs.map(lang => ({params:{lang},props:{lang}}));}
const { lang } = Astro.props;
const instructions: [string,string][] = [[pick(lang,'Choose a photo','फोटो छान्नुहोस्'),pick(lang,'Select a JPEG, PNG or still WebP. Your original is kept intact.','JPEG, PNG वा स्थिर WebP छान्नुहोस्। मूल फोटो सुरक्षित रहन्छ।')],[pick(lang,'Set the size you need','चाहिएको आकार राख्नुहोस्'),pick(lang,'Choose pixels, format and an optional target size in KB.','पिक्सेल, फाइलको प्रकार र चाहिएको KB आकार राख्नुहोस्।')],[pick(lang,'Preview, then save','हेरेर सुरक्षित गर्नुहोस्'),pick(lang,'Check the actual size and legibility before downloading a copy.','डाउनलोड गर्नुअघि वास्तविक आकार र पढ्न मिल्ने गुणस्तर जाँच्नुहोस्।')]];
---
<ToolLayout lang={lang} id="photo-resizer" related="age-calculator" instructions={instructions}>
  <div class="tool-workspace"><form class="panel" id="photo-form" novalidate><div class="panel-heading"><h2>{pick(lang,'Let’s get your photo ready','फोटो तयार पारौँ')}</h2><button type="button" id="photo-example">{pick(lang,'Use example','उदाहरण')}</button></div><label class="upload-zone" id="drop-zone" for="photo-file"><Icon name="upload" size={29}/><strong>{pick(lang,'Choose a photo or drop it here','फोटो छान्नुहोस् वा यहाँ राख्नुहोस्')}</strong><p>{pick(lang,'JPEG, PNG, still WebP · Up to 20 MiB / 24 MP','JPEG, PNG, स्थिर WebP · २० MiB / २४ MP सम्म')}</p><input id="photo-file" type="file" accept="image/jpeg,image/png,image/webp" aria-label={pick(lang,'Choose photo','फोटो छान्नुहोस्')}/></label><p id="photo-status" class="field-help" role="status"></p><div id="original-block" hidden><div class="file-preview"><img id="original-preview" alt={pick(lang,'Original photo preview','मूल फोटोको झलक')}/></div><div class="file-stats"><span id="photo-sample-label" class="sample-label" hidden>{pick(lang,'Example image','उदाहरण चित्र')}</span><span id="original-dimensions"></span><span id="original-size"></span></div></div><fieldset id="photo-controls" class="file-controls" disabled><legend class="sr-only">{pick(lang,'Photo output settings','फोटोको नतिजाको सेटिङ')}</legend><div class="field-row two"><div class="field"><label for="photo-width">{pick(lang,'Width (px)','चौडाइ (px)')}</label><input id="photo-width" inputmode="numeric" type="text" value="800" maxlength="5"/></div><div class="field"><label for="photo-height">{pick(lang,'Height (px)','उचाइ (px)')}</label><input id="photo-height" inputmode="numeric" type="text" value="800" maxlength="5"/></div></div><div class="field-row two"><div class="field"><label for="photo-format">{pick(lang,'Output format','नतिजाको प्रकार')}</label><select id="photo-format"><option value="image/jpeg">JPEG (.jpg)</option><option value="image/png">PNG (.png)</option><option value="image/webp">WebP (.webp)</option></select></div><div class="field"><label for="photo-target">{pick(lang,'Target size (optional)','चाहिएको आकार (ऐच्छिक)')}</label><div class="input-with-unit"><input id="photo-target" inputmode="decimal" type="text" placeholder="200" maxlength="8"/><span>KB</span></div></div></div><details class="photo-advanced"><summary>{pick(lang,'Fit, quality & quick targets','अनुपात, गुणस्तर र छिटो आकार')}</summary><div class="field"><label class="checkbox-label"><input id="lock-ratio" type="checkbox" checked/>{pick(lang,'Keep the original aspect ratio','मूल लम्बाइ–चौडाइको अनुपात राख्नुहोस्')}</label></div><div class="field"><label for="photo-mode">{pick(lang,'How should the photo fit?','फोटो कसरी मिलाउने?')}</label><select id="photo-mode"><option value="fit">{pick(lang,'Fit inside · keep the whole photo','भित्र अटाउने · पूरै फोटो राख्ने')}</option><option value="crop">{pick(lang,'Center crop · exact dimensions','बीचबाट काट्ने · ठ्याक्कै आकार')}</option></select></div><div class="field" id="quality-control"><div class="range-heading"><label for="photo-quality">{pick(lang,'Image quality','फोटोको गुणस्तर')}</label><output id="quality-label" for="photo-quality">85%</output></div><input id="photo-quality" type="range" min="10" max="100" value="85"/><p class="field-help">{pick(lang,'Target size may reduce quality further. Smaller dimensions help too.','चाहिएको आकार पुर्‍याउन गुणस्तर अझ घट्न सक्छ। सानो पिक्सेलले पनि सहयोग गर्छ।')}</p></div><p class="field-help">{pick(lang,'Quick size targets · 1 KB = 1,000 bytes','छिटो आकार छान्नुहोस् · १ KB = १,००० बाइट')}</p><div class="preset-buttons"><button type="button" data-target="50">50 KB</button><button type="button" data-target="100">100 KB</button><button type="button" data-target="200">200 KB</button><button type="button" data-target="500">500 KB</button></div></details></fieldset><div id="photo-error" class="error-box" role="alert" tabindex="-1" hidden></div><div class="panel-actions"><button class="button primary" type="submit" id="process-photo" disabled>{pick(lang,'Resize & preview','आकार मिलाएर हेर्नुहोस्')}<Icon name="arrow" size={18}/></button><button class="button secondary" id="cancel-photo" type="button" hidden>{pick(lang,'Cancel','रद्द गर्नुहोस्')}</button><button class="button ghost" id="clear-photo" type="button" hidden>{pick(lang,'Clear','हटाउनुहोस्')}</button></div><p class="privacy-note"><Icon name="shield" size={14}/>{pick(lang,'No uploads. Your photo is processed entirely on this device.','अपलोड हुँदैन। फोटो पूरै यही यन्त्रमा प्रशोधन हुन्छ।')}</p></form>
    <section class="panel result-panel"><div class="panel-heading"><h2>{pick(lang,'Your new photo','नयाँ फोटो')}</h2><span class="panel-kicker">{pick(lang,'PREVIEW FIRST','पहिले हेर्नुहोस्')}</span></div><div class="result-empty" id="result-empty"><span><Icon name="image" size={27}/></span><p>{pick(lang,'Your photo preview and actual file size will appear here.','फोटोको झलक र वास्तविक फाइलको आकार यहाँ देखिन्छ।')}</p></div><div id="photo-result" hidden><div class="file-preview"><img id="output-preview" alt={pick(lang,'Resized output photo preview','आकार मिलाइएको फोटोको झलक')}/></div><div class="file-stats"><span id="output-dimensions"></span><span id="output-size"></span></div><p class="success-note" id="photo-summary" role="status"></p><p class="info-note" id="target-notice" hidden></p><button class="button full-width" type="button" id="reduce-dimensions" hidden>{pick(lang,'Try 25% smaller dimensions','२५% सानो पिक्सेलमा प्रयास गर्नुहोस्')}</button><button class="button full-width" type="button" id="download-photo"><Icon name="download" size={17}/>{pick(lang,'Download photo','फोटो डाउनलोड गर्नुहोस्')}</button></div><p class="info-note">{pick(lang,'For application photos, follow the dimensions and file rules on the actual form. These are generic size targets, not verified government presets.','आवेदनको फोटोका लागि सम्बन्धित फारामकै आकार र नियम पालना गर्नुहोस्। यी सामान्य आकार हुन्, प्रमाणित सरकारी सेटिङ होइनन्।')}</p></section></div>
  <Fragment slot="method"><p>{pick(lang,'Your browser decodes JPEG, PNG or still WebP with its orientation, then resamples it using Canvas. Fit preserves the whole photo and avoids enlarging it; center crop fills your chosen dimensions. JPEG fills transparent areas with white. Animated WebP is rejected; animated PNG uses its default image only.','ब्राउजरले JPEG, PNG वा स्थिर WebP को दिशा मिलाएर Canvas बाट आकार बदल्छ। भित्र अटाउने विधिले पूरै फोटो राख्छ र ठूलो बनाउँदैन। बीचबाट काट्दा छानिएको आकार भरिन्छ। JPEG मा पारदर्शी भाग सेतो हुन्छ। चल्ने WebP अस्वीकार हुन्छ; चल्ने PNG को मुख्य चित्र मात्र प्रयोग हुन्छ।')}</p><p>{pick(lang,'JPEG/WebP target size is found by trying quality levels from your setting down to 10%. PNG is lossless and ignores quality. If the target is impossible, the actual achievable size is shown with a smaller-dimensions option. Always inspect legibility.','JPEG/WebP को गुणस्तर छानिएको स्तरदेखि १०% सम्म जाँचिन्छ। PNG मा गुणस्तरको असर हुँदैन। चाहिएको आकार असम्भव भए वास्तविक आकार र पिक्सेल घटाउने विकल्प देखिन्छ। अक्षर पढ्न मिल्छ कि जाँच्नुहोस्।')}</p><p>{pick(lang,'Input: up to 20 MiB, 24 megapixels and 12,000 px per side. Output: up to 16 megapixels. Re-encoding does not copy EXIF metadata. Photo contents may still contain identifying details. Close or clear this page to release the selected file.','इनपुट: २० MiB, २४ मेगापिक्सेल र प्रत्येक किनारा १२,००० पिक्सेलसम्म। नतिजा: १६ मेगापिक्सेलसम्म। EXIF मेटाडाटा कपी हुँदैन। फोटोमा देखिने परिचयका विवरण भने रहन सक्छन्। पृष्ठ बन्द गरेर वा हटाएर फाइल खाली गर्नुहोस्।')}</p></Fragment>
  <script>import '../../../scripts/photo-tool';</script>
</ToolLayout>
