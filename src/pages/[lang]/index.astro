---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Mountains from '../../components/Mountains.astro';
import ToolSearch from '../../components/ToolSearch.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import { langs, pick, route } from '../../lib/catalog';
export function getStaticPaths() { return langs.map(lang => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props;
---
<Layout lang={lang} active="home" title={pick(lang, 'Free everyday tools for Nepal', 'नेपालका लागि निःशुल्क दैनिक उपकरण')} description={pick(lang, 'Convert BS and AD dates, calculate age, convert Preeti text, resize photos and convert Nepal land units. Free, bilingual tools that work in your browser.', 'मिति परिवर्तन, उमेर गणना, प्रीतिबाट युनिकोड, फोटोको आकार र जग्गाको क्षेत्रफल। निःशुल्क नेपाली र अंग्रेजी उपकरण।')}>
  <div class="container">
    <section class="home-hero"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span>{pick(lang, 'YOUR EVERYDAY DIGITAL DESK', 'तपाईंको दैनिक डिजिटल साथी')}</p><h1>{pick(lang, 'A little less hassle.', 'झन्झट कम।')}<br/><span>{pick(lang, 'A lot more sajilo.', 'काम अझ सजिलो।')}</span></h1><p class="hero-description">{pick(lang, 'Useful tools for life in Nepal, and wherever life takes you.', 'नेपालमा होस् वा विदेशमा, हरेक दिनको काममा उपयोगी उपकरण।')}<br class="desktop-only"/>{' '}{pick(lang, 'Free to use. Simple by design. Yours in a click.', 'चलाउन सजिलो। सधैँ निःशुल्क। एक क्लिकमै तयार।')}</p><ToolSearch lang={lang}/></div>
      <aside class="today-card"><div class="today-top"><span><span class="status-dot"></span>{pick(lang, 'TODAY IN NEPAL', 'आजको नेपाली मिति')}</span><span class="today-icon"><Icon name="calendar" size={18}/></span></div><div id="nepal-today"><p class="today-date">{pick(lang, 'Namaste, Nepal.', 'नमस्ते, नेपाल।')}</p><p class="today-ad">{pick(lang, 'Your Nepali date, right here.', 'आजको मिति यहीं हेर्नुहोस्।')}</p></div><div class="today-time"><Icon name="clock" size={13}/><span id="nepal-time">Asia/Kathmandu · UTC +5:45</span></div><Mountains/><a class="today-link" href={route(lang, 'tools/date-converter')}>{pick(lang, 'Convert a date', 'मिति परिवर्तन गर्नुहोस्')}<Icon name="arrow" size={16}/></a></aside>
    </section>
    <section class="home-tools"><div class="section-heading"><div><p class="eyebrow muted">{pick(lang, 'SMALL TOOLS. BIG HELP.', 'साना उपकरण। ठूलो सहयोग।')}</p><h2>{pick(lang, 'What’s on your desk today?', 'आज के काम गर्नुहुन्छ?')}</h2></div><span class="tools-count">{pick(lang, '5 free tools, ready to go', '५ निःशुल्क उपकरण तयार छन्')}</span></div><ToolGrid lang={lang} journey/></section>
    <section class="workflow-banner"><div class="workflow-copy"><span class="pill light"><Icon name="spark" size={14}/>{pick(lang, 'LESS SWITCHING. MORE DOING.', 'कामको तयारी, एकै ठाउँमा।')}</span><h2>{pick(lang, 'Your next application,', 'तपाईंको अर्को आवेदन,')}<br/>{pick(lang, 'a little easier.', 'अझ सजिलो।')}</h2><p>{pick(lang, 'From a birth date to a ready-to-save photo. Keep the little things together, so you can get on with the big ones.', 'जन्ममितिदेखि डाउनलोड गर्न मिल्ने फोटोसम्म। आवेदनका साना तयारी एकै ठाउँमा पूरा गर्नुहोस्।')}</p><a class="button primary" href={route(lang, 'guides/application-prep')}>{pick(lang, 'Prepare for a form', 'फारामको तयारी गर्नुहोस्')}<Icon name="arrow" size={18}/></a></div><div class="workflow-steps"><a href={route(lang, 'tools/date-converter')}><span class="step-number">01</span><span class="step-symbol coral"><Icon name="calendar" size={22}/></span><div><strong>{pick(lang, 'Get your date right', 'सही मिति निकाल्नुहोस्')}</strong><span>{pick(lang, 'Switch between BS and AD', 'वि.सं. र ई.सं. परिवर्तन')}</span></div><Icon name="chevron" size={17}/></a><a href={route(lang, 'tools/age-calculator')}><span class="step-number">02</span><span class="step-symbol blue"><Icon name="cake" size={22}/></span><div><strong>{pick(lang, 'Check your age on the deadline', 'अन्तिम मितिमा उमेर जाँच्नुहोस्')}</strong><span>{pick(lang, 'Know your completed years', 'पूरा भएको उमेर थाहा पाउनुहोस्')}</span></div><Icon name="chevron" size={17}/></a><a href={route(lang, 'tools/photo-resizer')}><span class="step-number">03</span><span class="step-symbol green"><Icon name="crop" size={22}/></span><div><strong>{pick(lang, 'Make your photo fit', 'फोटोको आकार मिलाउनुहोस्')}</strong><span>{pick(lang, 'Resize, preview and download', 'आकार मिलाएर डाउनलोड')}</span></div><Icon name="chevron" size={17}/></a></div></section>
    <section class="trust-row" aria-label={pick(lang, 'Why Sajilo Desk', 'किन सजिलो डेस्क')}><div><span class="trust-icon"><Icon name="shield" size={24}/></span><div><h3>{pick(lang, 'Your files stay yours', 'तपाईंका फाइल तपाईंसँगै')}</h3><p>{pick(lang, 'Photos and text are processed on your device.', 'फोटो र अक्षर तपाईंको यन्त्रमै प्रशोधन हुन्छन्।')}</p></div></div><div><span class="trust-icon"><Icon name="globe" size={24}/></span><div><h3>{pick(lang, 'At home in both languages', 'दुवै भाषामा सजिलो')}</h3><p>{pick(lang, 'Switch between English and नेपाली anytime.', 'जुनसुकै बेला English र नेपाली छान्नुहोस्।')}</p></div></div><div><span class="trust-icon"><Icon name="heart" size={24}/></span><div><h3>{pick(lang, 'Useful first. Always free.', 'उपयोगी र निःशुल्क।')}</h3><p>{pick(lang, 'No sign-up standing between you and done.', 'काम सक्न खाता बनाइरहनु पर्दैन।')}</p></div></div></section>
  </div>
  <script>import '../../scripts/today';</script>
</Layout>
