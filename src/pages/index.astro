---
import Layout from '../layouts/Layout.astro';
import Brand from '../components/Brand.astro';
import { route } from '../lib/catalog';
---
<Layout lang="ne" title="दैनिक काम, अझ सजिलो" description="नेपालमा होस् वा विदेशमा, सबैका दैनिक काम सजिलो बनाउने निःशुल्क उपकरण। नेपाली वा अंग्रेजीमा चलाउनुहोस्।">
  <div class="container root-welcome"><a class="brand" href={route('ne')}><Brand/></a><h1>नमस्ते। Welcome.</h1><p class="mt-20">आफ्नो भाषा छान्नुहोस्। Choose your language.</p><div class="panel-actions"><a class="button primary" href={route('ne')} data-language="ne" lang="ne">नेपालीमा सुरु गर्नुहोस्</a><a class="button secondary" href={route('en')} data-language="en" lang="en">Continue in English</a></div></div>
  <script>
    import { route } from '../lib/catalog';
    let language:'en'|'ne'='ne';
    try { if(localStorage.getItem('sajilo-language')==='en') language='en'; } catch { /* Nepali remains the default when storage is unavailable. */ }
    const welcomeDelay = 3000;
    const redirectTimer = window.setTimeout(() => window.location.replace(route(language)), welcomeDelay);
    const cancelRedirect = () => window.clearTimeout(redirectTimer);
    // Let visitors choose a language or another link without racing the timer.
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(link => {
      link.addEventListener('pointerdown', cancelRedirect, { once: true });
      link.addEventListener('click', cancelRedirect, { once: true });
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(link => {
      link.addEventListener('focus', cancelRedirect, { once: true });
    });
  </script>
</Layout>
