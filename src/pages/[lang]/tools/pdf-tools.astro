---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Icon from '../../../components/Icon.astro';
import { langs,pick } from '../../../lib/catalog';
import '../../../styles/pdf.css';
export function getStaticPaths(){return langs.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props;
const instructions:[string,string][]=[
  [pick(lang,'Choose a task and PDF','काम र PDF छान्नुहोस्'),pick(lang,'Try the example or choose your own PDF. For merging, add two or more files and arrange their order.','नमुना चलाएर हेर्नुहोस् वा आफ्नो PDF छान्नुहोस्। जोड्नका लागि दुई वा बढी फाइल राखेर क्रम मिलाउनुहोस्।')],
  [pick(lang,'Set pages or quality','पाना वा गुणस्तर मिलाउनुहोस्'),pick(lang,'Pages start at 1. Extract a list or range; choose one page for an image. Compression offers text-preserving or image-based modes.','पाना १ बाट गनिन्छ। छुट्याउन पानाको सूची वा दायरा र फोटो बनाउन एउटा पाना छान्नुहोस्। साइज घटाउँदा अक्षर कायम राख्ने वा फोटो बनाउने विकल्प छ।')],
  [pick(lang,'Check and download','जाँचेर डाउनलोड गर्नुहोस्'),pick(lang,'Check the preview and output size, then download a new copy. Your original stays unchanged.','झलक र फाइलको साइज जाँचेर नयाँ प्रति डाउनलोड गर्नुहोस्। मूल फाइल जस्ताको तस्तै रहन्छ।')],
];
---
<ToolLayout lang={lang} id="pdf-tools" related="photo-resizer" instructions={instructions}>
  <div class="tool-workspace pdf-workspace">
    <form class="panel" id="pdf-form" novalidate>
      <div class="panel-heading"><h2>{pick(lang,'What do you need?','के गर्न चाहनुहुन्छ?')}</h2><button type="button" id="pdf-example">{pick(lang,'Use example','नमुना चलाउनुहोस्')}</button></div>
      <div class="pdf-tasks" role="group" aria-label={pick(lang,'PDF task','PDF मा गर्ने काम')}>
        <button type="button" data-pdf-task="extract" aria-pressed="true">{pick(lang,'Extract pages','पाना छुट्याउने')}</button>
        <button type="button" data-pdf-task="merge" aria-pressed="false">{pick(lang,'Merge PDFs','PDF जोड्ने')}</button>
        <button type="button" data-pdf-task="compress" aria-pressed="false">{pick(lang,'Compress PDF','साइज घटाउने')}</button>
        <button type="button" data-pdf-task="image" aria-pressed="false">{pick(lang,'Page to image','पानालाई फोटो')}</button>
      </div>
      <label class="upload-zone pdf-upload" id="pdf-drop" for="pdf-file"><Icon name="upload" size={24}/><strong id="pdf-upload-label">{pick(lang,'Choose a PDF or drop it here','PDF छान्नुहोस् वा यहाँ राख्नुहोस्')}</strong><p>{pick(lang,'20 MiB per file · Up to 10 PDFs','२० MiB प्रति फाइल · १० PDF सम्म')}</p><input id="pdf-file" type="file" accept="application/pdf,.pdf" aria-label={pick(lang,'Choose PDF files','PDF फाइल छान्नुहोस्')}/></label>
      <ol id="pdf-files" class="pdf-files" aria-label={pick(lang,'Selected PDFs, in output order','छानिएका PDF, जोडिने क्रमअनुसार')}></ol>
      <fieldset id="pdf-settings" disabled><legend class="sr-only">{pick(lang,'PDF output settings','PDF नतिजाको सेटिङ')}</legend>
        <div id="pdf-extract-settings" class="field"><label for="pdf-pages">{pick(lang,'Pages to keep','राख्ने पाना')}</label><input id="pdf-pages" type="text" value="1, 3" maxlength="2000" aria-describedby="pdf-pages-help"/><p class="field-help" id="pdf-pages-help">{pick(lang,'Example: 1, 3-5 · Numbered from 1','जस्तै: 1, 3-5 · पाना १ बाट गनिन्छ')}</p></div>
        <p id="pdf-merge-settings" class="field-help" hidden>{pick(lang,'All pages are joined in the file order above. Use ↑ and ↓ to rearrange.','माथिको फाइलको क्रमअनुसार सबै पाना जोडिन्छन्। क्रम मिलाउन ↑ र ↓ थिच्नुहोस्।')}</p>
        <div id="pdf-compress-settings" hidden><div class="field"><label for="pdf-compression">{pick(lang,'Compression mode','साइज घटाउने तरिका')}</label><select id="pdf-compression"><option value="smart">{pick(lang,'High quality · keep text','उच्च गुणस्तर · अक्षर कायम')}</option><option value="balanced">{pick(lang,'Smaller file · keep text','सानो फाइल · अक्षर कायम')}</option><option value="preserve">{pick(lang,'Lossless · keep images unchanged','गुणस्तर नघटाई · फोटो जस्ताको तस्तै')}</option><option value="scanned">{pick(lang,'Scanned pages · rebuild at 250 DPI','स्क्यानका पाना · २५० DPI मा पुनः बनाउने')}</option></select></div><p class="field-help" id="pdf-compression-note"></p></div>
        <div id="pdf-image-settings" hidden><div class="pdf-image-fields"><div class="field"><label for="pdf-image-page">{pick(lang,'Page number','पाना नम्बर')}</label><input id="pdf-image-page" type="text" inputmode="numeric" value="1" maxlength="4"/></div><div class="field"><label for="pdf-image-format">{pick(lang,'Image format','फोटोको प्रकार')}</label><select id="pdf-image-format"><option value="image/png">{pick(lang,'PNG · lossless','PNG · गुणस्तर कायम')}</option><option value="image/jpeg">{pick(lang,'JPG · high quality','JPG · उच्च गुणस्तर')}</option></select></div><div class="field"><label for="pdf-dpi">{pick(lang,'Resolution','फोटोको स्पष्टता')}</label><select id="pdf-dpi"><option value="300">300 DPI</option><option value="200">200 DPI</option><option value="150">150 DPI</option><option value="72">72 DPI</option></select></div></div><p class="field-help">{pick(lang,'300 DPI PNG is best for clear text. Source quality still matters.','स्पष्ट अक्षरका लागि ३०० DPI को PNG राम्रो हुन्छ। मूल पाना पनि स्पष्ट हुनुपर्छ।')}</p></div>
      </fieldset>
      <div id="pdf-error" class="error-box" role="alert" tabindex="-1" hidden></div>
      <div class="panel-actions"><button class="button primary" id="pdf-process" type="submit" disabled>{pick(lang,'Extract pages','पाना छुट्याउनुहोस्')}<Icon name="arrow" size={18}/></button><button class="button secondary" id="pdf-cancel" type="button" hidden>{pick(lang,'Cancel','रद्द गर्नुहोस्')}</button><button class="button ghost" id="pdf-clear" type="button">{pick(lang,'Clear','हटाउनुहोस्')}</button></div>
      <p id="pdf-status" class="field-help" role="status" aria-live="polite">{pick(lang,'Preparing an example…','नमुना तयार हुँदैछ…')}</p>
      <p class="privacy-note"><Icon name="shield" size={14}/>{pick(lang,'On your device. No file uploads.','काम तपाईंको ब्राउजरमै हुन्छ। फाइल अपलोड हुँदैन।')}</p>
    </form>
    <section class="panel result-panel pdf-result-panel" aria-labelledby="pdf-result-heading">
      <div class="panel-heading"><h2 id="pdf-result-heading">{pick(lang,'Preview','फाइलको झलक')}</h2><div class="pdf-preview-modes" role="group" aria-label={pick(lang,'Preview document','कुन फाइल हेर्ने?')}><button id="pdf-mode-original" type="button" aria-pressed="true">{pick(lang,'Original','मूल फाइल')}</button><button id="pdf-mode-result" type="button" aria-pressed="false" disabled>{pick(lang,'Result','नतिजा')}</button></div><span id="pdf-sample-label" class="sample-label sr-only">{pick(lang,'EXAMPLE','नमुना')}</span></div>
      <div id="pdf-result-empty" class="pdf-result-empty"><Icon name="file" size={30}/><p>{pick(lang,'Choose a PDF to scroll through its pages here.','PDF छानेपछि यहाँ स्क्रोल गरेर सबै पाना हेर्न सकिन्छ।')}</p></div>
      <div id="pdf-preview-wrapper" hidden>
        <div class="pdf-viewer-toolbar"><span id="pdf-preview-counter"></span><select id="pdf-preview-file" aria-label={pick(lang,'Original file to preview','हेर्ने मूल फाइल')} hidden></select><select id="pdf-preview-zoom" aria-label={pick(lang,'Preview zoom','झलकको आकार')}><option value="1">{pick(lang,'Fit width','चौडाइमा अटाउने')}</option><option value="1.25">125%</option><option value="1.5">150%</option><option value="2">200%</option></select></div>
        <div id="pdf-preview" class="pdf-scroll-preview" role="region" tabindex="0" aria-label={pick(lang,'PDF pages. Scroll to see every page.','PDF का पाना। सबै पाना हेर्न स्क्रोल गर्नुहोस्।')}></div>
        <p id="pdf-preview-status" class="field-help" role="status"></p>
      </div>
      <div id="pdf-result" hidden><div class="file-stats"><strong id="pdf-output-size"></strong><span id="pdf-output-pages"></span></div><p id="pdf-summary" class="field-help" role="status"></p><a id="pdf-download" class="button primary full-width" download><Icon name="download" size={17}/><span>{pick(lang,'Download result','नतिजा डाउनलोड गर्नुहोस्')}</span></a></div>
    </section>
  </div>
  <Fragment slot="method"><p>{pick(lang,'PDF-Lib extracts and joins pages; PDF.js renders previews and images. Everything runs locally. Extraction and merging retain page content but do not rebuild document bookmarks, attachments or interactive form logic. Interactive forms and digitally signed PDFs are not supported for these operations; use an unsigned, non-interactive copy. Password-protected PDFs are not supported.','PDF-Lib ले पाना छुट्याउने र जोड्ने काम गर्छ; PDF.js ले झलक र फोटो बनाउँछ। सबै काम यही ब्राउजरमा हुन्छ। पाना छुट्याउँदा वा जोड्दा मूल पानाको सामग्री रहन्छ, तर बुकमार्क, संलग्न फाइल वा फारामको अन्तरक्रियात्मक सुविधा सर्दैन। भर्न मिल्ने फाराम र डिजिटल हस्ताक्षर भएका PDF यी कामका लागि प्रयोग गर्न मिल्दैन; हस्ताक्षर नभएको साधारण प्रति प्रयोग गर्नुहोस्। पासवर्ड भएका PDF पनि चल्दैनन्।')}</p><p>{pick(lang,'High-quality compression keeps text, vectors and page layout. It recompresses suitable JPEG images at their existing resolution, only when smaller. Images with masks, unusual colour spaces, EXIF/non-sRGB ICC metadata or more than 12 MP are left unchanged. Lossless mode leaves image bytes untouched. The optional scanned-page mode redraws at 250 DPI and removes selectable text, links and form controls. When output is not smaller, the original is offered instead. No size reduction is guaranteed.','उच्च गुणस्तरको विकल्पले अक्षर, रेखाचित्र र पानाको बनावट कायम राख्छ। मिल्ने JPEG फोटोलाई मूल आकारमै पुनः सङ्कुचन गरेर सानो भएमा मात्र बदलिन्छ। विशेष रङ, मास्क, EXIF वा sRGB बाहेकका ICC विवरण वा १२ MP भन्दा ठूला फोटो जस्ताको तस्तै रहन्छन्। गुणस्तर नघटाउने विकल्पले फोटोको बाइट पनि बदल्दैन। स्क्यानका पाना पुनः बनाउने विकल्पमा २५० DPI को फोटो बन्छ; अक्षर छान्न, लिङ्क खोल्न वा फाराम भर्न मिल्दैन। नयाँ फाइल सानो नभए मूल फाइल नै डाउनलोड गर्न दिइन्छ। साइज घट्छ नै भन्ने हुँदैन।')}</p><p>{pick(lang,'Limits: 20 MiB per file, 50 MiB in total, 10 files and 500 output pages. Image-based compression: up to 50 pages. Image exports: PNG at 300 DPI by default, or 95% quality JPG. Pages are capped at 12 MP and 4,096 px per side; effective DPI is shown if reduced. Previews render at screen pixel density and load nearby pages as you scroll. Downloads are new copies; clear or close this page to release your selected documents.','सीमा: हरेक फाइल २० MiB, जम्मा ५० MiB, १० फाइल र नतिजामा ५०० पानासम्म। फोटो बनाएर साइज घटाउन ५० पानासम्म मिल्छ। फोटो बनाउँदा ३०० DPI को PNG वा ९५% गुणस्तरको JPG प्रयोग हुन्छ। फोटो १२ MP र प्रत्येक छेउ ४,०९६ px सम्म हुन्छ; सीमा लागेमा वास्तविक DPI देखाइन्छ। झलक स्क्रिनको स्पष्टताअनुसार बन्छ र स्क्रोल गर्दा नजिकका पाना मात्र खोलिन्छन्। डाउनलोड गर्दा नयाँ प्रति बन्छ। छानेका कागजात हटाउन यो पृष्ठ खाली गर्नुहोस् वा बन्द गर्नुहोस्।')}</p><p><a href="https://pdf-lib.js.org/">PDF-Lib</a> · <a href="https://mozilla.github.io/pdf.js/">Mozilla PDF.js</a></p></Fragment>
  <script>import '../../../scripts/pdf-tool';</script>
</ToolLayout>
