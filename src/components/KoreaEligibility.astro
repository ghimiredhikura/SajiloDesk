---
import { pick, route, type Lang } from '../lib/catalog';
import { visaEligibility, getVisaEligibility, eligibilitySources, gniReference, netAssetsReference, won } from '../lib/korea-eligibility';
interface Props { lang:Lang; visa?:string }
const {lang,visa}=Astro.props;
const t=(text:readonly[string,string])=>text[lang==='ne'?1:0];
const directory=!visa||visa==='F-5';
const records=visa==='F-5'?visaEligibility.filter(v=>v.family==='F-5'):visa?visaEligibility.filter(v=>v.id===visa):visaEligibility;
const showMoney=!visa||(getVisaEligibility(visa)?.family==='F-5'||!!getVisaEligibility(visa)?.income);
---
{records.length>0&&<section class:list={['eligibility',{ 'eligibility-single':!directory }]} data-eligibility data-lang={lang}>
  <details class="eligibility-directory" id={directory?'visa-eligibility':undefined}>
    <summary>{pick(lang,'Eligibility & criteria','योग्यता र सर्त')} {directory&&<span>{pick(lang,'Search visa subtypes','भिसाको उपप्रकार खोज्नुहोस्')}</span>}</summary>
    <div class="eligibility-body">
      {directory&&<><p class="eligibility-scope">{pick(lang,'For Nepali nationals in Korea. Open a visa to check its route, criteria and evidence.','कोरियामा रहेका नेपाली नागरिकका लागि। योग्यता, सर्त र प्रमाण हेर्न भिसा खोल्नुहोस्।')}</p><div class="eligibility-search"><label for="eligibility-search">{pick(lang,'Find a visa','भिसा खोज्नुहोस्')}</label><input id="eligibility-search" type="search" autocomplete="off" placeholder={pick(lang,'F5, F-5-15, D2, doctorate…','F5, F-5-15, D2, विद्यावारिधि…')}/><button type="button" data-eligibility-filter="F-5">F-5</button><button type="button" data-eligibility-filter="">{pick(lang,'All','सबै')}</button></div></>}
      {showMoney&&<details class="eligibility-money" id={!visa?'gni-reference':undefined}>
        <summary>{pick(lang,'GNI & net assets · amounts and reference dates','GNI र खुद सम्पत्ति · रकम र आधार मिति')}</summary>
        <p>{pick(lang,'2025 income-year references, checked 7 November 2026. These are annual KRW amounts; GNI is per person, not total national income.','२०२५ आय वर्षको आधार, ७ नोभेम्बर २०२६ मा जाँचिएको। रकम वार्षिक कोरियाली वनमा छ; GNI यहाँ प्रतिव्यक्ति हो, देशको कुल आय होइन।')}</p>
        <div class="eligibility-table"><table><thead><tr><th>{pick(lang,'Multiplier','गुणक')}</th><th>{pick(lang,'Published 2026 visa reference¹','प्रकाशित २०२६ भिसा आधार¹')}</th><th>{pick(lang,'Later BOK revision²','पछिको BOK संशोधन²')}</th></tr></thead><tbody>{[1,1.5,2,3,4].map(m=><tr><th>{m}× GNI</th><td>{won(gniReference.visaReference*m)}</td><td>{won(gniReference.revisedStatistic*m)}</td></tr>)}</tbody></table></div>
        <p>{pick(lang,'¹ The March 10 BOK release and a Korean embassy’s published 2026 visa guidance use ₩52,416,000. ² BOK revised the 2025 statistic to ₩52,570,000 on June 9. The F-5 manual specifies previous-year GNI but does not settle the revision’s filing-effective date. Confirm the figure applied to your F-5 filing with 1345/the receiving office; the revised statistic is not presented here as a confirmed immigration cutoff.','¹ मार्च १० को BOK प्रकाशन र कोरियाली दूतावासको प्रकाशित २०२६ भिसा जानकारीमा ₩52,416,000 छ। ² BOK ले जुन ९ मा २०२५ को तथ्याङ्क ₩52,570,000 मा संशोधन गरेको छ। F-5 निर्देशिकामा अघिल्लो वर्षको GNI भनिए पनि संशोधित रकम कहिलेदेखिको आवेदनमा लाग्छ भन्ने खुलेको छैन। आफ्नो F-5 आवेदनमा कुन रकम लाग्छ, १३४५ वा बुझाउने कार्यालयसँग निश्चित गर्नुहोस्। संशोधित तथ्याङ्कलाई यहाँ निश्चित अध्यागमन सीमा भनिएको छैन।')}</p>
        <p>{pick(lang,`2025 mean household net assets: ${won(netAssetsReference.mean)}; 1.5× = ${won(netAssetsReference.mean*1.5)}. This is an asset alternative only where the route expressly permits it; F-5-2 uses a median measure instead.`,`२०२५ को औसत घरपरिवारको खुद सम्पत्ति: ${won(netAssetsReference.mean)}; १.५ गुणा = ${won(netAssetsReference.mean*1.5)}। सम्बन्धित प्रक्रियाले स्पष्ट रूपमा अनुमति दिए मात्र सम्पत्तिको विकल्प लाग्छ; F-5-2 मा मध्यक (median) प्रयोग हुन्छ।`)}</p>
        <p>{pick(lang,'F-5 income normally means the previous calendar tax year, not the last 365 days. An earlier tax year can apply if the required certificate is not yet issuable. For many F-5 routes, qualifying cohabiting family income/assets may count, but the applicant normally supplies at least 50%; exceptions and applicant-only routes differ. Assets normally must be held for six months and maintained through approval.','F-5 मा आय सामान्यतया अघिल्लो पात्रो वर्षको कर आय हो, पछिल्ला ३६५ दिनको होइन। आवश्यक कर प्रमाण जारी नहुने बेला त्योभन्दा अघिल्लो वर्ष लागू हुन सक्छ। धेरै F-5 प्रक्रियामा सँगै बस्ने योग्य परिवारको आय/सम्पत्ति गनिन सक्छ, तर सामान्यतया कम्तीमा ५०% आवेदकको आफ्नै हुनुपर्छ; छुट र आफ्नै आय मात्र गनिने प्रक्रियामा फरक हुन्छ। सम्पत्ति सामान्यतया छ महिना राखेको र स्वीकृतिसम्म कायम हुनुपर्छ।')}</p>
        <div class="eligibility-sources">{(['gniMarch','visa2026','gniJune','assets'] as const).map(id=><a href={eligibilitySources[id].url} target="_blank" rel="noopener noreferrer">{eligibilitySources[id].name} ↗</a>)}</div>
      </details>}
      <div class:list={['eligibility-records',{'eligibility-scroll':directory}]}>
        {records.map(record=><details class="eligibility-record" id={`eligibility-${record.id.toLowerCase()}`} data-eligibility-code={record.id} data-eligibility-search={`${record.id} ${record.name.join(' ')} ${record.criteria.map(c=>c.join(' ')).join(' ')}`} open={!directory}>
          <summary><strong>{record.id}</strong><span>{t(record.name)}</span></summary>
          <div class="eligibility-content"><ul>{record.criteria.map(c=><li>{t(c)}</li>)}</ul>
          {record.income&&<div class="eligibility-income"><strong>{pick(lang,'Income / assets','आय / सम्पत्ति')}</strong><p>{t(record.income.text)}</p>{record.income.multiple&&<p class="eligibility-amount">{record.income.multiple}× GNI: {won(gniReference.visaReference*record.income.multiple)}<span> · {pick(lang,'published visa reference; confirm the applicable figure','प्रकाशित भिसा आधार; लागू रकम निश्चित गर्नुहोस्')}</span></p>}{record.income.assetMultiple&&<p>{pick(lang,'Permitted asset alternative','मान्य सम्पत्तिको विकल्प')}: {won(netAssetsReference.mean*record.income.assetMultiple)} <span>({record.income.assetMultiple}× {pick(lang,'2025 mean net assets','२०२५ को औसत खुद सम्पत्ति')})</span></p>}</div>}
          {record.knowledge&&<p><strong>{pick(lang,'Language / integration','भाषा / सामाजिक ज्ञान')}: </strong>{t(record.knowledge)}</p>}
          {record.criminal&&<p><strong>{pick(lang,'Conduct / police record','आचरण / प्रहरी अभिलेख')}: </strong>{t(record.criminal)}</p>}
          {record.evidence.length>0&&<><h3>{pick(lang,'Evidence to prepare','जुटाउनुपर्ने प्रमाण')}</h3><ul>{record.evidence.map(e=><li>{t(e)}</li>)}</ul></>}
          <p class="eligibility-footnote">{pick(lang,'Last checked','पछिल्लो जाँच')}: <time datetime={record.reviewed}>{record.reviewed}</time> · <a href={eligibilitySources.manual.url} target="_blank" rel="noopener noreferrer">HiKorea · {record.section} ↗</a></p>
          {directory&&record.id!==visa&&<a class="text-link" href={route(lang,`life-abroad/korea/${record.id==='F-5-20'?'child-status':`change-to-${record.id.toLowerCase()}`}`)}>{pick(lang,'Open document guide','कागजातको जानकारी खोल्नुहोस्')} →</a>}
          </div>
        </details>)}
      </div><p class="eligibility-empty" hidden>{pick(lang,'No matching entry. Try the parent code, or check the official manual for a specialist programme.','मिल्ने विवरण भेटिएन। मूल भिसा कोड खोज्नुहोस् वा विशेष कार्यक्रमका लागि आधिकारिक निर्देशिका हेर्नुहोस्।')}</p>
      {directory&&<p class="eligibility-scope">{pick(lang,'Criteria are a route summary, not an approval decision. Unlisted specialist programmes stay under their parent code. Overseas-Korean routes (F-4/H-2 and related F-5 categories) and H-1 working holiday are outside this Nepali catalogue.','यी प्रक्रियाका मुख्य सर्त हुन्, स्वीकृतिको निर्णय होइनन्। छुटेका विशेष कार्यक्रम मूल वर्गअन्तर्गत छन्। कोरियाली मूलका व्यक्तिका F-4/H-2 र सम्बन्धित F-5 तथा H-1 कार्यभ्रमण यस नेपाली सूचीको दायरामा पर्दैनन्।')}</p>}
    </div>
  </details>
</section>}
<script>
  import '../scripts/korea-eligibility';
</script>
<style>
  .eligibility{margin:.7rem 0;border:1px solid var(--border,#dce4e6);border-radius:12px;background:var(--surface,#fff);font-size:.9rem}
  .eligibility-directory>summary{padding:.65rem .8rem;font-weight:700;cursor:pointer}.eligibility-directory>summary>span{font-weight:400;color:var(--muted);margin-left:.5rem;font-size:.85em}
  .eligibility-body{padding:0 .8rem .65rem}.eligibility-scope,.eligibility-footnote{font-size:.85em;color:var(--muted);margin:.4rem 0}.eligibility-search{display:flex;flex-wrap:wrap;gap:.35rem;align-items:center;margin:.5rem 0}.eligibility-search label{font-weight:650}.eligibility-search input{flex:1;min-width:8rem;min-height:44px;font-size:16px;border:1px solid var(--border,#dce4e6);border-radius:7px;padding:.4rem .6rem}.eligibility-search button{min-height:44px;padding:.35rem .65rem;border:1px solid var(--border,#dce4e6);border-radius:7px;background:transparent;cursor:pointer}
  .eligibility-scroll{max-height:27rem;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable}.eligibility-record{border-top:1px solid var(--border,#dce4e6)}.eligibility-record>summary{padding:.6rem .15rem;cursor:pointer;line-height:1.5}.eligibility-record>summary strong{display:inline-block;min-width:5.4rem}.eligibility-record>summary span{margin-left:.25rem}.eligibility-content{padding:0 .3rem .65rem;line-height:1.6}.eligibility-content ul{padding-left:1.15rem;margin:.3rem 0}.eligibility-content li+li{margin-top:.3rem}.eligibility-content p{margin:.4rem 0}.eligibility-content h3{font-size:1em;margin:.6rem 0 .2rem}.eligibility-income{padding:.5rem .65rem;border-left:3px solid var(--accent,#16806c);background:var(--surface-soft,#f1f7f5);margin:.55rem 0}.eligibility-amount{font-weight:700}.eligibility-amount span{font-weight:400;font-size:.9em}.eligibility-money{margin:.45rem 0;border:1px solid var(--border,#dce4e6);border-radius:8px;padding:.5rem .6rem;font-size:.9em}.eligibility-money summary{cursor:pointer;font-weight:650}.eligibility-money p{margin:.5rem 0;line-height:1.6}.eligibility-table{overflow-x:auto}.eligibility-table table{border-collapse:collapse;width:100%;font-size:.9em}.eligibility-table th,.eligibility-table td{text-align:left;padding:.4rem;border-bottom:1px solid var(--border,#dce4e6);white-space:nowrap}.eligibility-sources{display:flex;flex-wrap:wrap;gap:.3rem .8rem;font-size:.9em}.eligibility [hidden]{display:none!important}
  @media(max-width:600px){.eligibility-body{padding:0 .55rem .55rem}.eligibility-directory>summary{padding:.6rem}.eligibility-scroll{max-height:25rem}.eligibility-record>summary strong{min-width:4.8rem}.eligibility-record>summary{padding:.65rem .1rem}.eligibility-content{padding-right:.1rem;padding-left:.1rem}}
</style>
