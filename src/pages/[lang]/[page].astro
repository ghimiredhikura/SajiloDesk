---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { langs,pick,route } from '../../lib/catalog';
import { withBase } from '../../lib/paths';
const titles = { about:['A useful little desk, for everyone.','दैनिक काममा सबैको साथी।'], privacy:['Your work stays with you.','तपाईंको काम, तपाईंसँगै।'], contact:['Help us make things easier.','अझ सजिलो बनाउन सघाउनुहोस्।'], methodology:['Clear methods. Traceable sources.','नतिजा कसरी निकालिन्छ? स्रोत के हो?'] };
export function getStaticPaths(){return ['about','privacy','contact','methodology'].flatMap(page=>langs.map(lang=>({params:{lang,page},props:{lang,page}})));}
const {lang,page}=Astro.props;
const heading=titles[page as keyof typeof titles];
const title=pick(lang,heading[0],heading[1]);
const email=import.meta.env.PUBLIC_CONTACT_EMAIL || 'sajilodesk@gmail.com';
---
<Layout lang={lang} title={title} description={pick(lang,'Learn about Sajilo Desk, our sources, privacy and ways to send feedback.','सजिलो डेस्कबारे जान्नुहोस्। हामीले प्रयोग गर्ने स्रोत, तपाईंको गोपनीयता र सुझाव पठाउने तरिका यहाँ छन्।')}><div class="container"><article class="prose"><div class="page-heading"><p class="eyebrow">SAJILO DESK / सजिलो डेस्क</p><h1>{title}</h1></div>
{page==='about' && <><p>{pick(lang,'Sajilo means easy. That is the idea behind Sajilo Desk: a small collection of useful tools for the everyday work that shouldn’t take all day.','साना काममै धेरै समय नबितोस् भन्ने सोचले सजिलो डेस्क बनाइएको हो। दैनिक जीवनमा चाहिने केही उपयोगी उपकरण यहाँ एकै ठाउँमा पाइन्छन्।')}</p><h2>{pick(lang,'Built around real tasks','तपाईंलाई चाहिने कामका लागि')}</h2><p>{pick(lang,'A student checking their age on an application deadline. A parent converting a birth date. A print shop preparing a customer’s photo. A Nepali abroad working with two calendars. These are the jobs we are building for.','आवेदनका लागि उमेर निकाल्ने विद्यार्थी होस्, बच्चाको नेपाली जन्ममिति अंग्रेजीमा बदल्ने अभिभावक होस् वा ग्राहकको फोटो मिलाउने प्रिन्ट पसल। विदेशमा बसेर नेपाली र अंग्रेजी दुवै मिति चाहिनेहरूलाई पनि काम लागोस् भनेर यी उपकरण बनाएका हौँ।')}</p><div class="prose-card"><h3 style="margin-top:0">{pick(lang,'A simple promise','सरल प्रतिबद्धता')}</h3><ul><li>{pick(lang,'Core tools are free and accessible without an account.','मुख्य उपकरण निःशुल्क छन् र खाता चाहिँदैन।')}</li><li>{pick(lang,'Photos, PDFs, text and calculations are processed in your browser.','फोटो र PDF मिलाउने, पाठ बदल्ने र गणना गर्ने काम तपाईंको ब्राउजरमै हुन्छ।')}</li><li>{pick(lang,'English and Nepali pages share the same calculation methods.','नेपाली र अंग्रेजी पृष्ठले एउटै गणना विधि प्रयोग गर्छन्।')}</li><li>{pick(lang,'Sources and limitations are visible alongside each tool.','हरेक उपकरणमा प्रयोग गरिएको स्रोत र त्यसले गर्न सक्ने कामको सीमा खुलाइएको छ।')}</li></ul></div><h2>{pick(lang,'Independent, and still improving','स्वतन्त्र प्रयास, सुधार जारी छ')}</h2><p>{pick(lang,'This project is maintained by Deepak Ghimire. Sajilo Desk is an independent utility site, not a government service. We do not submit applications, verify documents or determine eligibility.','सजिलो डेस्क दीपक घिमिरेले सञ्चालन गरेको स्वतन्त्र वेबसाइट हो। यो सरकारी सेवा होइन। यहाँबाट आवेदन बुझाइँदैन, कागजात प्रमाणित गरिँदैन र आवेदनको योग्यता निर्धारण गरिँदैन।')}</p><p>{pick(lang,'The first release focuses on five tools. New tools will follow observed needs, correctness checks and sustainable maintenance. Independent Nepali wording and legacy-text review are still part of our launch checks.','अहिले पाँच उपकरण उपलब्ध छन्। तपाईंहरूको आवश्यकता हेरेर, नतिजाको शुद्धता जाँचेर र नियमित हेरचाह गर्न सकिने गरी थप उपकरण ल्याउने योजना छ। नेपाली भाषा र प्रीति रूपान्तरणको स्वतन्त्र समीक्षा पनि प्रकाशनअघिका जाँचमा समावेश छ।')}</p><p><a href={route(lang,'contact')}>{pick(lang,'Tell us what would make your day easier.','तपाईंको काम अझ सजिलो बनाउन के थप्न सकिन्छ? सुझाव दिनुहोस्।')}</a></p></>}
{page==='privacy' && <>
<p>{pick(lang,'Last reviewed: 6 November 2026.','पछिल्लो समीक्षा: ६ नोभेम्बर २०२६।')}</p>
<h2>{pick(lang,'What stays on your device','तपाईंको ब्राउजरमै रहने विवरण')}</h2><p>{pick(lang,'Dates, pasted text, measurements, selected photos, PDFs and generated outputs are processed in your browser. The tools do not upload these inputs or include them in URLs. Downloaded files stay wherever you save them. Korea guides do not ask you to upload passports or other documents.','मिति, पाठ, जग्गाको नाप, फोटो, PDF र तयार भएका नतिजाको काम तपाईंको ब्राउजरमै हुन्छ। उपकरणले यी विवरण अपलोड गर्दैनन् र लिङ्कमा राख्दैनन्। डाउनलोड गरेका फाइल तपाईंले राखेको ठाउँमै रहन्छन्। कोरियाको जानकारी प्रयोग गर्दा राहदानी वा अन्य कागजात अपलोड गर्नुपर्दैन।')}</p>
<h2>{pick(lang,'What we remember','के सेभ गरेर राखिन्छ?')}</h2><p>{pick(lang,'Local storage remembers your chosen language, favourite tool IDs and, when you press Save, the Korea checklist choices and ticks. These stay in this browser and device; there is no account or cross-device sync. Clear them below or reset an individual checklist. Comment drafts are not saved automatically.','तपाईंले छानेको भाषा, मनपर्ने उपकरण र सेभ गर्दा कोरियाको सूचीका विकल्प र चिनो यही ब्राउजरमा रहन्छन्। यी विवरण अर्को उपकरणमा आफैँ सर्दैनन् र खाता बनाइँदैन। तलबाट सबै हटाउन वा सम्बन्धित सूचीमा चिनो हटाउन सक्नुहुन्छ। लेख्दै गरेको टिप्पणी आफैँ सेभ हुँदैन।')}</p><button type="button" class="button secondary" data-clear-preferences>{pick(lang,'Clear saved preferences and checklists','सेभ गरेको भाषा, उपकरण र कागजातको सूची हटाउनुहोस्')}</button>
<h2>{pick(lang,'Public comments','सार्वजनिक टिप्पणी')}</h2><p>{pick(lang,'Submitting a comment sends its nickname (or “Visitor”), text, topic, guide and submission time to SajiloDesk’s Cloudflare-hosted database for review. We do not ask for email addresses or identity documents. Only approved comments are publicly returned by the comments service. A nickname is not verified. Leave out passport/ARC numbers, phone numbers, addresses and other private details.','टिप्पणी पठाउँदा उपनाम (वा “Visitor”), लेखाइ, विषय, सम्बन्धित जानकारी र पठाएको समय समीक्षाका लागि सजिलो डेस्कको Cloudflare मा रहेको डेटाबेसमा जान्छ। इमेल वा परिचय कागजात मागिँदैन। स्वीकृत टिप्पणी मात्र सार्वजनिक रूपमा देखाइन्छ। उपनामको पहिचान पुष्टि गरिँदैन। राहदानी/ARC नम्बर, फोन नम्बर, ठेगाना र अन्य निजी विवरण नराख्नुहोस्।')}</p><p>{pick(lang,'Approved comments remain public until removed. Unapproved comments are automatically removed within 31 days. To request removal or report a concern, email us with the guide URL and comment/receipt number. We may remove spam, private details or misleading material.','स्वीकृत टिप्पणी हटाइनुअघिसम्म सार्वजनिक रहन्छ। स्वीकृत नभएका टिप्पणी ३१ दिनभित्र आफैँ हट्छन्। हटाउन वा समस्या जानकारी गराउन सम्बन्धित पृष्ठको लिङ्क र टिप्पणी/रसिद नम्बर सहित इमेल गर्नुहोस्। स्पाम, निजी विवरण वा भ्रामक सामग्री हटाउन सक्छौँ।')}</p><p>{pick(lang,'To limit spam, the service uses a private, day-specific hash of the connection IP address and a submission count. Raw IP addresses are not stored in our comment tables. These rate-limit records are removed within 72 hours. People sharing a connection may share the daily limit. Cloudflare also processes connection information to host and protect the service.','स्पाम सीमित गर्न जडानको IP ठेगानाबाट गोप्य कुञ्जीसहित हरेक दिन फरक हुने ह्यास र पठाएको सङ्ख्या राखिन्छ। टिप्पणीको तालिकामा वास्तविक IP राखिँदैन। सीमा जाँच्ने यो विवरण ७२ घण्टाभित्र हट्छ। एउटै इन्टरनेट जडान चलाउने व्यक्तिको दैनिक सीमा साझा हुन सक्छ। सेवा चलाउन र सुरक्षित राख्न Cloudflare ले पनि जडानसम्बन्धी विवरण प्रयोग गर्छ।')}</p>
<h2>{pick(lang,'Connections and analytics','वेबसाइट खोल्दा आदानप्रदान हुने विवरण')}</h2><p>{pick(lang,'There are no advertising trackers or analytics scripts. Fonts, tool code and comments are served through this site. The hosting provider may process ordinary connection information such as IP addresses and request logs to serve and protect it. If analytics are added, this policy will be updated first.','विज्ञापनका लागि पछ्याउने वा प्रयोगको तथ्याङ्क सङ्कलन गर्ने स्क्रिप्ट छैनन्। फन्ट, उपकरणको कोड र टिप्पणी यही वेबसाइटबाट आउँछन्। होस्टिङ सेवा प्रदायकले सेवा चलाउन र सुरक्षित राख्न IP ठेगाना र पृष्ठका अनुरोधजस्ता विवरण प्रयोग गर्न सक्छ। तथ्याङ्क सङ्कलन गर्ने सुविधा थप्नुअघि यो नीति फेरिनेछ।')}</p>
<h2>{pick(lang,'Feedback and external links','सुझाव र बाह्य लिङ्क')}</h2><p>{pick(lang,'The separate feedback form downloads a draft on your device; it does not send it. If you email us, your provider and our inbox receive what you send. Official websites linked in the guides have their own privacy policies.','छुट्टै सुझाव फारामले तपाईंको उपकरणमा मस्यौदा डाउनलोड गर्छ; आफैँ पठाउँदैन। इमेल गरेमा पठाएको विवरण तपाईंको इमेल सेवा प्रदायक र हामीले पाउँछौँ। जानकारीमा जोडिएका आधिकारिक वेबसाइटका आफ्नै गोपनीयता नीति हुन्छन्।')}</p><p>{pick(lang,'Questions or removal requests:','प्रश्न वा हटाउने अनुरोध:')} <a href={`mailto:${email}`}>{email}</a></p></>}
{page==='contact' && <><p>{pick(lang,'A wrong result, a confusing label, or a tool you wish existed? We would like to hear about it. Please use a made-up example when reporting a calculation or text-conversion issue.','नतिजा मिलेन? कुनै शब्द बुझ्न गाह्रो भयो? वा नयाँ उपकरण चाहिएको छ? हामीलाई लेख्नुहोस्। गणना वा पाठ बदल्दाको समस्या बताउँदा आफ्नो वास्तविक विवरणको सट्टा काल्पनिक उदाहरण दिनुहोस्।')}</p><div class="contact-detail"><strong>{pick(lang,'Write to us','हामीलाई लेख्नुहोस्')}</strong><br/><a href={`mailto:${email}`}>{email}</a></div><div class="prose-card"><h2 style="margin-top:0">{pick(lang,'Prepare a feedback draft','सुझावको मस्यौदा बनाउनुहोस्')}</h2><form class="feedback-form" id="feedback-form"><div class="field"><label for="feedback-topic">{pick(lang,'What is this about?','कुन विषयमा हो?')}</label><select id="feedback-topic"><option>{pick(lang,'A tool or result','उपकरण वा नतिजा')}</option><option>{pick(lang,'Nepali wording','नेपाली भाषा')}</option><option>{pick(lang,'A feature idea','नयाँ सुविधाको सुझाव')}</option><option>{pick(lang,'Something else','अन्य विषय')}</option></select></div><div class="field"><label for="feedback-message">{pick(lang,'Your feedback','तपाईंको सुझाव')}</label><textarea id="feedback-message" maxlength="3000" required placeholder={pick(lang,'What did you try? What did you expect? What happened?','के गर्न खोज्नुभएको थियो? कस्तो नतिजा आउनुपर्थ्यो? के देखियो?')}></textarea></div><button type="submit" class="button primary"><Icon name="download" size={16}/>{pick(lang,'Download feedback draft','सुझावको मस्यौदा डाउनलोड गर्नुहोस्')}</button><p class="field-help" role="status" id="feedback-status">{pick(lang,'This saves a text file to your device. It does not submit or send anything.','सुझावको मस्यौदा .txt फाइलमा डाउनलोड हुन्छ। यसबाट सुझाव आफैँ पठाइँदैन।')}</p></form></div><h2>{pick(lang,'For print and cyber shops','प्रिन्ट तथा साइबर पसलका साथीहरूलाई')}</h2><p>{pick(lang,'We are preparing a small usability pilot in Butwal and Tilottama. If you would like to help test the tools with fictitious examples, email us. Participation and findings are not yet confirmed.','बुटवल र तिलोत्तमाका केही पसलमा यी उपकरण चलाउन कत्तिको सजिलो हुन्छ भनेर परीक्षण गर्ने तयारी छ। काल्पनिक उदाहरणबाट जाँच्न सघाउन चाहनुहुन्छ भने इमेल गर्नुहोस्। सहभागीको टुङ्गो र परीक्षणको नतिजा भने आउन बाँकी छ।')}</p></>}
{page==='methodology' && <><p>{pick(lang,'A useful result should be understandable and reproducible. Each tool includes its own explanation, supported range and limits. Reviewed 4 November 2026.','नतिजा कसरी आयो भन्ने कुरा पनि स्पष्ट हुनुपर्छ। त्यसैले हरेक उपकरणमा त्यसको विधि, स्रोत र सीमाबारे जानकारी राखेका छौँ। जाँचिएको मिति: ४ नोभेम्बर २०२६।')}</p><h2>{pick(lang,'Calendars and age','पात्रो र उमेर')}</h2><p>{pick(lang,'Date conversion uses a versioned month-length table from @remotemerge/nepali-date-converter 1.2.7, under MIT. Date-only arithmetic avoids time-zone shifts, and Today uses Asia/Kathmandu. Independent official date fixtures and exhaustive round-trip tests are included in the project. A round trip tests internal consistency; it does not independently establish every historical date.','नेपाली र अंग्रेजी मिति बदल्न MIT इजाजतपत्रअन्तर्गतको @remotemerge/nepali-date-converter 1.2.7 प्रयोग हुन्छ। यसमा प्रत्येक महिनाको दिनसङ्ख्याको तालिका छ। मिति मात्र लिएर गणना गरिने भएकाले तपाईं बसेको देशको समयले नतिजा बदल्दैन। ‘आज’ को मिति भने नेपाल समयअनुसार लिइन्छ। आधिकारिक स्रोतका केही मितिसँग नतिजा दाँजिएको छ। सबै मितिलाई अर्को पात्रोमा बदलेर फेरि फर्काउँदा उही मिति आउँछ कि भन्ने परीक्षण पनि छ। यसले गणनाको आपसी मिलान जाँच्छ, हरेक ऐतिहासिक मिति स्वतन्त्र रूपमा प्रमाणित भने गर्दैन।')}</p><ul><li><a href="https://github.com/remotemerge/nepali-date-converter">{pick(lang,'Calendar library and MIT license','पात्रोको लाइब्रेरी र MIT इजाजतपत्र')}</a></li><li><a href="https://ae.nepalembassy.gov.np/pages/holidays-16/">{pick(lang,'Nepal Embassy holiday dates (official reference)','नेपाली दूतावासको बिदा मिति (आधिकारिक सन्दर्भ)')}</a></li></ul><p>{pick(lang,'Age is Gregorian completed years, months and days after BS conversion. Missing anniversaries in shorter months use that month’s final day. The tool does not assess application eligibility.','उमेर निकाल्दा दुवै मितिलाई अंग्रेजी पात्रोमा मिलाएर पूरा भएका वर्ष, महिना र दिन गनिन्छन्। कुनै महिनामा जन्ममितिको गते नपरे त्यस महिनाको अन्तिम दिन लिइन्छ। आवेदन दिन उमेर पुग्छ कि पुग्दैन भन्ने निर्णय सम्बन्धित निकायको नियमअनुसार हुन्छ।')}</p><h2>{pick(lang,'Today’s holidays and worldwide days','आजका दिवस र बिदा')}</h2><p>{pick(lang,'The key day and separate holiday status use Nepal time. Nepal holidays are mapped for BS 2083 (14 April 2026–13 April 2027), with Saturday and Sunday as weekly holidays. Regional and community holidays are labelled with their scope. After the mapped year, the card asks for a calendar update instead of repeating lunar dates.','विशेष दिवस र बिदाको जानकारी छुट्टाछुट्टै देखाइन्छ। मिति नेपाल समयअनुसार फेरिन्छ। बिदाको सूची वि.सं. २०८३ (१४ अप्रिल २०२६–१३ अप्रिल २०२७) का लागि राखिएको छ। शनिबार र आइतबार साप्ताहिक बिदा हुन्। कुनै क्षेत्र वा समूहलाई मात्र लागू हुने बिदामा कसका लागि हो भन्ने खुलाइन्छ। सूचीमा समेटिएको वर्ष सकिएपछि पुरानै बिदा दोहोरिँदैन; नयाँ विवरण थप्न बाँकी भएको सूचना देखिन्छ।')}</p><p>{pick(lang,'Worldwide highlights are selected fixed-date UN and UN-agency observances, not public holidays. The published list may be supplemented by later government or local notices. Holidays whose dates have not been announced are not guessed. Reviewed 5 November 2026.','विश्व दिवसमा संयुक्त राष्ट्रसङ्घ र यसका निकायले मनाउने निश्चित मितिका केही दिवस छानिएका छन्। दिवस हुनु र सार्वजनिक बिदा हुनु फरक कुरा हुन्। पछि जारी हुने सरकारी वा स्थानीय सूचनाले बिदा थप्न सक्छन्। मिति घोषणा नभएका बिदाको अनुमान गरिएको छैन। जाँचिएको मिति: ५ नोभेम्बर २०२६।')}</p><ul><li><a href="https://moha.gov.np/page/government-and-public-holidays-in-2083">{pick(lang,'Ministry of Home Affairs: 2083 holidays','गृह मन्त्रालय: २०८३ का बिदा')}</a></li><li><a href="https://daorasuwa.moha.gov.np/post/sa-lka-sa-ra-vajana-ka-b-tha-2">{pick(lang,'Official Saturday and Sunday holiday notice','शनिबार र आइतबार बिदाको आधिकारिक सूचना')}</a></li><li><a href="https://www.un.org/en/observances/list-days-weeks">{pick(lang,'United Nations: international days','संयुक्त राष्ट्रसङ्घ: अन्तर्राष्ट्रिय दिवस')}</a></li></ul><h2>{pick(lang,'Nepal key days and the calendar','नेपालका विशेष दिवस र पात्रो')}</h2><p>{pick(lang,'Nepal key days are a sourced selection across the full Nepali year, including literary birth anniversaries and national observances. The reviewed edition begins in BS 2083. Fixed dates follow their own BS or AD calendar; lunar dates are recorded for a specific year. Key days and public holidays are separate.','नेपालका विशेष दिवसमा वर्षभरिका केही राष्ट्रिय दिवस र साहित्यकारलगायत ऐतिहासिक व्यक्तित्वका जन्मजयन्ती समेटिएका छन्। यी विवरण वि.सं. २०८३ देखि देखाइन्छन्। निश्चित मितिका दिवस हरेक वर्ष सम्बन्धित नेपाली वा अंग्रेजी पात्रोअनुसार दोहोरिन्छन्। चन्द्रपात्रोअनुसार सर्ने दिवस भने मिति थाहा भएको वर्षका लागि मात्र राखिन्छन्। कुनै दिवस परेकै आधारमा त्यस दिन बिदा मानिँदैन।')}</p><p>{pick(lang,'The calendar section uses the same conversion library and range as the date tool. Large day numbers follow the selected calendar and smaller numbers show the other calendar. The selected-day panel displays both full dates, sources and any listed observances. Inputs remain in this page.','पात्रो र मिति रूपान्तरण उपकरणले एउटै तालिका र उपलब्ध मितिको अवधि प्रयोग गर्छन्। पात्रोमा ठूला अंक तपाईंले छानेको पात्रोका र साना अंक अर्को पात्रोका मिति हुन्। कुनै दिन छान्दा त्यसको नेपाली र अंग्रेजी मिति, विशेष दिवस र स्रोत देखिन्छन्। तपाईंले छानेको मिति यही पृष्ठमा मात्र रहन्छ।')}</p><h2>{pick(lang,'Legacy text','प्रीतिमा लेखिएको पाठ')}</h2><p>{pick(lang,'Preeti mapping is provided by @lacspace/preeti 1.1.0, under the Lacspace Free Licence v1.0. Explicit [[English]] markers preserve English without guessing. Automated examples cover common reordering and mixed text; independent Nepali typist review remains pending.','प्रीतिको पाठ युनिकोडमा बदल्न Lacspace Free Licence v1.0 अन्तर्गतको @lacspace/preeti 1.1.0 प्रयोग हुन्छ। अंग्रेजी शब्दलाई [[English]] जस्ता दुई कोष्ठकभित्र राखेमा ती बदलिँदैनन्। मात्रा, रेफ र नेपाली–अंग्रेजी मिसिएको पाठको स्वचालित परीक्षण गरिएको छ। अनुभवी नेपाली टाइपिस्टबाट छुट्टै जाँच गराउन बाँकी छ।')}</p><p><a href="https://developer.lacspace.com/packages/preeti">{pick(lang,'Preeti mapping documentation','प्रीति परिवर्तनको विवरण')}</a></p><h2>{pick(lang,'Land units','जग्गाको एकाइ')}</h2><p>{pick(lang,'We use the Nepal convention: 5,476 ft² per ropani and 72,900 ft² per bigha, with the standard compound-unit ratios. Metric area is derived from the exact international foot (0.3048 m). Results show up to four decimals, retaining full precision in calculations.','नेपालमा प्रचलित नापअनुसार १ रोपनी = ५,४७६ वर्ग फिट र १ बिघा = ७२,९०० वर्ग फिट लिइन्छ। वर्ग मिटर निकाल्दा १ फिट = ०.३०४८ मिटरको मान प्रयोग हुन्छ। देखिने नतिजा दशमलवपछि चार अंकसम्म हुन्छ; गणनामा भने पूरा मान राखिन्छ।')}</p><p><a href="https://giwmscdnone.gov.np/media/app/public/54/posts/1711001516_6.pdf">{pick(lang,'Government unit reference (PDF)','सरकारी एकाइ सन्दर्भ (PDF)')}</a> · <a href="https://www.nist.gov/pml/us-surveyfoot">{pick(lang,'NIST: international foot','NIST: अन्तर्राष्ट्रिय फिट')}</a></p><h2>{pick(lang,'Photos','फोटो')}</h2><p>{pick(lang,'Photos are decoded and resized by your browser. Displayed size comes from the generated file’s actual bytes. Compression and color can vary between browsers. Presets are generic targets; official application requirements must be checked with the issuing authority.','फोटोको साइज तपाईंको ब्राउजरमै मिलाइन्छ। देखाइएको फाइल साइज तयार भएको फाइलकै बाइटबाट निकालिन्छ। ब्राउजरअनुसार फाइलको साइज र रङमा केही फरक पर्न सक्छ। फारामका लागि फोटो बनाउँदा सम्बन्धित निकायले मागेको नियम हेर्नुहोस्।')}</p><h2>{pick(lang,'Licenses and corrections','इजाजतपत्र र सुधार')}</h2><p>{pick(lang,'Local fonts: DM Sans and Noto Sans Devanagari (SIL Open Font License). Third-party license notices are available below. Send corrections with a fictitious, reproducible example.','DM Sans र Noto Sans Devanagari फन्ट वेबसाइटसँगै राखिएका छन् र SIL Open Font License अन्तर्गत प्रयोग हुन्छन्। अरू सामग्रीका इजाजतपत्र पनि तल हेर्न सकिन्छ। समस्या भेटिएमा हामीले पनि उही नतिजा हेर्न सक्ने गरी काल्पनिक उदाहरणसहित पठाउनुहोस्।')}</p><p><a href={withBase('licenses/THIRD-PARTY-NOTICES.txt')}>{pick(lang,'Third-party notices','अन्य स्रोतका इजाजतपत्र')}</a> · <a href={route(lang,'contact')}>{pick(lang,'Send feedback','सुझाव दिनुहोस्')}</a></p></>}
</article></div><script>import { downloadBlob } from '../../scripts/shared';const form=document.querySelector<HTMLFormElement>('#feedback-form');form?.addEventListener('submit',e=>{e.preventDefault();const topic=(document.querySelector('#feedback-topic') as HTMLSelectElement).value;const message=(document.querySelector('#feedback-message') as HTMLTextAreaElement).value.trim();if(!message)return;downloadBlob(new Blob([`Sajilo Desk feedback\nTopic: ${topic}\n\n${message}\n\nDraft only. Email to sajilodesk@gmail.com when ready.\n`],{type:'text/plain;charset=utf-8'}),'sajilo-feedback-draft.txt');const status=document.querySelector('#feedback-status');if(status)status.textContent=document.documentElement.lang==='ne'?'मस्यौदा डाउनलोड भयो। पढेर जाँच्नुहोस् र चाहनुहुन्छ भने हामीलाई इमेल गर्नुहोस्।':'Draft prepared. Review it, then email it when ready.';});</script></Layout>
