---
import Layout from '../../../layouts/Layout.astro';
import ToolSearch from '../../../components/ToolSearch.astro';
import ToolGrid from '../../../components/ToolGrid.astro';
import { langs, pick } from '../../../lib/catalog';
export function getStaticPaths(){return langs.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props;
---
<Layout lang={lang} title={pick(lang,'All free tools','सबै निःशुल्क उपकरण')} description={pick(lang,'Find the tool for your next task. Search date conversion, age, Nepali text, photos and land measurements.','मिति, उमेर, नेपाली अक्षर, फोटो र जग्गाको नापका उपकरण खोज्नुहोस्।')} active="tools"><div class="container page-content"><div class="page-heading"><p class="eyebrow">{pick(lang,'YOUR EVERYDAY TOOLKIT','दैनिक कामका उपकरण')}</p><h1>{pick(lang,'A tool for the little things.','साना काममा ठूलो सहयोग।')}</h1><p>{pick(lang,'Pick a task. Get it done. No account, no waiting.','काम छान्नुहोस् र पूरा गर्नुहोस्। खाता वा पर्खाइ चाहिँदैन।')}</p><ToolSearch lang={lang}/></div><ToolGrid lang={lang}/></div></Layout>
