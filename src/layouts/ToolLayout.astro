---
import Layout from './Layout.astro';
import Icon from '../components/Icon.astro';
import { tools, toolText, pick, route, type Lang } from '../lib/catalog';
interface Props { lang: Lang; id: string; related: string; instructions: [string,string][] }
const { lang, id, related, instructions } = Astro.props;
const tool = tools.find(t => t.id === id)!;
const next = tools.find(t => t.id === related)!;
---
<Layout lang={lang} title={toolText(tool,'title',lang)} description={toolText(tool,'description',lang)} active="tools">
  <div class="container tool-page" data-tool={id}><nav class="breadcrumbs" aria-label={pick(lang,'Breadcrumb','पृष्ठको स्थान')}><a href={route(lang)}>{pick(lang,'Home','गृहपृष्ठ')}</a><Icon name="chevron" size={12}/><a href={route(lang,'tools')}>{pick(lang,'All tools','सबै उपकरण')}</a><Icon name="chevron" size={12}/><span>{toolText(tool,'short',lang)}</span></nav>
    <div class={`tool-heading ${tool.color}`}><span class="tool-icon"><Icon name={tool.icon} size={30}/></span><div><h1>{toolText(tool,'title',lang)}</h1><p>{toolText(tool,'description',lang)}</p></div><button class="favorite-button" type="button" data-favorite={tool.id} aria-label={pick(lang,'Save this tool','मनपर्नेमा राख्नुहोस्')} aria-pressed="false"><Icon name="heart" size={21}/></button></div>
    <noscript><p class="noscript-note">{pick(lang,'Enable JavaScript to use this tool. Calculations run in your browser; your inputs are not sent to a server.','यो उपकरण चलाउन ब्राउजरको JavaScript चालु गर्नुहोस्। तपाईंले राखेको विवरण ब्राउजरमै प्रयोग हुन्छ, सर्भरमा पठाइँदैन।')}</p></noscript>
    <slot/>
    <div class="method-section"><details><summary>{pick(lang,'How this tool works & sources','यसले कसरी काम गर्छ र स्रोतहरू')}</summary><div><slot name="method"/></div></details><a class="related-card" href={route(lang,`tools/${next.id}`)}><Icon name={next.icon} size={25}/><div><p>{pick(lang,'A HANDY NEXT STEP','अर्को उपयोगी उपकरण')}</p><strong>{toolText(next,'title',lang)}</strong></div><Icon name="arrow" size={19}/></a></div>
    <details class="tool-instructions"><summary>{pick(lang,'How to use this tool','यो उपकरण कसरी चलाउने')}</summary><div class="instruction-grid">{instructions.map(([title,body],i) => <div><span>{i+1}</span><div><strong>{title}</strong><p>{body}</p></div></div>)}</div></details>
    <div class="share-row"><button type="button" data-share><Icon name="link" size={15}/>{pick(lang,'Copy link to this tool','यो उपकरणको लिङ्क कपी गर्नुहोस्')}</button><a href={route(lang,'contact')}>{pick(lang,'Something not right? Let us know.','केही मिलेन? हामीलाई भन्नुहोस्।')}</a></div>
  </div>
</Layout>
